{
  "name": "jiaoyan-desktop",
  "productName": "教研阅记",
  "version": "0.1.2",
  "private": true,
  "description": "教研阅记本机 Electron 桌面入口，复用现有 Web、PaperFlow 和 PostgreSQL。",
  "main": "src/main.cjs",
  "author": "教研阅记项目组",
