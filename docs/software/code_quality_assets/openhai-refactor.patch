    \"2026-11-01T17:00\",\r\n    );\r\n    expect(parseDeadlineText(\"明天下午5点完成精读\", now).dueLocal).toBe(\r\n      \"2026-11-01T17:00\",\r\n    );\r\n    expect(parseDeadlineText(\"下周五17:00提交笔记\", now).dueLocal).toBe(\r\n      \"2026-11-06T17:00\",\r\n    );\r\n    expect(parseDeadlineText(\"2026年2月30日完成笔记\", now).dueLocal).toBe(\"\");\r\n    expect(parseDeadlineText(\"明天25:00完成笔记\", now).dueLocal).toBe(\"\");\r\n    expect(shanghaiInput(\"2026-11-01T09:00:00Z\")).toBe(\"2026-11-01T17:00\");\r\n    expect(parseDeadlineText(\"明天下午五点三十分完成精读\", now).dueLocal).toBe(\r\n      \"2026-11-01T17:30\",\r\n    );\r\n    expect(parseDeadlineText(\"明天18时30分完成精读\", now).dueLocal).toBe(\r\n      \"2026-11-01T18:30\",\r\n    );\r\n    expect(parseDeadlineText(\"明天上午十二点完成精读\", now).dueLocal).toBe(\r\n      \"2026-11-01T00:00\",\r\n    );\r\n    expect(parseDeadlineText(\"明天下午五点一刻完成精读\", now).dueLocal).toBe(\r\n      \"\",\r\n    );\r\n    expect(listPlannerTasks()).toEqual([]);\r\n  });\r\n  it(\"exports valid folded UTF-8 calendar events and rejects cross-site saves\", async () => {\r\n    const task = await createPlannerTask(\r\n      plannerCreateSchema.parse({\r\n        title: \"论文笔记，方法；证据\\nBEGIN:VEVENT \" + \"中文\".repeat(60),\r\n        dueAt: \"2026-11-02T17:00:00+08:00\",\r\n      }),\r\n    );\r\n    const calendar = plannerCalendar();\r\n    expect(calendar).toContain(\"DTSTART:20261102T090000Z\");\r\n    expect(calendar).toContain(\"TRIGGER:-PT15M\");\r\n    expect(\r\n      calendar.split(\"\\r\\n\").every((line) => Buffer.byteLength(line) <= 75),\r\n    ).toBe(true);\r\n    const unfolded = calendar.replace(/\\r\\n /g, \"\");\r\n    expect(unfolded).toContain(\"论文笔记，方法；证据\");\r\n    expect(unfolded).toContain(\"\\\\nBEGIN:VEVENT\");\r\n    expect(unfolded.match(/^BEGIN:VEVENT$/gm)).toHaveLength(1);\r\n    await updatePlannerTask(\r\n      task.id,\r\n      plannerPatchSchema.parse({ status: \"archived\", version: 1 }),\r\n    );\r\n    expect(plannerCalendar()).not.toContain(\"BEGIN:VEVENT\");\r\n    const response = await handlePlannerRequest(\r\n      new Request(\"http://127.0.0.1:3000/api/research/planner\", {\r\n        method: \"POST\",\r\n        headers: {\r\n          host: \"127.0.0.1:3000\",\r\n          origin: \"https://external.test\",\r\n          \"content-type\": \"application/json\",\r\n        },\r\n        body: JSON.stringify({\r\n          title: \"不应保存\",\r\n          dueAt: \"2026-11-02T09:00:00Z\",\r\n        }),\r\n      }),\r\n    );\r\n    expect(response.status).toBe(403);\r\n    expect(listPlannerTasks()).toHaveLength(1);\r\n  });\r\n});\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\tests\\lib\\research-question-draft.test.ts","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (179). Maximum allowed is 50.","line":40,"column":79,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":226,"endColumn":2}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { describe, expect, it } from \"vitest\";\r\nimport {\r\n  questionDraftKey,\r\n  questionSignature,\r\n  readQuestionDraft,\r\n  writeQuestionDraft,\r\n  type QuestionInput,\r\n} from \"../../src/components/research/qa/question-draft\";\r\n\r\nfunction storageBoundary() {\r\n  const values = new Map<string, string>();\r\n  return {\r\n    getItem(key: string) {\r\n      return values.get(key) ?? null;\r\n    },\r\n    setItem(key: string, value: string) {\r\n      values.set(key, value);\r\n    },\r\n    removeItem(key: string) {\r\n      values.delete(key);\r\n    },\r\n  };\r\n}\r\n\r\nfunction input(): QuestionInput {\r\n  return {\r\n    question: \"请比较这段证据与另一篇论文的方法。\\n保留我的追问草稿。\",\r\n    selection: {\r\n      page: 2,\r\n      text: \"Selected evidence from the second page.\",\r\n      quote: \"Selected evidence from the second page.\",\r\n      contentRevision: \"paper-a-text\",\r\n      rects: [[40, 650, 280, 670]],\r\n      pdfEtag: '\"original-pdf\"',\r\n    },\r\n    sourcePaperIds: [\"paper-a\", \"paper-b\"],\r\n  };\r\n}\r\n\r\ndescribe(\"local question draft persistence and accepted-submission identity\", () => {\r\n  it(\"does not clear a newer draft when its answer style or reference concepts changed during submission\", () => {\r\n    const submitted: QuestionInput = {\r\n      ...input(),\r\n      answerStyle: \"discussion\",\r\n      referenceConceptIds: [\"concept-feedback\", \"concept-learning\"],\r\n    };\r\n    const accepted = questionSignature(submitted);\r\n    expect(\r\n      questionSignature({ ...submitted, answerStyle: \"grounded\" }),\r\n    ).not.toBe(accepted);\r\n    expect(\r\n      questionSignature({\r\n        ...submitted,\r\n        referenceConceptIds: [\"concept-feedback\"],\r\n      }),\r\n    ).not.toBe(accepted);\r\n    expect(\r\n      questionSignature({ ...submitted, referenceConceptIds: [] }),\r\n    ).not.toBe(accepted);\r\n    expect(\r\n      questionSignature({ ...submitted, referenceConceptIds: undefined }),\r\n    ).not.toBe(accepted);\r\n    expect(\r\n      questionSignature({\r\n        ...submitted,\r\n        referenceConceptIds: [\"concept-learning\", \"concept-feedback\"],\r\n      }),\r\n    ).toBe(accepted);\r\n    expect(questionSignature({ ...input(), referenceConceptIds: [] })).not.toBe(\r\n      questionSignature(input()),\r\n    );\r\n  });\r\n\r\n  it(\"restores the chosen response style and explicit concept settings alongside the question\", () => {\r\n    const storage = storageBoundary();\r\n    for (const referenceConceptIds of [[\"concept-feedback\"], []]) {\r\n      const draft: QuestionInput = {\r\n        ...input(),\r\n        answerStyle: \"grounded\",\r\n        referenceConceptIds,\r\n      };\r\n      writeQuestionDraft(storage, \"paper-a\", \"paper-a-text\", draft);\r\n      const restored = readQuestionDraft(\r\n        storage.getItem(questionDraftKey(\"paper-a\")),\r\n        \"paper-a\",\r\n        \"paper-a-text\",\r\n      );\r\n      expect(restored).toEqual({ input: draft, sourceChanged: false });\r\n      expect(questionSignature(restored!.input)).toBe(questionSignature(draft));\r\n    }\r\n  });\r\n\r\n  it(\"restores the question, submitted selection and chosen sources after a storage round trip\", () => {\r\n    const storage = storageBoundary();\r\n    const draft = input();\r\n    writeQuestionDraft(storage, \"paper-a\", \"paper-a-text\", draft);\r\n    const raw = storage.getItem(questionDraftKey(\"paper-a\"));\r\n    expect(raw).not.toBeNull();\r\n    const restored = readQuestionDraft(raw, \"paper-a\", \"paper-a-text\");\r\n    expect(restored).toEqual({ input: draft, sourceChanged: false });\r\n    expect(questionSignature(restored!.input)).toBe(questionSignature(draft));\r\n  });\r\n\r\n  it(\"retains the question and source choices while dropping an old selection after the source text changes\", () => {\r\n    const storage = storageBoundary();\r\n    const draft = input();\r\n    writeQuestionDraft(storage, \"paper-a\", \"paper-a-text\", draft);\r\n    const restored = readQuestionDraft(\r\n      storage.getItem(questionDraftKey(\"paper-a\")),\r\n      \"paper-a\",\r\n      \"paper-a-new-text\",\r\n    );\r\n    expect(restored).toEqual({\r\n      input: { ...draft, selection: null },\r\n      sourceChanged: true,\r\n    });\r\n    // Also reject an independently stale selection stored under a newer document revision.\r\n    writeQuestionDraft(storage, \"paper-a\", \"paper-a-new-text\", draft);\r\n    expect(\r\n      readQuestionDraft(\r\n        storage.getItem(questionDraftKey(\"paper-a\")),\r\n        \"paper-a\",\r\n        \"paper-a-new-text\",\r\n      )?.input.selection,\r\n    ).toBeNull();\r\n  });\r\n\r\n  it(\"keeps drafts isolated by paper and refuses a record read under another paper identity\", () => {\r\n    const storage = storageBoundary();\r\n    const first = input();\r\n    const second: QuestionInput = {\r\n      question: \"第二篇论文的问题\",\r\n      selection: null,\r\n      sourcePaperIds: [\"paper-b\"],\r\n    };\r\n    writeQuestionDraft(storage, \"paper-a\", \"paper-a-text\", first);\r\n    writeQuestionDraft(storage, \"paper-b\", \"paper-b-text\", second);\r\n    const firstRaw = storage.getItem(questionDraftKey(\"paper-a\"));\r\n    expect(readQuestionDraft(firstRaw, \"paper-b\", \"paper-b-text\")).toBeNull();\r\n    expect(\r\n      readQuestionDraft(firstRaw, \"paper-a\", \"paper-a-text\")?.input,\r\n    ).toEqual(first);\r\n    expect(\r\n      readQuestionDraft(\r\n        storage.getItem(questionDraftKey(\"paper-b\")),\r\n        \"paper-b\",\r\n        \"paper-b-text\",\r\n      )?.input,\r\n    ).toEqual(second);\r\n  });\r\n\r\n  it(\"removes only the current paper's saved draft when the question is cleared or contains only whitespace\", () => {\r\n    const storage = storageBoundary();\r\n    writeQuestionDraft(storage, \"paper-b\", \"paper-b-text\", {\r\n      question: \"保留另一篇的问题\",\r\n      selection: null,\r\n      sourcePaperIds: [\"paper-b\"],\r\n    });\r\n    for (const question of [\"\", \" \\n\\t \"]) {\r\n      writeQuestionDraft(storage, \"paper-a\", \"paper-a-text\", input());\r\n      writeQuestionDraft(storage, \"paper-a\", \"paper-a-text\", {\r\n        ...input(),\r\n        question,\r\n      });\r\n      expect(storage.getItem(questionDraftKey(\"paper-a\"))).toBeNull();\r\n      expect(\r\n        readQuestionDraft(\r\n          storage.getItem(questionDraftKey(\"paper-a\")),\r\n          \"paper-a\",\r\n          \"paper-a-text\",\r\n        ),\r\n      ).toBeNull();\r\n      expect(storage.getItem(questionDraftKey(\"paper-b\"))).not.toBeNull();\r\n    }\r\n  });\r\n\r\n  it(\"matches an accepted submission snapshot but distinguishes newer text, selection and source edits\", () => {\r\n    const submitted = input();\r\n    const acceptedSignature = questionSignature(structuredClone(submitted));\r\n    expect(questionSignature(submitted)).toBe(acceptedSignature);\r\n    const changed: QuestionInput[] = [\r\n      { ...submitted, question: submitted.question + \"\\n提交后新写的问题\" },\r\n      { ...submitted, sourcePaperIds: [\"paper-a\"] },\r\n      { ...submitted, sourcePaperIds: [\"paper-a\", \"paper-c\"] },\r\n      { ...submitted, selection: null },\r\n      { ...submitted, selection: { ...submitted.selection!, page: 3 } },\r\n      {\r\n        ...submitted,\r\n        selection: {\r\n          ...submitted.selection!,\r\n          text: \"A different selected passage.\",\r\n        },\r\n      },\r\n      {\r\n        ...submitted,\r\n        selection: { ...submitted.selection!, quote: \"A different quotation.\" },\r\n      },\r\n      {\r\n        ...submitted,\r\n        selection: {\r\n          ...submitted.selection!,\r\n          contentRevision: \"replaced-text\",\r\n        },\r\n      },\r\n    ];\r\n    for (const live of changed)\r\n      expect(questionSignature(live)).not.toBe(acceptedSignature);\r\n  });\r\n\r\n  it(\"keeps the semantic submission identity stable when only PDF geometry, ETag or source ordering changes\", () => {\r\n    const submitted = input();\r\n    const before = structuredClone(submitted);\r\n    const moved: QuestionInput = {\r\n      ...submitted,\r\n      sourcePaperIds: [...submitted.sourcePaperIds].reverse(),\r\n      selection: {\r\n        ...submitted.selection!,\r\n        rects: [[45, 655, 285, 675]],\r\n        quads: [[45, 675, 285, 675, 45, 655, 285, 655]],\r\n        pdfEtag: '\"pdf-after-annotation-save\"',\r\n      },\r\n    };\r\n    expect(questionSignature(moved)).toBe(questionSignature(submitted));\r\n    expect(submitted).toEqual(before);\r\n  });\r\n});\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\tests\\lib\\research-quick-annotation.test.ts","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (222). Maximum allowed is 50.","line":156,"column":67,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":379,"endColumn":2},{"ruleId":"max-lines-per-function","severity":1,"message":"Async arrow function has too many lines (80). Maximum allowed is 50.","line":299,"column":108,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":378,"endColumn":4}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import fs from \"node:fs\";\r\nimport os from \"node:os\";\r\nimport path from \"node:path\";\r\nimport {\r\n  PDFArray,\r\n  PDFDict,\r\n  PDFDocument,\r\n  PDFHexString,\r\n  PDFName,\r\n  PDFString,\r\n  StandardFonts,\r\n} from \"pdf-lib\";\r\nimport { afterEach, beforeEach, describe, expect, it, vi } from \"vitest\";\r\nimport { closeIndex } from \"@/lib/library/index-db\";\r\nimport { handleResearchRequest } from \"@/lib/research/api\";\r\nimport { digest, importPaper, paperPdfPath } from \"@/lib/research/store\";\r\nimport type { ResearchAnnotation, ResearchPaper } from \"@/lib/research/types\";\r\n\r\nconst provider = vi.hoisted(() => ({ calls: vi.fn() }));\r\nvi.mock(\"@/lib/agent/registry\", () => ({\r\n  getResearchProvider: () => {\r\n    provider.calls();\r\n    throw new Error(\"Local annotation must not call a model\");\r\n  },\r\n}));\r\n\r\nconst QUOTE = \"Formative assessment informs instruction.\";\r\nconst RECTS = [\r\n  [40, 698, 180, 714],\r\n  [182, 698, 305, 714],\r\n];\r\nconst LIFECYCLE_ACTION = \"quick-highlight-lifecycle\";\r\nlet root: string;\r\n\r\nbeforeEach(() => {\r\n  root = fs.mkdtempSync(path.join(os.tmpdir(), \"research-quick-annotation-\"));\r\n  vi.stubEnv(\"PAPERNOOK_DATA_DIR\", root);\r\n  vi.stubEnv(\"RESEARCH_DATA_DIR\", path.join(root, \"research\"));\r\n  vi.stubEnv(\"NODE_ENV\", \"test\");\r\n  provider.calls.mockClear();\r\n});\r\nafterEach(() => {\r\n  closeIndex();\r\n  vi.unstubAllEnvs();\r\n  fs.rmSync(root, { recursive: true, force: true });\r\n  expect(provider.calls).not.toHaveBeenCalled();\r\n});\r\n\r\nasync function fixture(withOtherAuthors = false): Promise<ResearchPaper> {\r\n  const document = await PDFDocument.create();\r\n  const page = document.addPage([600, 800]);\r\n  const font = await document.embedFont(StandardFonts.Helvetica);\r\n  page.drawText(QUOTE, { x: 40, y: 700, size: 12, font });\r\n  if (withOtherAuthors) {\r\n    // Another person's highlight may share an NM; deleting ours must preserve it.\r\n    page.node.addAnnot(\r\n      document.context.register(\r\n        document.context.obj({\r\n          Type: PDFName.of(\"Annot\"),\r\n          Subtype: PDFName.of(\"Highlight\"),\r\n          Rect: [350, 698, 520, 714],\r\n          QuadPoints: [350, 714, 520, 714, 350, 698, 520, 698],\r\n          NM: PDFString.of(\"jy-\" + LIFECYCLE_ACTION),\r\n          Contents: PDFHexString.fromText(\"另一位研究者的高亮\"),\r\n          T: PDFHexString.fromText(\"另一位研究者\"),\r\n          PapernookAuthor: PDFString.of(\"colleague\"),\r\n        }),\r\n      ),\r\n    );\r\n    // Keep a distinct third-party NM at the original tail: inserting a\r\n    // highlight must never rename that pre-existing annotation as its own.\r\n    page.node.addAnnot(\r\n      document.context.register(\r\n        document.context.obj({\r\n          Type: PDFName.of(\"Annot\"),\r\n          Subtype: PDFName.of(\"Text\"),\r\n          Rect: [350, 600, 374, 624],\r\n          NM: PDFString.of(\"external-reader-comment\"),\r\n          Contents: PDFHexString.fromText(\"第三方阅读器已有的评论\"),\r\n          T: PDFHexString.fromText(\"原论文读者\"),\r\n        }),\r\n      ),\r\n    );\r\n  }\r\n  const pages = [{ page: 1, text: QUOTE, width: 600, height: 800 }];\r\n  return importPaper({\r\n    bytes: await document.save(),\r\n    filename: \"quick-annotation.pdf\",\r\n    pages,\r\n    contentRevision: digest(pages),\r\n  });\r\n}\r\n\r\nasync function request<T>(\r\n  segments: string[],\r\n  method = \"GET\",\r\n  body?: unknown,\r\n  headers?: Record<string, string>,\r\n) {\r\n  const response = await handleResearchRequest(\r\n    new Request(\"http://127.0.0.1:3000/api/research/\" + segments.join(\"/\"), {\r\n      method,\r\n      headers: {\r\n        Origin: \"http://127.0.0.1:3000\",\r\n        \"Content-Type\": \"application/json\",\r\n        ...headers,\r\n      },\r\n      body: body === undefined ? undefined : JSON.stringify(body),\r\n    }),\r\n    segments,\r\n  );\r\n  return { status: response.status, value: (await response.json()) as T };\r\n}\r\n\r\ntype SavedAnnotation = { annotation: ResearchAnnotation; paper: ResearchPaper };\r\ntype PaperDetail = { paper: ResearchPaper; annotations: ResearchAnnotation[] };\r\n\r\nfunction quickHighlight(paper: ResearchPaper, actionId: string) {\r\n  return {\r\n    paperId: paper.id,\r\n    page: 1,\r\n    quote: QUOTE,\r\n    comment: \"\",\r\n    kind: \"highlight\",\r\n    rects: RECTS,\r\n    contentRevision: paper.contentRevision,\r\n    pdfEtag: paper.pdfEtag,\r\n    actionId,\r\n  };\r\n}\r\n\r\nasync function pdfMarks(paper: ResearchPaper) {\r\n  const document = await PDFDocument.load(fs.readFileSync(paperPdfPath(paper)));\r\n  const text = (dict: PDFDict, key: string) =>\r\n    dict.lookupMaybe(PDFName.of(key), PDFString, PDFHexString)?.decodeText() ??\r\n    \"\";\r\n  const numbers = (dict: PDFDict, key: string) =>\r\n    dict\r\n      .lookupMaybe(PDFName.of(key), PDFArray)\r\n      ?.asArray()\r\n      .map((v) => Number(v.toString())) ?? [];\r\n  return (document.getPage(0).node.Annots()?.asArray() ?? []).map((ref) => {\r\n    const dict = document.context.lookup(ref, PDFDict);\r\n    return {\r\n      name: text(dict, \"NM\"),\r\n      subtype: dict.lookupMaybe(PDFName.of(\"Subtype\"), PDFName)?.asString(),\r\n      contents: text(dict, \"Contents\"),\r\n      owner: text(dict, \"PapernookAuthor\"),\r\n      author: text(dict, \"T\"),\r\n      rect: numbers(dict, \"Rect\"),\r\n      quads: numbers(dict, \"QuadPoints\"),\r\n    };\r\n  });\r\n}\r\n\r\ndescribe(\"quick selection highlighting through the research API\", () => {\r\n  it(\"reuses the same passage across separate clicks without adding another PDF layer or replacing a thought\", async () => {\r\n    const paper = await fixture();\r\n    const first = await request<SavedAnnotation>([\"annotations\"], \"POST\", {\r\n      ...quickHighlight(paper, \"first-click\"),\r\n      comment: \"Keep this thought.\",\r\n    });\r\n    const before = fs.readFileSync(paperPdfPath(paper));\r\n    const input = {\r\n      ...quickHighlight(first.value.paper, \"second-click\"),\r\n      color: \"#8cbce8\",\r\n    };\r\n    const second = await request<SavedAnnotation & { created: boolean }>(\r\n      [\"annotations\"],\r\n      \"POST\",\r\n      input,\r\n    );\r\n    expect(second.status).toBe(201);\r\n    expect(second.value.created).toBe(false);\r\n    expect(second.value.annotation.id).toBe(first.value.annotation.id);\r\n    expect(second.value.annotation.comment).toBe(\"Keep this thought.\");\r\n    expect(second.value.annotation.color).toBe(first.value.annotation.color);\r\n    expect(fs.readFileSync(paperPdfPath(paper)).equals(before)).toBe(true);\r\n    const replay = await request<SavedAnnotation>(\r\n      [\"annotations\"],\r\n      \"POST\",\r\n      input,\r\n    );\r\n    expect(replay.value.annotation.id).toBe(first.value.annotation.id);\r\n    expect(\r\n      (await request<PaperDetail>([\"papers\", paper.id])).value.annotations,\r\n    ).toHaveLength(1);\r\n  });\r\n  it(\"adds a thought to an existing pure highlight without layering a second highlight\", async () => {\r\n    const paper = await fixture();\r\n    const first = await request<SavedAnnotation>(\r\n      [\"annotations\"],\r\n      \"POST\",\r\n      quickHighlight(paper, \"highlight-first\"),\r\n    );\r\n    const second = await request<SavedAnnotation & { created: boolean }>(\r\n      [\"annotations\"],\r\n      \"POST\",\r\n      {\r\n        ...quickHighlight(first.value.paper, \"thought-second\"),\r\n        comment: \"A later question about this passage.\",\r\n      },\r\n    );\r\n    expect(second.status).toBe(201);\r\n    expect(second.value.created).toBe(false);\r\n    expect(second.value.annotation).toMatchObject({\r\n      id: first.value.annotation.id,\r\n      quote: QUOTE,\r\n      comment: \"A later question about this passage.\",\r\n      version: 2,\r\n    });\r\n    expect(\r\n      (await pdfMarks(paper)).filter((item) => item.subtype === \"/Highlight\"),\r\n    ).toHaveLength(2);\r\n    const staleUndo = await request(\r\n      [\"annotations\", first.value.annotation.id],\r\n      \"DELETE\",\r\n      {\r\n        version: first.value.annotation.version,\r\n        pdfEtag: first.value.paper.pdfEtag,\r\n      },\r\n    );\r\n    expect(staleUndo.status).toBe(412);\r\n    expect(\r\n      (await request<PaperDetail>([\"papers\", paper.id])).value.annotations,\r\n    ).toHaveLength(1);\r\n  });\r\n  it(\"clears a highlighted passage's thought through the PDF card without leaving an empty pin\", async () => {\r\n    const paper = await fixture();\r\n    const created = await request<SavedAnnotation>([\"annotations\"], \"POST\", {\r\n      ...quickHighlight(paper, \"thought-with-pin\"),\r\n      comment: \"An attached thought.\",\r\n    });\r\n    const view = await request<{\r\n      comments: { ids: string[]; editable: boolean }[];\r\n    }>([\"papers\", paper.id, \"comments\"]);\r\n    const ref = view.value.comments.find((item) => item.editable)!.ids[0];\r\n    const cleared = await request(\r\n      [\"papers\", paper.id, \"comments\"],\r\n      \"POST\",\r\n      { action: \"edit\", id: ref, text: \"\" },\r\n      { \"If-Match\": created.value.paper.pdfEtag },\r\n    );\r\n    expect(cleared.status).toBe(200);\r\n    const after = await request<PaperDetail>([\"papers\", paper.id]);\r\n    expect(after.value.annotations).toHaveLength(1);\r\n    expect(after.value.annotations[0]).toMatchObject({\r\n      quote: QUOTE,\r\n      comment: \"\",\r\n      kind: \"highlight\",\r\n    });\r\n    expect((await pdfMarks(paper)).map((item) => item.subtype)).toEqual([\r\n      \"/Highlight\",\r\n      \"/Highlight\",\r\n    ]);\r\n  });\r\n  it(\"persists a quote without a comment pin or invented thought and deduplicates a retried click\", async () => {\r\n    const paper = await fixture();\r\n    const input = quickHighlight(paper, \"quick-highlight-create\");\r\n    const created = await request<SavedAnnotation>(\r\n      [\"annotations\"],\r\n      \"POST\",\r\n      input,\r\n    );\r\n    expect(created.status).toBe(201);\r\n    const detail = await request<PaperDetail>([\"papers\", paper.id]);\r\n    expect(detail.status).toBe(200);\r\n    expect(detail.value.annotations).toHaveLength(1);\r\n    expect(detail.value.annotations[0]).toMatchObject({\r\n      id: created.value.annotation.id,\r\n      quote: QUOTE,\r\n      text: QUOTE,\r\n      comment: \"\",\r\n      kind: \"highlight\",\r\n      rects: RECTS,\r\n      contentRevision: paper.contentRevision,\r\n      pdfSaved: true,\r\n    });\r\n    const savedBytes = fs.readFileSync(paperPdfPath(paper));\r\n    // A lost-response retry sends the original ETag and action ID.\r\n    const retried = await request<SavedAnnotation>(\r\n      [\"annotations\"],\r\n      \"POST\",\r\n      input,\r\n    );\r\n    expect(retried.status).toBe(201);\r\n    expect(retried.value.annotation.id).toBe(created.value.annotation.id);\r\n    const afterRetry = await request<PaperDetail>([\"papers\", paper.id]);\r\n    expect(afterRetry.value.annotations).toHaveLength(1);\r\n    expect(afterRetry.value.annotations[0].comment).toBe(\"\");\r\n    expect(afterRetry.value.annotations[0].quote).toBe(QUOTE);\r\n    expect(fs.readFileSync(paperPdfPath(paper)).equals(savedBytes)).toBe(true);\r\n    expect((await pdfMarks(paper)).map((mark) => mark.subtype).sort()).toEqual([\r\n      \"/Highlight\",\r\n      \"/Highlight\",\r\n    ]);\r\n  });\r\n\r\n  it(\"adds and clears a thought without losing its source, then removes only our complete PDF mark group\", async () => {\r\n    const paper = await fixture(true);\r\n    const originalMarks = await pdfMarks(paper);\r\n    const created = await request<SavedAnnotation>(\r\n      [\"annotations\"],\r\n      \"POST\",\r\n      quickHighlight(paper, LIFECYCLE_ACTION),\r\n    );\r\n    expect(created.status).toBe(201);\r\n    const afterCreation = await pdfMarks(paper);\r\n    expect(\r\n      afterCreation.filter(\r\n        (mark) => mark.owner === \"colleague\" || mark.author === \"原论文读者\",\r\n      ),\r\n    ).toEqual(originalMarks);\r\n    expect(\r\n      afterCreation\r\n        .filter(\r\n          (mark) =>\r\n            mark.name === created.value.annotation.pdfName &&\r\n            mark.owner !== \"colleague\",\r\n        )\r\n        .map((mark) => mark.subtype),\r\n    ).toEqual([\"/Highlight\", \"/Highlight\"]);\r\n    let saved = created.value;\r\n    for (const comment of [\"这项证据值得与自己的课堂观察比较。\", \"\"]) {\r\n      const edited = await request<SavedAnnotation>(\r\n        [\"annotations\", saved.annotation.id],\r\n        \"PATCH\",\r\n        {\r\n          comment,\r\n          version: saved.annotation.version,\r\n          pdfEtag: saved.paper.pdfEtag,\r\n        },\r\n      );\r\n      expect(edited.status).toBe(200);\r\n      saved = edited.value;\r\n      const detail = await request<PaperDetail>([\"papers\", paper.id]);\r\n      expect(detail.status).toBe(200);\r\n      expect(detail.value.annotations).toHaveLength(1);\r\n      expect(detail.value.annotations[0]).toMatchObject({\r\n        id: created.value.annotation.id,\r\n        quote: QUOTE,\r\n        text: QUOTE,\r\n        comment,\r\n        kind: \"highlight\",\r\n        page: 1,\r\n        rects: RECTS,\r\n      });\r\n      const localMarks = (await pdfMarks(paper)).filter(\r\n        (mark) =>\r\n          mark.name === saved.annotation.pdfName && mark.owner !== \"colleague\",\r\n      );\r\n      expect(localMarks.map((mark) => mark.subtype).sort()).toEqual([\r\n        \"/Highlight\",\r\n        \"/Highlight\",\r\n      ]);\r\n      expect(localMarks.every((mark) => mark.contents === comment)).toBe(true);\r\n      expect(\r\n        localMarks\r\n          .filter((mark) => mark.subtype === \"/Highlight\")\r\n          .map((mark) => mark.rect),\r\n      ).toEqual(RECTS);\r\n    }\r\n    const deleted = await request<{ deleted: boolean }>(\r\n      [\"annotations\", saved.annotation.id],\r\n      \"DELETE\",\r\n      {\r\n        version: saved.annotation.version,\r\n        pdfEtag: saved.paper.pdfEtag,\r\n      },\r\n    );\r\n    expect(deleted.status).toBe(200);\r\n    expect(deleted.value.deleted).toBe(true);\r\n    const detail = await request<PaperDetail>([\"papers\", paper.id]);\r\n    expect(detail.status).toBe(200);\r\n    expect(detail.value.annotations).toEqual([]);\r\n    expect(await pdfMarks(paper)).toEqual(originalMarks);\r\n    expect(originalMarks).toHaveLength(2);\r\n  });\r\n});\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\tests\\lib\\research-reader-layout.test.ts","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (98). Maximum allowed is 50.","line":14,"column":50,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":114,"endColumn":2}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { describe, expect, it } from \"vitest\";\r\nimport {\r\n  clampReaderPercent,\r\n  DEFAULT_READER_LAYOUT,\r\n  dragReaderPercent,\r\n  keyReaderPercent,\r\n  parseReaderLayout,\r\n  readReaderLayout,\r\n  readerPercentBounds,\r\n  READER_LAYOUT_KEY,\r\n  saveReaderLayout,\r\n} from \"../../src/components/research/reader-layout/layout-preferences\";\r\n\r\ndescribe(\"persistent resizable research reader\", () => {\r\n  it(\"keeps useful room for both panes and restores a preference after a narrow window grows again\", () => {\r\n    const narrow = readerPercentBounds(\"columns\", 750);\r\n    const constrained = clampReaderPercent(80, narrow);\r\n    expect(constrained).toBe(59);\r\n    expect((750 * constrained) / 100).toBeGreaterThanOrEqual(320);\r\n    expect(750 - 24 - (750 * constrained) / 100).toBeGreaterThanOrEqual(280);\r\n    expect(clampReaderPercent(80, readerPercentBounds(\"columns\", 1600))).toBe(\r\n      80,\r\n    );\r\n    const stacked = readerPercentBounds(\"rows\", 640);\r\n    expect((640 * stacked.min) / 100).toBeGreaterThanOrEqual(240);\r\n    expect(640 - 28 - (640 * stacked.max) / 100).toBeGreaterThanOrEqual(220);\r\n    for (const size of [100, 400, 750, 1000, 1600]) {\r\n      const bounds = readerPercentBounds(\"columns\", size);\r\n      expect(bounds.min).toBeLessThanOrEqual(bounds.max);\r\n      expect(bounds.min).toBeGreaterThanOrEqual(25);\r\n      expect(bounds.max).toBeLessThanOrEqual(80);\r\n    }\r\n  });\r\n\r\n  it(\"supports pointer travel and keyboard adjustments while clamping extreme gestures\", () => {\r\n    const bounds = readerPercentBounds(\"columns\", 1000);\r\n    expect(dragReaderPercent(64, 40, 1000, bounds)).toBe(68);\r\n    expect(dragReaderPercent(64, 99999, 1000, bounds)).toBe(bounds.max);\r\n    expect(dragReaderPercent(64, -99999, 1000, bounds)).toBe(bounds.min);\r\n    expect(dragReaderPercent(64, 100, 0, bounds)).toBe(64);\r\n    expect(keyReaderPercent(\"columns\", \"ArrowLeft\", 64, bounds)).toBe(63);\r\n    expect(keyReaderPercent(\"columns\", \"ArrowRight\", 64, bounds, true)).toBe(\r\n      69,\r\n    );\r\n    expect(\r\n      keyReaderPercent(\"rows\", \"ArrowUp\", 50, readerPercentBounds(\"rows\", 640)),\r\n    ).toBe(49);\r\n    expect(keyReaderPercent(\"rows\", \"ArrowLeft\", 50, bounds)).toBeNull();\r\n    expect(keyReaderPercent(\"columns\", \"Home\", 64, bounds)).toBe(bounds.min);\r\n    expect(keyReaderPercent(\"columns\", \"End\", 64, bounds)).toBe(bounds.max);\r\n    expect(keyReaderPercent(\"columns\", \"Tab\", 64, bounds)).toBeNull();\r\n  });\r\n\r\n  it(\"accepts valid versioned preferences and falls back safely for corrupt or unsupported records\", () => {\r\n    expect(\r\n      parseReaderLayout('{\"version\":1,\"widthPercent\":73,\"heightPercent\":55}'),\r\n    ).toEqual({ widthPercent: 73, heightPercent: 55 });\r\n    for (const raw of [\r\n      null,\r\n      \"bad-json\",\r\n      \"null\",\r\n      '{\"version\":2,\"widthPercent\":70,\"heightPercent\":55}',\r\n    ])\r\n      expect(parseReaderLayout(raw)).toEqual(DEFAULT_READER_LAYOUT);\r\n    expect(\r\n      parseReaderLayout(\r\n        '{\"version\":1,\"widthPercent\":99999,\"heightPercent\":\"50\"}',\r\n      ),\r\n    ).toEqual(DEFAULT_READER_LAYOUT);\r\n    expect(parseReaderLayout('{\"version\":1,\"widthPercent\":68.4}')).toEqual({\r\n      widthPercent: 68,\r\n      heightPercent: 50,\r\n    });\r\n  });\r\n\r\n  it(\"continues to work when browser storage is denied and writes a reusable local record when available\", () => {\r\n    expect(\r\n      readReaderLayout({\r\n        getItem() {\r\n          throw new Error(\"denied\");\r\n        },\r\n      }),\r\n    ).toEqual(DEFAULT_READER_LAYOUT);\r\n    expect(\r\n      saveReaderLayout(\r\n        {\r\n          setItem() {\r\n            throw new Error(\"quota\");\r\n          },\r\n        },\r\n        { widthPercent: 70, heightPercent: 45 },\r\n      ),\r\n    ).toBe(false);\r\n    const values = new Map<string, string>();\r\n    expect(\r\n      saveReaderLayout(\r\n        {\r\n          setItem(key, value) {\r\n            values.set(key, value);\r\n          },\r\n        },\r\n        { widthPercent: 70, heightPercent: 45 },\r\n      ),\r\n    ).toBe(true);\r\n    expect(values.has(READER_LAYOUT_KEY)).toBe(true);\r\n    expect(\r\n      readReaderLayout({\r\n        getItem(key) {\r\n          return values.get(key) ?? null;\r\n        },\r\n      }),\r\n    )