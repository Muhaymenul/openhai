(stale),\r\n  );\r\n  expect(threads.collaborationThreads(stale)).toEqual([]);\r\n});\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\tests\\lib\\sharing\\fixture.ts","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Async function 'fixture' has too many lines (71). Maximum allowed is 50.","line":12,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":82,"endColumn":2}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import fs from \"node:fs\";\r\nimport path from \"node:path\";\r\nimport {\r\n  PDFDocument,\r\n  PDFHexString,\r\n  PDFName,\r\n  PDFString,\r\n  PDFDict,\r\n} from \"pdf-lib\";\r\nimport { createTestProfile, testProfileCapability } from \"../../helpers/access\";\r\n\r\nexport async function fixture(\r\n  mode: \"view\" | \"fork\" | \"collaborate\" = \"collaborate\",\r\n) {\r\n  await createTestProfile(\"Ana\");\r\n  const papers = await import(\"@/lib/library/papers\");\r\n  const shares = await import(\"@/lib/library/shares\");\r\n  const storage = await import(\"@/lib/sharing/storage\");\r\n  papers.writeMeta(\"nlp\", \"attention\", {\r\n    title: \"Attention Is All You Need\",\r\n    authors: [\"Vaswani\"],\r\n    year: 2017,\r\n    venue: \"NeurIPS\",\r\n    arxivId: \"1706.03762\",\r\n    bibtex: null,\r\n    tags: [\"transformers\"],\r\n    related: [],\r\n    sourceUrl: \"https://arxiv.org/abs/1706.03762\",\r\n    addedAt: new Date().toISOString(),\r\n    addedBy: \"ana\",\r\n    source: { provider: \"zotero\", key: \"SECRET_SOURCE\", version: 9 },\r\n  });\r\n  papers.writeSummary(\"nlp\", \"attention\", \"A shared summary.\");\r\n  papers.writeText(\"nlp\", \"attention\", \"The transformer paper.\");\r\n  const document = await PDFDocument.create();\r\n  const page = document.addPage([600, 800]);\r\n  page.drawText(\"Trusted paper content\", { x: 50, y: 700 });\r\n  page.node.addAnnot(\r\n    document.context.register(\r\n      document.context.obj({\r\n        Type: \"Annot\",\r\n        Subtype: \"Link\",\r\n        Rect: [10, 10, 80, 30],\r\n        A: {\r\n          Type: \"Action\",\r\n          S: \"URI\",\r\n          URI: PDFString.of(\"https://example.org\"),\r\n        },\r\n      }),\r\n    ),\r\n  );\r\n  const pdf = papers.pdfPath(\"nlp\", \"attention\");\r\n  fs.mkdirSync(path.dirname(pdf), { recursive: true });\r\n  fs.writeFileSync(pdf, await document.save());\r\n  const old = new Date(Date.now() - 10_000);\r\n  fs.utimesSync(pdf, old, old);\r\n  const capability = testProfileCapability(\"ana\");\r\n  const share = shares.createShare(\"nlp\", \"attention\", capability, [], mode);\r\n  const token = storage.newSecret();\r\n  const participant = await storage.withCollaboration(share, async () =>\r\n    storage.requestParticipant(share, token, \"Maya\"),\r\n  );\r\n  if (mode === \"collaborate\")\r\n    await storage.withCollaboration(share, async () =>\r\n      storage.setParticipant(\r\n        share,\r\n        participant.id,\r\n        \"approved\",\r\n        \"Maya Approved\",\r\n      ),\r\n    );\r\n  return {\r\n    papers,\r\n    shares,\r\n    storage,\r\n    share,\r\n    token,\r\n    participant,\r\n    capability,\r\n    pdf,\r\n  };\r\n}\r\n\r\nexport async function post(\r\n  shareId: string,\r\n  token: string | null,\r\n  action: string,\r\n  body: Record<string, unknown> = {},\r\n) {\r\n  const { POST } =\r\n    await import(\"@/app/api/v1/shares/[topic]/[slug]/[shareId]/exchange/route\");\r\n  const response = await POST(\r\n    new Request(\r\n      \"https://papers.example/api/v1/shares/nlp/attention/\" +\r\n        shareId +\r\n        \"/exchange\",\r\n      {\r\n        method: \"POST\",\r\n        headers: {\r\n          \"Content-Type\": \"application/json\",\r\n          \"X-Sharing-Operation\": action,\r\n          ...(token ? { Authorization: `Bearer ${token}` } : {}),\r\n        },\r\n        body: JSON.stringify({ action, ...body }),\r\n      },\r\n    ),\r\n    { params: Promise.resolve({ topic: \"nlp\", slug: \"attention\", shareId }) },\r\n  );\r\n  // Match an HTTP client, which drains the server response before returning.\r\n  return new Response(await response.arrayBuffer(), {\r\n    status: response.status,\r\n    headers: response.headers,\r\n  });\r\n}\r\n\r\nexport async function annotated(\r\n  bytes: Uint8Array,\r\n  options: {\r\n    type?: string;\r\n    text?: string;\r\n    name?: string;\r\n    author?: string;\r\n    x?: number;\r\n  } = {},\r\n) {\r\n  const document = await PDFDocument.load(bytes, { updateMetadata: false });\r\n  const x = options.x ?? 100;\r\n  document.getPage(0).node.addAnnot(\r\n    document.context.register(\r\n      document.context.obj({\r\n        Type: \"Annot\",\r\n        Subtype: options.type ?? \"Text\",\r\n        Rect: [x, 100, x + 20, 120],\r\n        NM: PDFString.of(options.name ?? \"client-id\"),\r\n        Contents: PDFHexString.fromText(options.text ?? \"A shared note\"),\r\n        T: PDFHexString.fromText(options.author ?? \"Forged Owner\"),\r\n        PapernookAuthor: PDFString.of(\"ana\"),\r\n        ...(options.type === \"Highlight\"\r\n          ? { QuadPoints: [100, 120, 200, 120, 100, 100, 200, 100] }\r\n          : {}),\r\n      }),\r\n    ),\r\n  );\r\n  return document.save();\r\n}\r\n\r\nexport async function annotationDetails(bytes: Uint8Array) {\r\n  const document = await PDFDocument.load(bytes);\r\n  return (document.getPage(0).node.Annots()?.asArray() ?? []).map((ref) => {\r\n    const value = document.context.lookup(ref, PDFDict);\r\n    const string = (key: string) =>\r\n      value.lookupMaybe(PDFName.of(key), PDFString, PDFHexString)?.decodeText();\r\n    return {\r\n      type: value.get(PDFName.of(\"Subtype\"))?.toString(),\r\n      text: string(\"Contents\"),\r\n      author: string(\"T\"),\r\n      actor: string(\"PapernookAuthor\"),\r\n      name: string(\"NM\"),\r\n    };\r\n  });\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\tests\\lib\\sharing\\fork.test.ts","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Async arrow function has too many lines (77). Maximum allowed is 50.","line":20,"column":87,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":96,"endColumn":2},{"ruleId":"max-lines-per-function","severity":1,"message":"Async arrow function has too many lines (73). Maximum allowed is 50.","line":137,"column":83,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":209,"endColumn":2}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import fs from \"node:fs\";\r\nimport os from \"node:os\";\r\nimport path from \"node:path\";\r\nimport { afterEach, beforeEach, expect, it, vi } from \"vitest\";\r\nimport { fixture, post } from \"./fixture\";\r\nimport { createTestProfile, testProfileCapability } from \"../../helpers/access\";\r\n\r\nlet directory: string;\r\nbeforeEach(() => {\r\n  directory = fs.mkdtempSync(path.join(os.tmpdir(), \"papernook-fork-\"));\r\n  vi.stubEnv(\"PAPERNOOK_DATA_DIR\", directory);\r\n  vi.resetModules();\r\n});\r\nafterEach(() => {\r\n  vi.restoreAllMocks();\r\n  vi.unstubAllEnvs();\r\n  fs.rmSync(directory, { recursive: true, force: true });\r\n});\r\n\r\nit(\"imports an independent annotated copy with only selected conversation snapshots\", async () => {\r\n  const f = await fixture(\"fork\");\r\n  const chats = await import(\"@/lib/library/chats\");\r\n  const bundle = await import(\"@/lib/sharing/bundle\");\r\n  const header = chats.createChat(\r\n    \"nlp\",\r\n    \"attention\",\r\n    \"ana\",\r\n    \"Selected explanation\",\r\n  );\r\n  chats.appendMessage(\"nlp\", \"attention\", \"ana\", header.id, {\r\n    role: \"user\",\r\n    content: \"Public initial question\",\r\n    at: new Date().toISOString(),\r\n  });\r\n  const privateChat = chats.createChat(\r\n    \"nlp\",\r\n    \"attention\",\r\n    \"ana\",\r\n    \"Private secrets\",\r\n  );\r\n  chats.appendMessage(\"nlp\", \"attention\", \"ana\", privateChat.id, {\r\n    role: \"user\",\r\n    content: \"NEVER_EXPORT_THIS\",\r\n    at: new Date().toISOString(),\r\n  });\r\n  const share = f.shares.createShare(\r\n    \"nlp\",\r\n    \"attention\",\r\n    f.capability,\r\n    [header.id],\r\n    \"fork\",\r\n  );\r\n  chats.appendMessage(\"nlp\", \"attention\", \"ana\", header.id, {\r\n    role: \"user\",\r\n    content: \"LATER_PRIVATE_TURN\",\r\n    at: new Date().toISOString(),\r\n  });\r\n  const snapshot = await bundle.exportBundle(share);\r\n  const serialized = JSON.stringify(snapshot);\r\n  expect(serialized).toContain(\"Public initial question\");\r\n  for (const secret of [\r\n    \"NEVER_EXPORT_THIS\",\r\n    \"LATER_PRIVATE_TURN\",\r\n    \"SECRET_SOURCE\",\r\n    \"captureToken\",\r\n    \"ownerGeneration\",\r\n    f.token,\r\n  ])\r\n    expect(serialized).not.toContain(secret);\r\n  await createTestProfile(\"Bea\");\r\n  const copy = await bundle.importBundle(\r\n    snapshot,\r\n    \"shared\",\r\n    testProfileCapability(\"bea\"),\r\n  );\r\n  expect(copy.slug).not.toBe(\"attention\");\r\n  expect(copy.meta.addedBy).toBe(\"bea\");\r\n  expect(copy.meta.source).toBeUndefined();\r\n  expect(fs.readFileSync(copy.pdfPath)).toEqual(fs.readFileSync(f.pdf));\r\n  const copiedChats = chats.listChats(\"shared\", copy.slug, \"bea\");\r\n  expect(copiedChats).toHaveLength(1);\r\n  expect(\r\n    chats.readChat(\"shared\", copy.slug, \"bea\", copiedChats[0].id)?.messages[0]\r\n      .content,\r\n  ).toBe(\"Public initial question\");\r\n  expect(fs.existsSync(path.join(copy.companionDir, \"collaboration\"))).toBe(\r\n    false,\r\n  );\r\n  expect(fs.existsSync(path.join(copy.companionDir, \"shares\"))).toBe(false);\r\n  fs.writeFileSync(copy.pdfPath, \"an independent local edit\");\r\n  expect(fs.readFileSync(f.pdf).toString(\"latin1\")).toContain(\"%PDF-\");\r\n  f.shares.deleteShare(\"nlp\", \"attention\", share.id, \"ana\");\r\n  expect(fs.readFileSync(copy.pdfPath, \"utf8\")).toBe(\r\n    \"an independent local edit\",\r\n  );\r\n});\r\n\r\nit(\"excludes arbitrary companion files and unreferenced attachments\", async () => {\r\n  const f = await fixture(\"fork\");\r\n  const folder = f.papers.companionDir(\"nlp\", \"attention\");\r\n  fs.mkdirSync(path.join(folder, \"crops\"), { recursive: true });\r\n  fs.writeFileSync(path.join(folder, \"crops\", \"private.png\"), \"PRIVATE_CROP\");\r\n  fs.writeFileSync(path.join(folder, \"canvas.json\"), \"PRIVATE_CANVAS\");\r\n  const response = await post(f.share.id, null, \"bundle\");\r\n  expect(response.status).toBe(200);\r\n  const text = await response.text();\r\n  expect(text).not.toContain(\"PRIVATE_CROP\");\r\n  expect(text).not.toContain(\"PRIVATE_CANVAS\");\r\n});\r\n\r\nit(\"keeps later owner publications and later turns out of the public preview\", async () => {\r\n  const f = await fixture();\r\n  const chats = await import(\"@/lib/library/chats\");\r\n  const thread = chats.createChat(\r\n    \"nlp\",\r\n    \"attention\",\r\n    \"ana\",\r\n    \"Approved readers only\",\r\n  );\r\n  chats.appendMessage(\"nlp\", \"attention\", \"ana\", thread.id, {\r\n    role: \"user\",\r\n    content: \"COLLABORATION_ONLY\",\r\n    at: new Date().toISOString(),\r\n  });\r\n  await f.storage.withCollaboration(f.share, async () =>\r\n    f.shares.publishOwnerChat(f.share, f.capability, thread.id),\r\n  );\r\n  const publicBundle = await post(f.share.id, null, \"bundle\");\r\n  expect(await publicBundle.text()).not.toContain(\"COLLABORATION_ONLY\");\r\n  const approvedBundle = await post(f.share.id, f.token, \"read\");\r\n  expect(await approvedBundle.text()).toContain(\"COLLABORATION_ONLY\");\r\n  expect(\r\n    f.shares.getShare(\"nlp\", \"attention\", f.share.id)?.conversations,\r\n  ).toHaveLength(0);\r\n});\r\n\r\nit(\"binds shared conversation writes to the approved actor and checks revisions\", async () => {\r\n  const f = await fixture();\r\n  const chat = {\r\n    header: {\r\n      id: \"1\".repeat(16),\r\n      title: \"Shared explanation\",\r\n      username: \"ana\",\r\n      titleSource: \"manual\",\r\n      createdAt: new Date().toISOString(),\r\n    },\r\n    messages: [\r\n      {\r\n        role: \"user\",\r\n        content: \"A published question\",\r\n        at: new Date().toISOString(),\r\n      },\r\n    ],\r\n  };\r\n  const first = await post(f.share.id, f.token, \"publish\", {\r\n    chat,\r\n    assets: {},\r\n    expected: null,\r\n  });\r\n  expect(first.status).toBe(200);\r\n  const published = await first.json();\r\n  expect(published.author).toBe(\"Maya Approved\");\r\n  expect(published.chat.header.username).toBe(f.participant.id);\r\n  expect(\r\n    (\r\n      await post(f.share.id, f.token, \"publish\", {\r\n        chat,\r\n        assets: {},\r\n        expected: null,\r\n      })\r\n    ).status,\r\n  ).toBe(200);\r\n  const changed = {\r\n    ...chat,\r\n    messages: [\r\n      ...chat.messages,\r\n      { role: \"user\", content: \"New turn\", at: new Date().toISOString() },\r\n    ],\r\n  };\r\n  expect(\r\n    (\r\n      await post(f.share.id, f.token, \"publish\", {\r\n        chat: changed,\r\n        assets: {},\r\n        expected: null,\r\n      })\r\n    ).status,\r\n  ).toBe(409);\r\n  expect(\r\n    (\r\n      await post(f.share.id, f.token, \"publish\", {\r\n        chat: changed,\r\n        assets: {},\r\n        expected: published.revision,\r\n      })\r\n    ).status,\r\n  ).toBe(200);\r\n  expect(await (await post(f.share.id, null, \"bundle\")).text()).not.toContain(\r\n    \"A published question\",\r\n  );\r\n  const forged = await post(f.share.id, f.token, \"publish\", {\r\n    chat,\r\n    assets: {},\r\n    expected: published.revision,\r\n    actorId: \"ana\",\r\n    author: \"Ana\",\r\n  });\r\n  expect(forged.status).toBe(400);\r\n});\r\n\r\nit(\"rejects attachment traversal, unreferenced data, and forged image payloads\", async () => {\r\n  const f = await fixture();\r\n  const header = {\r\n    id: \"1\".repeat(16),\r\n    title: \"Attachments\",\r\n    username: \"ana\",\r\n    titleSource: \"manual\",\r\n    createdAt: new Date().toISOString(),\r\n  };\r\n  const message = {\r\n    role: \"user\",\r\n    content: \"image\",\r\n    at: new Date().toISOString(),\r\n  };\r\n  const traversal = {\r\n    header,\r\n    messages: [{ ...message, images: [\"crops/../../identity.json\"] }],\r\n  };\r\n  expect(\r\n    (\r\n      await post(f.share.id, f.token, \"publish\", {\r\n        chat: traversal,\r\n        assets: {},\r\n        expected: null,\r\n      })\r\n    ).status,\r\n  ).toBe(400);\r\n  const image = Buffer.from(\"<svg onload='alert(1)' />\");\r\n  const name = f.storage.digest(image) + \".png\";\r\n  const assets = { [name]: image.toString(\"base64\") };\r\n  expect(\r\n    (\r\n      await post(f.share.id, f.token, \"publish\", {\r\n        chat: { header, messages: [message] },\r\n        assets,\r\n        expected: null,\r\n      })\r\n    ).status,\r\n  ).toBe(400);\r\n  expect(\r\n    (\r\n      await post(f.share.id, f.token, \"publish\", {\r\n        chat: { header, messages: [{ ...message, images: [`crops/${name}`] }] },\r\n        assets,\r\n        expected: null,\r\n      })\r\n    ).status,\r\n  ).toBe(400);\r\n});\r\n\r\nit(\"withdraws only the caller's shared conversation without deleting private history\", async () => {\r\n  const f = await fixture();\r\n  const chat = {\r\n    header: {\r\n      id: \"1\".repeat(16),\r\n      title: \"Withdraw me\",\r\n      username: \"ana\",\r\n      createdAt: new Date().toISOString(),\r\n    },\r\n    messages: [\r\n      {\r\n        role: \"user\",\r\n        content: \"Shared until withdrawn\",\r\n        at: new Date().toISOString(),\r\n      },\r\n    ],\r\n  };\r\n  expect(\r\n    (\r\n      await post(f.share.id, f.token, \"publish\", {\r\n        ch