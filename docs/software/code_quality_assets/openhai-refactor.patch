pers)).toBe(before);\r\n  });\r\n\r\n  it(\"combines tags with theme, reading status and case-insensitive metadata search\", () => {\r\n    const papers = [\r\n      paper(\"wanted\", {\r\n        title: \"课堂研究\",\r\n        authors: \"Alice Li\",\r\n        tags: [\"AI\", \"方法\"],\r\n        readStatus: \"reading\",\r\n      }),\r\n      paper(\"wrong-topic\", {\r\n        title: \"课堂研究\",\r\n        authors: \"Alice Li\",\r\n        topic: \"课题二\",\r\n        tags: [\"AI\", \"方法\"],\r\n        readStatus: \"reading\",\r\n      }),\r\n      paper(\"wrong-status\", {\r\n        title: \"课堂研究\",\r\n        authors: \"Alice Li\",\r\n        tags: [\"AI\", \"方法\"],\r\n        readStatus: \"finished\",\r\n      }),\r\n      paper(\"missing-tag\", {\r\n        title: \"课堂研究\",\r\n        authors: \"Alice Li\",\r\n        tags: [\"AI\"],\r\n        readStatus: \"reading\",\r\n      }),\r\n    ];\r\n    const combined = {\r\n      ...filters,\r\n      topic: \"课题一\",\r\n      readStatus: \"reading\" as const,\r\n      query: \"  ALICE  \",\r\n      tags: [\"ai\", \"方法\"],\r\n    };\r\n    expect(\r\n      filterAndSortPapers(papers, combined).map((value) => value.id),\r\n    ).toEqual([\"wanted\"]);\r\n    expect(\r\n      filterAndSortPapers(papers, { ...combined, query: \"2026\" }).map(\r\n        (value) => value.id,\r\n      ),\r\n    ).toEqual([\"wanted\"]);\r\n    expect(filterAndSortPapers(papers, filters)).toHaveLength(4);\r\n  });\r\n\r\n  it(\"sorts independently by date added, date updated or natural title order\", () => {\r\n    const papers = [\r\n      paper(\"alpha10\", {\r\n        title: \"Alpha 10\",\r\n        createdAt: \"2026-10-03T00:00:00Z\",\r\n        updatedAt: \"2026-10-04T00:00:00Z\",\r\n      }),\r\n      paper(\"alpha2\", {\r\n        title: \"Alpha 2\",\r\n        createdAt: \"2026-10-02T00:00:00Z\",\r\n        updatedAt: \"2026-10-05T00:00:00Z\",\r\n      }),\r\n      paper(\"beta\", {\r\n        title: \"Beta\",\r\n        createdAt: \"2026-10-01T00:00:00Z\",\r\n        updatedAt: \"2026-10-06T00:00:00Z\",\r\n      }),\r\n    ];\r\n    expect(\r\n      filterAndSortPapers(papers, filters).map((value) => value.id),\r\n    ).toEqual([\"alpha10\", \"alpha2\", \"beta\"]);\r\n    expect(\r\n      filterAndSortPapers(papers, { ...filters, sort: \"updated\" }).map(\r\n        (value) => value.id,\r\n      ),\r\n    ).toEqual([\"beta\", \"alpha2\", \"alpha10\"]);\r\n    expect(\r\n      filterAndSortPapers(papers, { ...filters, sort: \"title\" }).map(\r\n        (value) => value.id,\r\n      ),\r\n    ).toEqual([\"alpha2\", \"alpha10\", \"beta\"]);\r\n  });\r\n});\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\tests\\lib\\research-note-drafts.test.ts","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (193). Maximum allowed is 50.","line":86,"column":43,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":283,"endColumn":2}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { describe, expect, it } from \"vitest\";\r\nimport type { ResearchNote } from \"@/lib/research/types\";\r\nimport {\r\n  editableNote,\r\n  generatedNoteOrigin,\r\n  hasUnsavedNote,\r\n  listLocalNotes,\r\n  LocalNoteConflict,\r\n  localNoteKey,\r\n  noteVersionConflict,\r\n  needsNoteLeaveProtection,\r\n  noteTabSlot,\r\n  readLocalNote,\r\n  removeLocalNote,\r\n  writeLocalNote,\r\n  type DraftStorage,\r\n  type EditableNote,\r\n  type LocalNoteDraft,\r\n} from \"@/components/research/learning/note-drafts\";\r\n\r\nclass MemoryStorage implements DraftStorage {\r\n  data = new Map<string, string>();\r\n  get length() {\r\n    return this.data.size;\r\n  }\r\n  key(index: number) {\r\n    return [...this.data.keys()][index] ?? null;\r\n  }\r\n  getItem(key: string) {\r\n    return this.data.get(key) ?? null;\r\n  }\r\n  setItem(key: string, value: string) {\r\n    this.data.set(key, value);\r\n  }\r\n  removeItem(key: string) {\r\n    this.data.delete(key);\r\n  }\r\n}\r\nfunction model(patch: Partial<EditableNote> = {}): EditableNote {\r\n  return {\r\n    paperId: \"paper-a\",\r\n    title: \"Reading note\",\r\n    body: \"Original source and my thought\",\r\n    kind: \"reading\",\r\n    sources: [\r\n      {\r\n        paperId: \"paper-a\",\r\n        page: 2,\r\n        quote: \"Original source\",\r\n        contentRevision: \"text-v1\",\r\n      },\r\n    ],\r\n    confirmed: false,\r\n    origin: \"manual\",\r\n    ...patch,\r\n  };\r\n}\r\nfunction saved(patch: Partial<ResearchNote> = {}): ResearchNote {\r\n  return {\r\n    id: \"note-a\",\r\n    version: 3,\r\n    paperId: \"paper-a\",\r\n    title: \"Saved title\",\r\n    body: \"Saved body\",\r\n    content: \"Saved body\",\r\n    kind: \"reading\",\r\n    sources: [],\r\n    confirmed: false,\r\n    status: \"draft\",\r\n    createdAt: \"2026-10-31T00:00:00Z\",\r\n    updatedAt: \"2026-10-31T00:00:00Z\",\r\n    ...patch,\r\n  };\r\n}\r\nfunction draft(value = model(), token = \"writer-a\"): LocalNoteDraft {\r\n  return {\r\n    schema: 1,\r\n    type: \"draft\",\r\n    key: localNoteKey(value),\r\n    token,\r\n    model: value,\r\n    updatedAt: \"2026-10-31T00:00:00Z\",\r\n  };\r\n}\r\n\r\ndescribe(\"recoverable local note drafts\", () => {\r\n  it(\"allows leaving a locally persisted draft but protects failed storage, conflicts, and in-flight saves\", () => {\r\n    expect(needsNoteLeaveProtection(true, \"local\")).toBe(false);\r\n    expect(needsNoteLeaveProtection(true, \"local\", true)).toBe(true);\r\n    for (const status of [\"memory\", \"unavailable\", \"conflict\"] as const) {\r\n      expect(needsNoteLeaveProtection(true, status)).toBe(true);\r\n      expect(needsNoteLeaveProtection(false, status)).toBe(false);\r\n    }\r\n    expect(needsNoteLeaveProtection(false, \"local\")).toBe(false);\r\n    expect(needsNoteLeaveProtection(false, \"memory\", true)).toBe(true);\r\n  });\r\n  it(\"keeps a tab's recovery identity across refreshes and isolates separate tab sessions\", () => {\r\n    const firstTab = new MemoryStorage();\r\n    const secondTab = new MemoryStorage();\r\n    const firstSlot = noteTabSlot(firstTab);\r\n    expect(noteTabSlot(firstTab)).toBe(firstSlot);\r\n    const secondSlot = noteTabSlot(secondTab);\r\n    expect(secondSlot).not.toBe(firstSlot);\r\n    const note = editableNote(saved());\r\n    expect(localNoteKey({ ...note, slot: firstSlot })).not.toBe(\r\n      localNoteKey({ ...note, slot: secondSlot }),\r\n    );\r\n    const stored = draft({\r\n      ...note,\r\n      slot: firstSlot,\r\n      body: \"This tab's unsubmitted edits\",\r\n    });\r\n    writeLocalNote(firstTab, stored, null);\r\n    expect(readLocalNote(firstTab, stored.key)).toEqual(stored);\r\n    expect(noteVersionConflict(stored.model, saved({ version: 4 }))).toBe(true);\r\n  });\r\n  it(\"isolates papers, existing note IDs, and generated materials while keeping repeated opens stable\", () => {\r\n    const seed = model();\r\n    const origin = generatedNoteOrigin(seed);\r\n    expect(generatedNoteOrigin({ ...seed })).toBe(origin);\r\n    expect(\r\n      generatedNoteOrigin({ ...seed, body: \"A different selected passage\" }),\r\n    ).not.toBe(origin);\r\n    expect(\r\n      generatedNoteOrigin({\r\n        ...seed,\r\n        sources: [{ paperId: \"paper-a\", page: 3 }],\r\n      }),\r\n    ).not.toBe(origin);\r\n    expect(generatedNoteOrigin({ ...seed, runId: \"run-a\" })).not.toBe(\r\n      generatedNoteOrigin({ ...seed, runId: \"run-b\" }),\r\n    );\r\n    expect(localNoteKey({ ...seed, origin })).not.toBe(\r\n      localNoteKey({ ...seed, origin, paperId: \"paper-b\" }),\r\n    );\r\n    expect(localNoteKey(model({ id: \"note-a\", version: 1 }))).not.toBe(\r\n      localNoteKey(model({ id: \"note-b\", version: 1 })),\r\n    );\r\n    expect(localNoteKey(model({ id: \"note-a\", version: 1 }))).toBe(\r\n     