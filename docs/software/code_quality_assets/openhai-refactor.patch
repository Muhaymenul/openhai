+def service_at(tmp_path: Path, caller: Any = turn("来源证据显示理解得分提高 8.4 分。"),
+               **kwargs: Any) -> research_service.ResearchService:
+    return research_service.ResearchService(tmp_path / "runtime", config(), model_call=caller, **kwargs)
+
+
+def tracked(root: Path) -> set:
+    """Everything except the service's own two state files and the tmp writer."""
+    return {path.name for path in root.rglob("*")
+            if path.name not in {"state.json", "events.jsonl"} and path.suffix != ".tmp"}
+
