hApi } from \"../api\";\r\nimport { EmptyState, Modal } from \"../ResearchUi\";\r\nimport styles from \"../styles\";\r\nimport trashStyles from \"./trash.module.css\";\r\n\r\ntype TrashProps = {\r\n  onClose(): void;\r\n  onRefresh(): Promise<void>;\r\n  notify(message: string, error?: boolean): void;\r\n};\r\n\r\nexport function RemovePaperModal({\r\n  paper,\r\n  onClose,\r\n  onRefresh,\r\n  onRemoved,\r\n  notify,\r\n}: TrashProps & {\r\n  paper: ResearchPaper;\r\n  onRemoved(): void;\r\n}) {\r\n  const [busy, setBusy] = useState(false);\r\n  const [error, setError] = useState(\"\");\r\n  const locked = useRef(false);\r\n\r\n  async function remove() {\r\n    if (locked.current) return;\r\n    locked.current = true;\r\n    setBusy(true);\r\n    setError(\"\");\r\n    try {\r\n      await researchApi(\"/papers/\" + paper.id, {\r\n        method: \"DELETE\",\r\n        body: JSON.stringify({ version: paper.version }),\r\n      });\r\n    } catch (cause) {\r\n      setError(errorText(cause));\r\n      await onRefresh().catch(() => undefined);\r\n      locked.current = false;\r\n      setBusy(false);\r\n      return;\r\n    }\r\n    try {\r\n      await onRefresh();\r\n      notify(\"已移至回收站，可随时恢复。\");\r\n    } catch {\r\n      notify(\"已移至回收站，请刷新页面更新列表。\", true);\r\n    }\r\n    onRemoved();\r\n    onClose();\r\n  }\r\n\r\n  return (\r\n    <Modal title=\"移至回收站？\" onClose={() => !busy && onClose()}>\r\n      <div className={styles.modalBody}>\r\n        <div className={trashStyles.removalPaper}>\r\n          <FileText size={22} aria-hidden=\"true\" />\r\n          <strong>{paper.title}</strong>\r\n        </div>\r\n        <p className={trashStyles.description}>\r\n          PDF、笔记和批注会保留，恢复后可继续阅读。\r\n        </p>\r\n        {error && (\r\n          <p className={trashStyles.error} role=\"alert\">\r\n            {error}\r\n          </p>\r\n        )}\r\n      </div>\r\n      <div className={styles.modalFooter}>\r\n        <button\r\n          className={styles.secondaryButton}\r\n          disabled={busy}\r\n          onClick={onClose}\r\n        >\r\n          取消\r\n        </button>\r\n        <button\r\n          className={`${styles.dangerButton} ${trashStyles.confirmButton}`}\r\n          disabled={busy}\r\n          onClick={() => void remove()}\r\n        >\r\n          {busy ? (\r\n            <LoaderCircle size={15} className={styles.spin} />\r\n          ) : (\r\n            <Trash2 size={15} />\r\n          )}\r\n          {busy ? \"正在移入…\" : \"移至回收站\"}\r\n        </button>\r\n      </div>\r\n    </Modal>\r\n  );\r\n}\r\n\r\nfunction trashDate(value?: string) {\r\n  if (!value) return \"\";\r\n  const date = new Date(value);\r\n  return Number.isNaN(date.valueOf())\r\n    ? \"\"\r\n    : new Intl.DateTimeFormat(\"zh-CN\", {\r\n        month: \"short\",\r\n        day: \"numeric\",\r\n        hour: \"2-digit\",\r\n        minute: \"2-digit\",\r\n      }).format(date);\r\n}\r\n\r\nexport function PaperTrashModal({ onClose, onRefresh, notify }: TrashProps) {\r\n  const [papers, setPapers] = useState<ResearchPaper[]>([]);\r\n  const [loading, setLoading] = useState(true);\r\n  const [restoring, setRestoring] = useState(\"\");\r\n  const [error, setError] = useState(\"\");\r\n  const locked = useRef(false);\r\n\r\n  useEffect(() => {\r\n    const controller = new AbortController();\r\n    void researchApi<{ papers: ResearchPaper[] }>(\"/trash\", {\r\n      signal: controller.signal,\r\n    })\r\n      .then((result) => setPapers(result.papers))\r\n      .catch((cause: unknown) => {\r\n        if (!controller.signal.aborted) setError(errorText(cause));\r\n      })\r\n      .finally(() => {\r\n        if (!controller.signal.aborted) setLoading(false);\r\n      });\r\n    return () => controller.abort();\r\n  }, []);\r\n\r\n  async function reload() {\r\n    if (locked.current) return;\r\n    locked.current = true;\r\n    setLoading(true);\r\n    setError(\"\");\r\n    try {\r\n      const result = await researchApi<{ papers: ResearchPaper[] }>(\"/trash\");\r\n      setPapers(result.papers);\r\n    } catch (cause) {\r\n      setError(errorText(cause));\r\n    } finally {\r\n      locked.current = false;\r\n      setLoading(false);\r\n    }\r\n  }\r\n\r\n  async function restore(paper: ResearchPaper) {\r\n    if (locked.current) return;\r\n    locked.current = true;\r\n    setRestoring(paper.id);\r\n    setError(\"\");\r\n    try {\r\n      await postJson(\"/papers/\" + paper.id + \"/restore\", {\r\n        version: paper.version,\r\n      });\r\n      setPapers((current) => current.filter((value) => value.id !== paper.id));\r\n      try {\r\n        await onRefresh();\r\n        notify(\"论文已恢复，笔记和批注已同步。\");\r\n      } catch {\r\n        notify(\"论文已恢复，请刷新页面更新文献库。\", true);\r\n      }\r\n    } catch (cause) {\r\n      const message = errorText(cause);\r\n      const result = await researchApi<{ papers: ResearchPaper[] }>(\r\n        \"/trash\",\r\n      ).catch(() => null);\r\n      if (result) setPapers(result.papers);\r\n      setError(message);\r\n    } finally {\r\n      locked.current = false;\r\n      setRestoring(\"\");\r\n    }\r\n  }\r\n\r\n  const busy = loading || !!restoring;\r\n  return (\r\n    <Modal\r\n      title=\"回收站\"\r\n      subtitle=\"论文、笔记和批注可一并恢复\"\r\n      wide\r\n      onClose={() => !restoring && onClose()}\r\n    >\r\n      <div className={`${styles.modalBody} ${trashStyles.trashBody}`}>\r\n        <div className={trashStyles.trashToolbar}>\r\n          <span aria-live=\"polite\">\r\n            {loading ? \"正在读取…\" : papers.length + \" 篇论文\"}\r\n          </span>\r\n          <button\r\n            className={styles.textButton}\r\n            disabled={busy}\r\n            onClick={() => void reload()}\r\n            aria-label=\"刷新回收站\"\r\n          >\r\n            <RefreshCw size={14} aria-hidden=\"true\" />\r\n            刷新\r\n          </button>\r\n        </div>\r\n        {error && (\r\n          <p className={trashStyles.error} role=\"alert\">\r\n            {error}\r\n          </p>\r\n        )}\r\n        {loading ? (\r\n          <div className={trashStyles.loading} role=\"status\">\r\n            <LoaderCircle size={19} className={styles.spin} />\r\n            正在读取回收站…\r\n          </div>\r\n        ) : papers.length > 0 ? (\r\n          <ul className={trashStyles.trashList} aria-label=\"可恢复的论文\">\r\n            {papers.map((paper) => (\r\n              <li key={paper.id} data-trashed-paper={paper.id}>\r\n                <span className={trashStyles.fileIcon}>\r\n                  <FileText size={22} aria-hidden=\"true\" />\r\n                </span>\r\n                <div className={trashStyles.trashPaperInfo}>\r\n                  <h3>{paper.title}</h3>\r\n                  <p>\r\n                    {paper.topic} · {paper.pageCount} 页\r\n                  </p>\r\n                  <time dateTime={paper.trashedAt}>\r\n                    移入于 {trashDate(paper.trashedAt)}\r\n                  </time>\r\n                </div>\r\n                <button\r\n                  className={styles.secondaryButton}\r\n                  disabled={busy}\r\n                  onClick={() => void restore(paper)}\r\n                  aria-label={\"恢复论文：\" + paper.title}\r\n                >\r\n                  {restoring === paper.id ? (\r\n                    <LoaderCircle size={14} className={styles.spin} />\r\n                  ) : (\r\n                    <RotateCcw size={14} aria-hidden=\"true\" />\r\n                  )}\r\n                  {restoring === paper.id ? \"正在恢复…\" : \"恢复\"}\r\n                </button>\r\n              </li>\r\n            ))}\r\n          </ul>\r\n        ) : !error ? (\r\n          <EmptyState\r\n            icon={<Trash2 size={24} />}\r\n            title=\"回收站为空\"\r\n            description=\"移入回收站的论文会显示在这里。\"\r\n          />\r\n        ) : null}\r\n      </div>\r\n      <div className={styles.modalFooter}>\r\n        <button\r\n          className={styles.secondaryButton}\r\n          disabled={!!restoring}\r\n          onClick={onClose}\r\n        >\r\n          关闭\r\n        </button>\r\n      </div>\r\n    </Modal>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\library\\filters.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\library\\upload-queue.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\planner\\ResearchPlanner.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'ResearchPlanner' has too many lines (318). Maximum allowed is 50.","line":31,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":348,"endColumn":2},{"ruleId":"complexity","severity":1,"message":"Function 'begin' has a complexity of 17. Maximum allowed is 10.","line":60,"column":3,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":60,"endColumn":17},{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (70). Maximum allowed is 50.","line":183,"column":22,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":252,"endColumn":10}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\r\n\r\nimport {\r\n  CalendarDays,\r\n  Check,\r\n  Circle,\r\n  Download,\r\n  Pencil,\r\n  Plus,\r\n  Archive,\r\n  ArrowUpRight,\r\n} from \"lucide-react\";\r\nimport { useEffect, useRef, useState } from \"react\";\r\nimport type { ResearchPaper, SourceRef } from \"@/lib/research/types\";\r\nimport type { PlannerTask } from \"@/lib/research/planner/types\";\r\nimport { parseDeadlineText, shanghaiInput } from \"@/lib/research/planner/date\";\r\nimport { errorText, patchJson, postJson, researchApi } from \"../api\";\r\nimport { Modal } from \"../ResearchUi\";\r\nimport styles from \"./planner.module.css\";\r\n\r\nconst dueFormat = new Intl.DateTimeFormat(\"zh-CN\", {\r\n  month: \"long\",\r\n  day: \"numeric\",\r\n  weekday: \"short\",\r\n  hour: \"2-digit\",\r\n  minute: \"2-digit\",\r\n  timeZone: \"Asia/Shanghai\",\r\n});\r\nconst priorityNames = { high: \"优先\", normal: \"普通\", low: \"稍后\" };\r\n\r\nexport function ResearchPlanner({\r\n  papers,\r\n  onOpenSource,\r\n  notify,\r\n}: {\r\n  papers: ResearchPaper[];\r\n  onOpenSource(source: SourceRef): void;\r\n  notify(message: string, error?: boolean): void;\r\n}) {\r\n  const [tasks, setTasks] = useState<PlannerTask[]>([]);\r\n  const [filter, setFilter] = useState<PlannerTask[\"status\"]>(\"todo\");\r\n  const [input, setInput] = useState(\"\");\r\n  const [open, setOpen] = useState(false);\r\n  const [editing, setEditing] = useState<PlannerTask | null>(null);\r\n  const [title, setTitle] = useState(\"\");\r\n  const [dueLocal, setDueLocal] = useState(\"\");\r\n  const [paperId, setPaperId] = useState(\"\");\r\n  const [priority, setPriority] = useState<PlannerTask[\"priority\"]>(\"normal\");\r\n  const [saving, setSaving] = useState(false);\r\n  const [busy, setBusy] = useState(\"\");\r\n  const [now, setNow] = useState(() => Date.now());\r\n  const actionId = useRef(\"\");\r\n  useEffect(() => {\r\n    void researchApi<{ tasks: PlannerTask[] }>(\"/planner\")\r\n      .then((value) => setTasks(value.tasks))\r\n      .catch((error) => notify(errorText(error), true));\r\n    const timer = setInterval(() => setNow(Date.now()), 60000);\r\n    return () => clearInterval(timer);\r\n  }, [notify]);\r\n  function begin(task?: PlannerTask, parse = false) {\r\n    const parsed = parse ? parseDeadlineText(input) : null;\r\n    setEditing(task ?? null);\r\n    setTitle(task?.title ?? parsed?.title ?? \"\");\r\n    setDueLocal(task ? shanghaiInput(task.dueAt) : (parsed?.dueLocal ?? \"\"));\r\n    setPaperId(task?.paperId ?? \"\");\r\n    setPriority(task?.priority ?? parsed?.priority ?? \"normal\");\r\n    actionId.current = crypto.randomUUID();\r\n    setOpen(true);\r\n  }\r\n  function receive(task: PlannerTask) {\r\n    setTasks((current) => [\r\n      task,\r\n      ...current.filter((value) => value.id !== task.id),\r\n    ]);\r\n  }\r\n  async function save() {\r\n    if (!title.trim() || !dueLocal || saving) return;\r\n    setSaving(true);\r\n    try {\r\n      const dueAt = new Date(dueLocal + \"+08:00\").toISOString();\r\n      const data = {\r\n        title: title.trim(),\r\n        dueAt,\r\n        paperId: paperId || (editing ? null : undefined),\r\n        priority,\r\n      };\r\n      const result = editing\r\n        ? await patchJson<{ task: PlannerTask }>(\"/planner/\" + editing.id, {\r\n            ...data,\r\n            version: editing.version,\r\n          })\r\n        : await postJson<{ task: PlannerTask }>(\"/planner\", {\r\n            ...data,\r\n            actionId: actionId.current,\r\n          });\r\n      receive(result.task);\r\n      setOpen(false);\r\n      setInput(\"\");\r\n      notify(\"研究待办已保存。\");\r\n    } catch (error) {\r\n      notify(errorText(error), true);\r\n    } finally {\r\n      setSaving(false);\r\n    }\r\n  }\r\n  async function change(task: PlannerTask, status: PlannerTask[\"status\"]) {\r\n    setBusy(task.id);\r\n    try {\r\n      const result = await patchJson<{ task: PlannerTask }>(\r\n        \"/planner/\" + task.id,\r\n        { status, version: task.version },\r\n      );\r\n      receive(result.task);\r\n    } catch (error) {\r\n      notify(errorText(error), true);\r\n    } finally {\r\n      setBusy(\"\");\r\n    }\r\n  }\r\n  const visible = tasks\r\n    .filter((task) => task.status === filter)\r\n    .sort((a, b) => a.dueAt.localeCompare(b.dueAt));\r\n  const overdue = tasks.filter(\r\n    (task) => task.status === \"todo\" && new Date(task.dueAt).getTime() < now,\r\n  ).length;\r\n  return (\r\n    <section className={styles.planner}>\r\n      <header className={styles.heading}>\r\n        <div>\r\n          <CalendarDays size={19} />\r\n          <h2>研究待办</h2>\r\n          {overdue > 0 && (\r\n            <span className={styles.overdue}>{overdue} 项已到期</span>\r\n          )}\r\n        </div>\r\n        <a href=\"/api/research/planner/calendar\" download>\r\n          <Download size={15} />\r\n          导出日历\r\n        </a>\r\n      </header>\r\n      <form\r\n        className={styles.quickAdd}\r\n        onSubmit={(event) => {\r\n          event.preventDefault();\r\n          if (input.trim()) begin(undefined, true);\r\n        }}\r\n      >\r\n        <input\r\n          aria-label=\"描述研究待办\"\r\n          placeholder=\"明天下午五点，完成论文精读笔记\"\r\n          value={input}\r\n          onChange={(event) => setInput(event.target.value)}\r\n          maxLength={500}\r\n        />\r\n        <button type=\"submit\" disabled={!input.trim()}>\r\n          <Plus size={16} />\r\n          填写待办\r\n        </button>\r\n      </form>\r\n      <div className={styles.tabs} role=\"group\" aria-label=\"筛选研究待办\">\r\n        {(\r\n          [\r\n            [\"todo\", \"待完成\"],\r\n            [\"done\", \"已完成\"],\r\n            [\"archived\", \"已归档\"],\r\n          ] as const\r\n        ).map(([value, label]) => (\r\n          <button\r\n            key={value}\r\n            aria-pressed={filter === value}\r\n            onClick={() => setFilter(value)}\r\n          >\r\n            {label}\r\n            <span>{tasks.filter((task) => task.status === value).length}</span>\r\n          </button>\r\n        ))}\r\n        <button className={styles.newButton} onClick={() => begin()}>\r\n          <Plus size={14} />\r\n          新建\r\n        </button>\r\n      </div>\r\n      <div className={styles.rows}>\r\n        {visible.map((