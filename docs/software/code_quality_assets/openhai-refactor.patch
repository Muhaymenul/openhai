-}
-
-# 未在 DEFAULT_POLICIES 中登记的工具的兜底策略
-_UNKNOWN_TOOL_DEFAULT = PermissionDecision.ASK
-
-# bash 参数中展示用的关键字段映射
-_PREVIEW_KEY: dict[str, str] = {
-    "bash":       "command",
-    "read_file":  "path",
-    "write_file": "path",
-    "list_dir":   "path",
-    "note_save":  "content",
-}
-_PREVIEW_MAX = 60
-
-
-# 为权限审批事件生成人类可读的参数摘要
