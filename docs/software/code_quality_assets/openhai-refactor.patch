 || !text.trim()}\r\n              onClick={() => void check()}\r\n            >\r\n              {busy ? \"正在提交…\" : \"检查理解\"}\r\n            </button>\r\n          </div>\r\n        </Modal>\r\n      )}\r\n    </>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\learning\\LearningComposer.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'LearningComposer' has too many lines (200). Maximum allowed is 50.","line":14,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":213,"endColumn":2},{"ruleId":"complexity","severity":1,"message":"Function 'LearningComposer' has a complexity of 20. Maximum allowed is 10.","line":14,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":14,"endColumn":33}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\r\n\r\nimport type {\r\n  LearningRequest,\r\n  LearningSource,\r\n} from \"@/lib/research/learning-types\";\r\nimport type { ResearchPaper, ResearchSelection } from \"@/lib/research/types\";\r\nimport { useState } from \"react\";\r\nimport type { PaperDetail } from \"../api\";\r\nimport { Modal } from \"../ResearchUi\";\r\nimport styles from \"../styles\";\r\nimport local from \"./learning.module.css\";\r\n\r\nexport function LearningComposer({\r\n  paper,\r\n  detail,\r\n  selection,\r\n  initial,\r\n  onClose,\r\n  onGenerate,\r\n}: {\r\n  paper: ResearchPaper;\r\n  detail: PaperDetail | null;\r\n  selection: ResearchSelection | null;\r\n  initial: LearningRequest;\r\n  onClose(): void;\r\n  onGenerate(request: LearningRequest): Promise<boolean>;\r\n}) {\r\n  const [source, setSource] = useState<LearningSource>(initial.source);\r\n  const [count, setCount] = useState<3 | 5 | 8>(initial.count ?? 5);\r\n  const [busy, setBusy] = useState(false);\r\n  const notes = detail?.notes ?? [];\r\n  const annotations = (detail?.annotations ?? []).filter(\r\n    (entry) => entry.contentRevision === paper.contentRevision,\r\n  );\r\n  const selected = source.kind === \"annotations\" ? source.ids : [];\r\n  function change(kind: string) {\r\n    if (kind === \"note\" && notes[0])\r\n      setSource({\r\n        kind: \"note\",\r\n        noteId: notes[0].id,\r\n        version: notes[0].version,\r\n      });\r\n    else if (kind === \"annotations\")\r\n      setSource({\r\n        kind,\r\n        ids: annotations.map((entry) => entry.id).slice(0, 30),\r\n        versions: Object.fromEntries(\r\n          annotations.map((entry) => [entry.id, entry.version]),\r\n        ),\r\n      });\r\n    else if (kind === \"selection\") setSource({ kind });\r\n    else setSource({ kind: \"paper\" });\r\n  }\r\n  async function generate() {\r\n    if (busy) return;\r\n    setBusy(true);\r\n    try {\r\n      if (\r\n        await onGenerate({\r\n          ...initial,\r\n          source,\r\n          ...(initial.task === \"quiz\" ? { count } : {}),\r\n        })\r\n      )\r\n        onClose();\r\n    } finally {\r\n      setBusy(false);\r\n    }\r\n  }\r\n  const valid =\r\n    source.kind === \"annotations\"\r\n      ? selected.length > 0 && selected.length <= 30\r\n      : source.kind === \"selection\"\r\n        ? !!selection\r\n        : source.kind === \"note\"\r\n          ? notes.some((note) => note.id === source.noteId)\r\n          : true;\r\n  return (\r\n    <Modal\r\n      title={initial.task === \"notes\" ? \"整理阅读笔记\" : \"生成自测题\"}\r\n      onClose={() => !busy && onClose()}\r\n    >\r\n      <div className={styles.modalBody}>\r\n        <p className={local.paperTitle}>{paper.title}</p>\r\n        <label className={styles.formLabel}>\r\n          材料范围\r\n          <select\r\n            aria-label=\"学习材料范围\"\r\n            value={source.kind}\r\n            onChange={(event) => change(event.target.value)}\r\n            disabled={busy}\r\n          >\r\n            