y;\r\n}\r\n\r\n/**\r\n * Read a web response without trusting Content-Length. The stream is cancelled\r\n * as soon as the actual payload crosses the limit.\r\n */\r\nexport async function readBoundedResponse(\r\n  response: ReadableResponse,\r\n  maxBytes: number,\r\n  close: () => Promise<void> = async () => {},\r\n): Promise<Buffer> {\r\n  const body = responseBody(response.body);\r\n  const contentLength = response.headers.get(\"content-length\");\r\n  if (contentLength && Number(contentLength) > maxBytes) {\r\n    await body?.cancel();\r\n    await close();\r\n    throw new ResponseTooLargeError(\r\n      `Response is too large (limit ${Math.round(maxBytes / 1e6)} MB).`,\r\n    );\r\n  }\r\n  const reader = body?.getReader();\r\n  if (!reader) {\r\n    await close();\r\n    return Buffer.alloc(0);\r\n  }\r\n  let bytes = Buffer.allocUnsafe(Math.min(maxBytes, 64 * 1024));\r\n  let size = 0;\r\n  try {\r\n    while (true) {\r\n      const { done, value } = await reader.read();\r\n      if (done) break;\r\n      if (!value) continue;\r\n      const nextSize = size + value.byteLength;\r\n      if (nextSize > maxBytes) {\r\n        await reader.cancel();\r\n        throw new ResponseTooLargeError(\r\n          `Response is too large (limit ${Math.round(maxBytes / 1e6)} MB).`,\r\n        );\r\n      }\r\n      if (nextSize > bytes.byteLength) {\r\n        const grown = Buffer.allocUnsafe(\r\n          Math.min(maxBytes, Math.max(nextSize, bytes.byteLength * 2)),\r\n        );\r\n        bytes.copy(grown, 0, 0, size);\r\n        bytes = grown;\r\n      }\r\n      bytes.set(value, size);\r\n      size = nextSize;\r\n    }\r\n  } finally {\r\n    reader.releaseLock();\r\n    await close();\r\n  }\r\n  return bytes.subarray(0, size);\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\lib\\capture\\browser\\submit.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWar