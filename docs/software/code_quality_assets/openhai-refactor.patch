+"""The five run-scoped tools the research model may call.
+
+Every tool reads only what this run was given; none of them touch the
+filesystem, the network, or a shell. Write-shaped tools return proposals that
+the web UI must confirm, and create_note additionally requires an approval.
+"""
+from __future__ import annotations
+
+import json
+import uuid
+from dataclasses import dataclass, field
+from typing import Any, Callable, Dict, List, Optional
+
+from research_context import annotation_source, read_paper, search_paper, source_documents
+
+MAX_TOOL_RESULT_CHARACTERS = 24_000
+
+
+class InvalidParams(ValueError):
+    """Raised when a tool call body does not satisfy the advertised schema."""
+
+
+def _bounded(value: Any, name: str, default: int, low: int, high: int) -> int:
+    if value is None:
+        return default
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise InvalidParams("%s must be an integer." % name)
+    if not low <= value <= high:
+        raise InvalidParams("%s must be between %d and %d." % (name, low, high))
+    return value
+
+
+def _text(value: Any, name: str, limit: int, required: bool = False) -> str:
+    if value is None:
+        if required:
+            raise InvalidParams("%s is required." % name)
+        return ""
+    if not isinstance(value, str):
+        raise InvalidParams("%s must be text." % name)
+    if len(value) > limit:
+        raise InvalidParams("%s is too long." % name)
+    if required and not value.strip():
+        raise InvalidParams("%s must not be empty." % name)
+    return value
+
+
+@dataclass(frozen=True)
+class ContextReadParams:
+    start: int = 0
+    length: int = 24_000
+
+    @classmethod
+    def from_request(cls, raw: Dict[str, Any]) -> "ContextReadParams":
+        _reject_unknown(raw, {"start", "length"})
+        return cls(_bounded(raw.get("start"), "start", 0, 0, 10_000_000),
+                   _bounded(raw.get("length"), "length", 24_000, 1, 60_000))
+
+
+@dataclass(frozen=True)
+class PaperReadParams:
+    start: int = 0
+    length: int = 12_000
+    document_id: Optional[str] = None
+    page: Optional[int] = None
+
+    @classmethod
+    def from_request(cls, raw: Dict[str, Any]) -> "PaperReadParams":
+        _reject_unknown(raw, {"start", "length", "document_id", "page"})
+        return cls(
+            _bounded(raw.get("start"), "start", 0, 0, 10_000_000),
+            _bounded(raw.get("length"), "length", 12_000, 1, 24_000),
+            _text(raw.get("document_id"), "document_id", 200) or None,
+            _bounded(raw.get("page"), "page", None, 1, 100_000) if raw.get("page") is not None else None,
+        )
+
+
+@dataclass(frozen=True)
+class PaperSearchParams:
+    query: str = ""
+    document_id: Optional[str] = None
+    limit: int = 4
+
+    @classmethod
+    def from_request(cls, raw: Dict[str, Any]) -> "PaperSearchParams":
+        _reject_unknown(raw, {"query", "document_id", "limit"})
+        return cls(_text(raw.get("query"), "query", 500, required=True),
+                   _text(raw.get("document_id"), "document_id", 200) or None,
+                   _bounded(raw.get("limit"), "limit", 4, 1, 6))
+
+
+@dataclass(frozen=True)
+class ProposalParams:
+    title: str = "研究笔记"
+    body: str = ""
+    quote: str = ""
+    page: Optional[int] = None
+    anchor_id: Optional[str] = None
+
+    @classmethod
+    def from_request(cls, raw: Dict[str, Any]) -> "ProposalParams":
+        _reject_unknown(raw, {"title", "body", "quote", "page", "anchor_id"})
+        return cls(
+            _text(raw.get("title"), "title", 300) or "研究笔记",
+            _text(raw.get("body"), "body", 60_000, required=True),
+            _text(raw.get("quote"), "quote", 20_000),
+            _bounded(raw.get("page"), "page", None, 1, 100_000) if raw.get("page") is not None else None,
+            _text(raw.get("anchor_id"), "anchor_id", 200) or None,
+        )
+
+
+@dataclass(frozen=True)
+class SourcePage:
+    page: int
+    text: str
+
+
+@dataclass
+class SourceDocument:
+    document_id: str
+    title: str = ""
+    pages: List[SourcePage] = field(default_factory=list)
+
+    @classmethod
+    def from_request(cls, raw: Dict[str, Any]) -> "SourceDocument":
+        if not isinstance(raw, dict):
+            raise InvalidParams("source_documents must be objects.")
+        _reject_unknown(raw, {"document_id", "title", "pages"})
+        identifier = _text(raw.get("document_id"), "document_id", 200, required=True)
+        pages_raw = raw.get("pages") or []
+        if not isinstance(pages_raw, list) or len(pages_raw) > 2000:
+            raise InvalidParams("pages must be a list of at most 2000 entries.")
+        pages = []
+        for entry in pages_raw:
+            if not isinstance(entry, dict) or set(entry) - {"page", "text"}:
+                raise InvalidParams("each page needs exactly page and text.")
+            pages.append(SourcePage(_bounded(entry.get("page"), "page", 0, 1, 100_000),
+                                    _text(entry.get("text"), "text", 100_000)))
+        numbers = [page.page for page in pages]
+        if len(numbers) != len(set(numbers)):
+            raise InvalidParams("Source page numbers must be unique")
+        return cls(identifier, _text(raw.get("title"), "title", 1000), pages)
+
+    def as_dict(self) -> Dict[str, Any]:
+        return {"document_id": self.document_id, "title": self.title,
+                "pages": [{"page": page.page, "text": page.text} for page in self.pages]}
+
+
+def _reject_unknown(raw: Dict[str, Any], allowed: set) -> None:
+    extra = set(raw) - allowed
+    if extra:
+        raise InvalidParams("unexpected field(s): %s" % ", ".join(sorted(extra)))
+
+
+_INT_SCHEMA = {"type": "integer"}
+_READ_SCHEMA = {
+    "type": "object",
+    "properties": {"start": dict(_INT_SCHEMA, minimum=0), "length": dict(_INT_SCHEMA, minimum=1, maximum=60_000)},
+}
+_READ_PAPER_SCHEMA = {
+    "type": "object",
+    "properties": {
+        "start": dict(_INT_SCHEMA, minimum=0),
+        "length": dict(_INT_SCHEMA, minimum=1, maximum=24_000),
+        "document_id": {"type": "string", "minLength": 1, "maxLength": 200},
+        "page": dict(_INT_SCHEMA, minimum=1),
+    },
+}
+_SEARCH_SCHEMA = {
+    "type": "object",
+    "properties": {
+        "query": {"type": "string", "minLength": 1, "maxLength": 500},
+        "document_id": {"type": "string", "minLength": 1, "maxLength": 200},
+        "limit": dict(_INT_SCHEMA, minimum=1, maximum=6),
+    },
+    "required": ["query"],
+}
+_PROPOSAL_SCHEMA = {
+    "type": "object",
+    "properties": {
+        "title": {"type": "string", "maxLength": 300},
+        "body": {"type": "string", "minLength": 1, "maxLength": 60_000},
+        "quote": {"type": "string", "maxLength": 20_000},
+        "page": dict(_INT_SCHEMA, minimum=1),
+        "anchor_id": {"type": "string", "maxLength": 200},
+    },
+    "required": ["body"],
+}
+
+DESCRIPTIONS = {
+    "read_selection": "Read only the user-selected text and its supplied anchor metadata. No filesystem access.",
+    "read_paper_text": "Read this run's supplied context or a supplied source document/page. start and length are character offsets. Actual page numbers are returned. No filesystem access.",
+    "search_paper_text": "Search only this run's explicitly supplied papers by keywords or a short phrase. Returns relevant excerpts, actual page numbers and citation links. No filesystem or web access.",
+    "create_note": ("Propose a note for the web UI; never write an external file. "
+                    "Only use when the user explicitly asks to save a note. Approval is required."),
+    "propose_annotation": ("Propose an annotation anchored to quoted source text for the web UI. "
+                           "This does not alter a PDF; the user must confirm it in the reader. Never invent coordinates."),
+}
+
+
+class ToolOutcome:
+    def __init__(self, content: str, is_error: bool = False, short_circuit: Optional[str] = None) -> None:
+        self.content, self.is_error, self.short_circuit = content, is_error, short_circuit
+
+
+class Tool:
+    def __init__(self, name: str, schema: Dict[str, Any], parse: Callable[[Dict[str, Any]], Any],
+                 handler: Callable[[Any], ToolOutcome], requires_approval: bool = False) -> None:
+        self.name, self.schema, self.parse = name, schema, parse
+        self.handler, self.requires_approval = handler, requires_approval
+        self.description = DESCRIPTIONS[name]
+
+    def openai_definition(self) -> Dict[str, Any]:
+        return {"type": "function", "function": {"name": self.name, "description": self.description,
+                                                 "parameters": self.schema}}
+
+    def invoke(self, arguments: str) -> ToolOutcome:
+        try:
+            raw = json.loads(arguments) if arguments.strip() else {}
+        except ValueError:
+            return ToolOutcome("Tool arguments are not valid JSON.", is_error=True)
+        if not isinstance(raw, dict):
+            return ToolOutcome("Tool arguments must be an object.", is_error=True)
+        try:
+            params = self.parse(raw)
+        except (InvalidParams, ValueError) as error:
+            return ToolOutcome(str(error), is_error=True)
+        try:
+            return self.handler(params)
+        except (ValueError, KeyError) as error:
+            return ToolOutcome(str(error), is_error=True)
+
+
+def _clip(payload: Dict[str, Any]) -> str:
+    content = json.dumps(payload, ensure_ascii=False)
+    if len(content) <= MAX_TOOL_RESULT_CHARACTERS:
+        return content
+    kept = dict(payload)
+    kept["text"] = kept.get("text", "")[:MAX_TOOL_RESULT_CHARACTERS - 400]
+    kept["truncated"] = True
+    return json.dumps(kept, ensure_ascii=False)
+
+
+def build_registry(run: Dict[str, Any], on_proposal: Callable[[Dict[str, Any]], None]) -> List[Tool]:
+    """Tools available to this run, mirroring the run's supplied scope."""
+    has_documents = bool(run.get("source_documents"))
+
+    def read_context(params: ContextReadParams) -> ToolOutcome:
+        text = run["context"]
+        return ToolOutcome(_clip({"source": {"document_id": run["document_id"]},
+                                  "text": text[params.start:params.start + params.length],
+                                  "total_characters": len(text),
+                                  "has_more": params.start + params.length < len(text)}))
+
+    def read_from_sources(params: PaperReadParams) -> ToolOutcome:
+        return ToolOutcome(_clip(read_paper(run, params)))
+
+    def read_selection(params: ContextReadParams) -> ToolOutcome:
+        metadata = run.get("selection") or {}
+        text = str(metadata.get("text") or metadata.get("quote") or "")
+        if not text:
+            return ToolOutcome("No explicit selection was provided.", is_error=True)
+        return ToolOutcome(_clip({"source": metadata, "text": text[params.start:params.start + params.length],
+                                  "total_characters": len(text),
+                                  "has_more": params.start + params.length < len(text)}))
+
+    def search(params: PaperSearchParams) -> ToolOutcome:
+        return ToolOutcome(_clip(search_paper(run, params)))
+
+    def propose(params: ProposalParams, kind: str) -> ToolOutcome:
+        proposal = {"title": params.title, "body": params.body, "quote": params.quote,
+                    "page": params.page, "anchor_id": params.anchor_id}
+        if kind == "annotation":
+            quote = params.quote
+            selection = run.get("selection") or {}
+            source = annotation_source(run, params.page)
+            if params.page is None or params.page == selection.get("page"):
+                source += "\n" + str(selection.get("text") or selection.get("quote") or "")
+            if not quote or quote not in source:
+                return ToolOutcome("Annotation quote must match the provided paper or selection exactly.", is_error=True)
+            if params.anchor_id and params.anchor_id != selection.get("anchor_id", selection.get("id")):
+                return ToolOutcome("Unknown selection anchor.", is_error=True)
+        proposal.update({"id": "proposal-" + uuid.uuid4().hex, "kind": kind,
+                         "document_id": run["document_id"], "run_id": run["run_id"],
+                         "requires_confirmation": True})
+        run["proposals"].append(proposal)
+        on_proposal(proposal)
+        return ToolOutcome(json.dumps(proposal, ensure_ascii=False))
+
+    tools = [
+        Tool("read_selection", _READ_SCHEMA, ContextReadParams.from_request, read_selection),
+        Tool("read_paper_text", _READ_PAPER_SCHEMA if has_documents else _READ_SCHEMA,
+             PaperReadParams.from_request if has_documents else ContextReadParams.from_request,
+             read_from_sources if has_documents else read_context),
+        Tool("create_note", _PROPOSAL_SCHEMA, ProposalParams.from_request,
+             lambda params: propose(params, "note"), requires_approval=True),
+        Tool("propose_annotation", _PROPOSAL_SCHEMA, ProposalParams.from_request,
+             lambda params: propose(params, "annotation")),
+    ]
+    if has_documents or run.get("answer_style") == "discussion":
+        tools.append(Tool("search_paper_text", _SEARCH_SCHEMA, PaperSearchParams.from_request, search))
+    return tools
+
+
+def allowed_document_ids(run: Dict[str, Any]) -> List[str]:
+    return [entry["document_id"] for entry in source_documents(run)]
