@@ -0,0 +1,592 @@
+"""Regression suite for the standard-library research engine.
+
+These cases replace the PaperFlow-era tests. They keep the invariants that
+matter: source scope, idempotency, approval before any draft, recovery,
+cancellation and the TCP contract, but they script the model instead of
+importing an agent framework, so the suite runs offline with no third-party
+dependencies.
+"""
+from __future__ import annotations
+
+import asyncio
+import json
+import socket
+import sys
+import threading
+from pathlib import Path
+from typing import Any, Dict, List
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+import llm_client            # noqa: E402
+import research_service      # noqa: E402
+import research_tools        # noqa: E402
+from research_context import discussion_history, search_paper  # noqa: E402
+
+CONTEXT = ("[p.1] 本研究将 120 名学生随机分为两组，实验组使用带来源回跳的精读卡。"
+           "[p.2] 实验组理解得分平均提高 8.4 分（d=0.62），修订次数无显著差异。局限是单校样本。"
+           "[p.3] 结论：来源可追溯的精读卡改善理解，不自动改善修订行为。")
+
+SOURCES = [{"document_id": "paper-a", "title": "多模态精读卡", "pages": [
+    {"page": 1, "text": "本研究将 120 名学生随机分为两组，实验组使用带来源回跳的精读卡。"},
+    {"page": 2, "text": "实验组理解得分平均提高 8.4 分（d=0.62），修订次数无显著差异。局限是单校样本。"}]}]
+
+
+def config() -> research_service.EngineConfig:
+    value = research_service.EngineConfig()
+    value.base_url, value.default_model, value.api_key = "https://model.invalid/v1", "test-model", "sk-test-key-1234567890"
+    value.deadline, value.max_steps = 30.0, 4
+    return value
+
+
+def turn(text: str = "", calls: List[Dict[str, str]] | None = None, tokens: List[str] | None = None) -> Any:
+    """One scripted model turn: streamed tokens plus optional tool calls."""
+    def caller(base_url, api_key, model, messages, tools, on_event=None, deadline=None):
+        stream = llm_client.Stream()
+        for piece in (tokens if tokens is not None else ([text] if text else [])):
+            stream.text += piece
+            if on_event:
+                on_event({"kind": "token", "text": piece})
+        stream._by_index = {index: {"id": call.get("id", "call_%d" % index), "name": call["name"],
+                                    "arguments": call["arguments"]}
+                            for index, call in enumerate(calls or [])}
+        stream.finalize()
+        return stream
+    return caller
+
+
+def scripted(*callers: Any) -> Any:
+    """Feed one scripted turn per agent step; the last one repeats."""
+    state = {"index": 0, "calls": 0}
+
+    def caller(*args: Any, **kwargs: Any) -> Any:
+        state["calls"] += 1
+        chosen = callers[min(state["index"], len(callers) - 1)]
+        state["index"] += 1
+        return chosen(*args, **kwargs)
+
+    caller.calls = lambda: state["calls"]
+    return caller
+
+
+def holding(tokens: List[str]) -> Any:
+    """Stream tokens, then block until released: simulates a slow model call."""
+    release = threading.Event()
+
+    def caller(base_url, api_key, model, messages, tools, on_event=None, deadline=None):
+        stream = llm_client.Stream()
+        for piece in tokens:
+            stream.text += piece
+            if on_event:
+                on_event({"kind": "token", "text": piece})
+        stream._by_index = {0: {"id": "call_wait", "name": "", "arguments": "{}"}}
+        release.wait(10)
+        stream._by_index = {}
+        stream.finalize()
+        return stream
+
+    caller.release = release.set
+    return caller
+
+
+def start_params(**overrides: Any) -> Dict[str, Any]:
+    base = {"request_id": "req-1", "document_id": "paper-a", "mode": "ask", "answer_style": "grounded",
+            "context": CONTEXT, "prompt": "这篇论文的主要发现是什么？用两三句回答。",
+            "document_context": {"document_id": "paper-a", "content_revision": 1}}
+    base.update(overrides)
+    return base
+
