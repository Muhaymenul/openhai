+class ClosingWriter:
+    def is_closing(self) -> bool:
+        return False
+
+    def close(self) -> None:
+        return None
+
+    def write(self, data: bytes) -> None:
+        return None
+
+    async def drain(self) -> None:
+        return None
+
+
+class Frames:
+    def __init__(self, client: socket.socket) -> None:
+        self.client, self.buffer, self.events = client, b"", []
+
+    def send(self, payload: Dict[str, Any]) -> None:
+        self.client.sendall((json.dumps(payload, ensure_ascii=False) + "\n").encode("utf-8"))
+
+    def read(self, timeout: float = 20.0) -> Dict[str, Any]:
+        self.client.settimeout(timeout)
+        while b"\n" not in self.buffer:
+            chunk = self.client.recv(65536)
+            if not chunk:
+                raise AssertionError("service closed the connection")
+            self.buffer += chunk
+        line, _, self.buffer = self.buffer.partition(b"\n")
+        return json.loads(line.decode("utf-8"))
+
+    def expect(self, request_id: str) -> Dict[str, Any]:
+        for _ in range(400):
+            frame = self.read()
+            if frame.get("event"):
+                self.events.append(frame["data"])
+                continue
+            if frame.get("id") == request_id:
+                return frame
+        raise AssertionError("no response for %s" % request_id)
+
+    def poll(self) -> Dict[str, Any] | None:
+        try:
+            frame = self.read(timeout=0.5)
+        except (socket.timeout, OSError):
+            return None
+        if frame.get("event"):
+            self.events.append(frame["data"])
+        return frame
+
+    def request(self, request_id: str, method: str, params: Dict[str, Any]) -> Dict[str, Any]:
+        self.send({"id": request_id, "method": method, "params": params})
+        return self.expect(request_id)
