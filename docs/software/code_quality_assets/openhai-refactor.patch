;\r\n  const operation = useRef<string | null>(null);\r\n  const [refreshVersion, setRefreshVersion] = useState(0);\r\n  useEffect(() => {\r\n    if (!opened) return;\r\n    let stopped = false;\r\n    const controller = new AbortController();\r\n    const refresh = async () => {\r\n      try {\r\n        const response = await fetch(endpoint, {\r\n          cache: \"no-store\",\r\n          signal: controller.signal,\r\n        });\r\n        if (!response.ok)\r\n          throw new Error(\r\n            \"Exercises could not sync. Check collaboration access and local changes.\",\r\n          );\r\n        const data = (await response.json()) as { records: ExerciseRecord[] };\r\n        if (!stopped) {\r\n          setRecords(data.records);\r\n          setError(null);\r\n        }\r\n      } catch (error) {\r\n        if (!stopped)\r\n          setError(\r\n            error instanceof Error\r\n              ? error.message\r\n              : \"Exercises could not be loaded.\",\r\n          );\r\n      }\r\n    };\r\n    void refresh();\r\n    const interval = window.setInterval(() => void refresh(), 30_000);\r\n    return () => {\r\n      stopped = true;\r\n      controller.abort();\r\n      window.clearInterval(interval);\r\n    };\r\n  }, [endpoint, opened, refreshVersion]);\r\n  const save = async () => {\r\n    if (saving || !markdown.trim()) return;\r\n    setSaving(true);\r\n    setError(null);\r\n    try {\r\n      operation.current ??= Array.from(\r\n        crypto.getRandomValues(new Uint8Array(16)),\r\n        (value) => value.toString(16).padStart(2, \"0\"),\r\n      ).join(\"\");\r\n      const response = await fetch(endpoint, {\r\n        method: \"POST\",\r\n        headers: { \"content-type\": \"application/json\" },\r\n        body: JSON.stringify({ markdown, operationId: operation.current }),\r\n      });\r\n      const payload = (await response.json()) as { error?: string };\r\n      if (!response.ok)\r\n        throw new Error(\r\n          pay