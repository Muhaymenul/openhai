) === year &&\r\n      candidate.getUTCMonth() === month - 1 &&\r\n      candidate.getUTCDate() === date\r\n    )\r\n      day = candidate;\r\n  } else if (/后天/.test(text)) day = new Date(today + 2 * 86400000);\r\n  else if (/明天/.test(text)) day = new Date(today + 86400000);\r\n  else if (/今天/.test(text)) day = new Date(today);\r\n  else {\r\n    const week = /(下周|本周|这周|周|星期)([一二三四五六日天])/.exec(text);\r\n    if (week) {\r\n      const weekday = \"日一二三四五六\".indexOf(\r\n        week[2] === \"天\" ? \"日\" : week[2],\r\n      );\r\n      const current = new Date(today).getUTCDay();\r\n      let delta = (weekday - current + 7) % 7;\r\n      if (week[1] === \"下周\")\r\n        delta = ((weekday + 6) % 7) - ((current + 6) % 7) + 7;\r\n      if (week[1] === \"本周\" || week[1] === \"这周\")\r\n        delta = ((weekday + 6) % 7) - ((current + 6) % 7);\r\n      day = new Date(today + delta * 86400000);\r\n    }\r\n  }\r\n  const time =\r\n    /(上午|下午|晚上|中午|早上)?\\s*(\\d{1,2})(?::(\\d{2})(?!\\d)|[点时](半|\\d{1,2}分?)?)/.exec(\r\n      normalized,\r\n    );\r\n  let hour = time ? Number(time[2]) : 17;\r\n  let minute = time?.[3]\r\n    ? Number(time[3])\r\n    : time?.[4] === \"半\"\r\n      ? 30\r\n      : Number(time?.[4]?.replace(\"分\", \"\") || 0);\r\n  if (time?.[1] && /下午|晚上|中午/.test(time[1]) && hour < 12) hour += 12;\r\n  if (time?.[1] && /上午|早上/.test(time[1]) && hour === 12) hour = 0;\r\n  const unsupportedTime =\r\n    !time && /(上午|下午|晚上|中午|早上|\\d[点时]|\\d:\\d)/.test(normalized);\r\n  const leftoverTime =\r\n    time &&\r\n    /^(?:[零一二两三四五六七八九十\\d]|半|刻)/.test(\r\n      normalized.slice(time.index + time[0].length),\r\n    );\r\n  if (hour > 23 || minute > 59 || unsupportedTime || leftoverTime) {\r\n    day = undefined;\r\n    hour = 17;\r\n    minute = 0;\r\n  }\r\n  const datePart = day?.toISOString().slice(0, 10);\r\n  const dueLocal = datePart\r\n    ? `${datePart}T${String(hour).padStart(2, \"0\")}:${String(minute).padStart(2, \"0\")}`\r\n    : \"\";\r\n  const title = normalized\r\n    .replace(/(\\d{4})[-年/](\\d{1,2})[-月/](\\d{1,2})日?/, \"\")\r\n    .replace(/今天|明天|后天|(下周|本周|这周|周|星期)[一二三四五六日天]/, \"\")\r\n    .replace(\r\n      /(上午|下午|晚上|中午|早上)?\\s*\\d{1,2}(?::\\d{2}|[点时](?:半|\\d{1,2}分?)?)/,\r\n      \"\",\r\n    )\r\n    .replace(/之前|以前|截止|到期|请提醒我|提醒我|我要|我需要/g, \"\")\r\n    .replace(/^[，,\\s]+|[，,\\s]+$/g, \"\");\r\n  return {\r\n    title: title || text.trim(),\r\n    dueLocal,\r\n    priority: /紧急|重要|优先/.test(text)\r\n      ? (\"high\" as const)\r\n      : (\"normal\" as const),\r\n  };\r\n}\r\n\r\nexport function shanghaiInput(iso: string): string {\r\n  return new Date(new Date(iso).getTime() + 8 * 3600000)\r\n    .toISOString()\r\n    .slice(0, 16);\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\lib\\research\\planner\\types.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\lib\\research\\review\\api.ts","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Async function 'handleReviewRequest' has too many lines (51). Maximum allowed is 50.","line":22,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":72,"endColumn":2},{"ruleId":"complexity","severity":1,"message":"Async function 'handleReviewRequest' has a complexity of 21. Maximum allowed is 10.","line":22,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":22,"endColumn":42}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { z } from \"zod\";\r\nimport { idSchema } from \"../schemas\";\r\nimport { ResearchError } from \"../store\";\r\nimport {\r\n  createReviewDeck,\r\n  getReviewDeck,\r\n  listReviewDecks,\r\n  saveReviewAttempt,\r\n  saveReviewResponse,\r\n  saveReviewSession,\r\n  updateReviewQuestion,\r\n} from \"./core\";\r\nimport {\r\n  reviewAttemptSchema,\r\n  reviewCreateSchema,\r\n  reviewQuestionSchema,\r\n  reviewResponseSchema,\r\n  reviewSessionSchema,\r\n} from \"./schemas\";\r\n\r\n/** Called only after the research API's local-host and mutation origin guard. */\r\nexport async function handleReviewRequest(\r\n  request: Request,\r\n  segments: string[],\r\n): Promise<Response> {\r\n  const json = (value: unknown, status = 200) =>\r\n    Response.json(value, {\r\n      status,\r\n      headers: { \"cache-control\": \"no-store\" },\r\n    });\r\n  const [id, action] = segments;\r\n  if (segments.length > 2) throw new ResearchError(\"复习操作不存在\", 404);\r\n  if (id) idSchema.parse(id);\r\n  const url = new URL(request.url);\r\n  if (request.method === \"GET\") {\r\n    if (id && !action) return json({ deck: getReviewDeck(id) });\r\n    if (!id) {\r\n      const filter = z\r\n        .object({ paperId: idSchema.optional(), noteId: idSchema.optional() })\r\n        .parse({\r\n          paperId: url.searchParams.get(\"paperId\") || undefined,\r\n          noteId: url.searchParams.get(\"noteId\") || undefined,\r\n        });\r\n      return json({ decks: listReviewDecks(filter.paperId, filter.noteId) });\r\n    }\r\n  }\r\n  if (Number(request.headers.get(\"content-length\") || 0) > 2 * 1024 * 1024)\r\n    throw new ResearchError(\"题组内容过长\", 413);\r\n  let input: unknown;\r\n  try {\r\n    input = await request.json();\r\n  } catch {\r\n    throw new ResearchError(\"请求必须包含有效 JSON\");\r\n  }\r\n  if (request.method === \"POST\" && !id) {\r\n    const deck = await createReviewDeck(reviewCreateSchema.parse(input));\r\n    return json({ deck: getReviewDeck(deck.id) }, 201);\r\n  }\r\n  if (request.method === \"PATCH\" && id && action) {\r\n    if (action === \"attempt\")\r\n      await saveReviewAttempt(id, reviewAttemptSchema.parse(input));\r\n    else if (action === \"response\")\r\n      await saveReviewResponse(id, reviewResponseSchema.parse(input));\r\n    else if (action === \"session\")\r\n      await saveReviewSession(id, reviewSessionSchema.parse(input));\r\n    else if (action === \"question\")\r\n      await updateReviewQuestion(id, reviewQuestionSchema.parse(input));\r\n    else throw new ResearchError(\"复习操作不存在\", 404);\r\n    return json({ deck: getReviewDeck(id) });\r\n  }\r\n  throw new ResearchError(\"复习操作不存在或不支持此方法\", 404);\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\lib\\research\\review\\core.ts","messages":[{"ruleId":"complexity","severity":1,"message":"Function 'checkedSources' has a complexity of 13. Maximum allowed is 10.","line":88,"column":1,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":88,"endColumn":24},{"ruleId":"max-lines-per-function","severity":1,"message":"Async function 'createReviewDeck' has too many lines (129). Maximum allowed is 50.","line":138,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":267,"endColumn":2},{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (119). Maximum allowed is 50.","line":148,"column":26,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":266,"endColumn":4},{"ruleId":"complexity","severity":1,"message":"Arrow function has a complexity of 39. Maximum allowed is 10.","line":148,"column":34,"nodeType":"ArrowFunctionExpression","messageId":"complex","endLine":148,"endColumn":36},{"ruleId":"complexity","severity":1,"message":"Arrow function has a complexity of 13. Maximum allowed is 10.","line":364,"column":34,"nodeType":"ArrowFunctionExpression","messageId":"complex","endLine":364,"endColumn":36}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { randomUUID } from \"node:crypto\";\r\nimport type { z } from \"zod\";\r\nimport { recordedRunPaperIds } from \"../context-scope\";\r\nimport { getResearchHistory } from \"../paperflow-client\";\r\nimport {\r\n