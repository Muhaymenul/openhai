ource({\r\n                      kind: \"annotations\",\r\n                      ids: event.target.checked\r\n                        ? [...selected, annotation.id]\r\n                        : selected.filter((id) => id !== annotation.id),\r\n                      versions: Object.fromEntries(\r\n                        annotations.map((entry) => [entry.id, entry.version]),\r\n                      ),\r\n                    })\r\n                  }\r\n                />\r\n                <span>\r\n                  第{annotation.page}页 ·{\" \"}\r\n                  {(\r\n                    annotation.quote ||\r\n                    annotation.comment ||\r\n                    annotation.text\r\n                  ).slice(0, 110)}\r\n                </span>\r\n              </label>\r\n            ))}\r\n          </fieldset>\r\n        )}\r\n        {initial.task === \"quiz\" && (\r\n          <label className={styles.formLabel}>\r\n            题目数量\r\n            <select\r\n              aria-label=\"自测题目数量\"\r\n              value={count}\r\n              onChange={(event) =>\r\n                setCount(Number(event.target.value) as 3 | 5 | 8)\r\n              }\r\n              disabled={busy}\r\n            >\r\n              <option value={3}>3题</option>\r\n              <option value={5}>5题</option>\r\n              <option value={8}>8题</option>\r\n            </select>\r\n          </label>\r\n        )}\r\n        <p className={local.hint}>\r\n          {initial.task === \"notes\"\r\n            ? \"生成后先编辑、核对来源，再保存笔记。\"\r\n            : \"生成后点击“开始逐题复习”，作答和进度保存在本机。\"}\r\n        </p>\r\n      </div>\r\n      <div className={styles.modalFooter}>\r\n        <button\r\n          className={styles.secondaryButton}\r\n          disabled={busy}\r\n          onClick={onClose}\r\n        >\r\n          取消\r\n        </button>\r\n        <button\r\n          className={styles.primaryButton}\r\n          disabled={busy || !valid}\r\n          onClick={() => void generate()}\r\n        >\r\n          {busy\r\n            ? \"正在提交…\"\r\n            : initial.task === \"notes\"\r\n              ? \"生成笔记草稿\"\r\n              : \"生成自测题\"}\r\n        </button>\r\n      </div>\r\n    </Modal>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\learning\\NoteDraftFeedback.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'NoteDraftFeedback' has too many lines (53). Maximum allowed is 50.","line":61,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":113,"endColumn":2},{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'NoteDraftShelf' has too many lines (70). Maximum allowed is 50.","line":114,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":183,"endColumn":2}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\r\n\r\nimport type { ResearchNote, ResearchPaper } from \"@/lib/research/types\";\r\nimport { useEffect, useRef, useState } from \"react\";\r\nimport { localNoteKey, type LocalNoteDraft } from \"./note-drafts\";\r\nimport type { NoteEditorController } from \"./use-note-editor\";\r\nimport styles from \"./learning.module.css\";\r\n\r\nexport function NoteLeaveConfirm({\r\n  onContinue,\r\n  onCancel,\r\n  disabled = false,\r\n}: {\r\n  onContinue(): void;\r\n  onCancel(): void;\r\n  disabled?: boolean;\r\n}) {\r\n  const cancel = useRef<HTMLButtonElement>(null);\r\n  useEffect(() => {\r\n    cancel.current?.focus();\r\n    cancel.current?.scrollIntoView({ block: \"nearest\" });\r\n  }, []);\r\n  return (\r\n    <div className={styles.draftWarning} role=\"alert\">\r\n      <p>当前修改尚未安全暂存，离开可能丢失。</p>\r\n      <button ref={cancel} onClick={onCancel} disabled={disabled}>\r\n        继续编辑\r\n      </button>\r\n      <button onClick={onContinue} disabled={disabled}>\r\n        继续离开\r\n      </button>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport function NoteDraftStatus({ editor }: { editor: NoteEditorController }) {\r\n  const label = editor.busy\r\n    ? \"正在保存…\"\r\n    : !editor.ready\r\n      ? \"正在读取…\"\r\n      : !editor.unsaved\r\n        ? editor.model.id\r\n          ? \"已保存\"\r\n          : \"未保存\"\r\n        : editor.status === \"local\"\r\n          ? \"本机草稿\"\r\n          : \"未保存\";\r\n  return (\r\n    <span\r\n      role=\"status\"\r\n      title={\r\n        editor.unsaved && editor.status === \"local\"\r\n          ? \"仅暂存于当前浏览器，尚未保存到工作区\"\r\n          : undefined\r\n      }\r\n    >\r\n      {label}\r\n    </span>\r\n  );\r\n}\r\nexport function NoteDraftFeedback({\r\n  editor,\r\n  onSaveCopy,\r\n}: {\r\n  editor: NoteEditorController;\r\n  onSaveCopy(): void;\r\n}) {\r\n  return (\r\n    <>\r\n      {editor.restored && (\r\n        <p className={styles.draftHint}>已恢复本机草稿，尚未保存到工作区。</p>\r\n      )}\r\n      {editor.status === \"unavailable\" && (\r\n        <p className={styles.draftWarning} role=\"status\">\r\n          浏览器无法暂存，未提交的修改需手动保存。\r\n        </p>\r\n      )}\r\n      {editor.status === \"conflict\" && (\r\n        <div className={styles.draftWarning} role=\"alert\">\r\n          <span>本机草稿已在另一窗口改变，当前文字仍在本页。</span>\r\n          <button onClick={() => editor.localCopy()} disabled={editor.busy}>\r\n            另存本机草稿\r\n          </button>\r\n        </div>\r\n      )}\r\n      {editor.server && (\r\n        <div className={styles.draftWarning} role=\"alert\">\r\n          <p>笔记已有新版本。当前文字仍在编辑器，未覆盖工作区内容。</p>\r\n          <details>\r\n            <summary>查看当前版本</summary>\r\n            <strong>{editor.server.title}</strong>\r\n            <pre>{editor.server.body}</pre>\r\n          </details>\r\n          <button\r\n            onClick={() => void editor.useCurrentVersion()}\r\n            disabled={editor.busy}\r\n          >\r\n            保留草稿并打开新版本\r\n          </button>\r\n          <button onClick={onSaveCopy} disabled={editor.busy}>\r\n            将草稿另存为新笔记\r\n          </button>\r\n        </div>\r\n      )}\r\n      {editor.error && (\r\n        <p className={styles.error} role=\"alert\">\r\n          {editor.error}\r\n          {editor.blocked && <button onClick={editor.retry}>重新读取</button>}\r\n        </p>\r\n      )}\r\n    </>\r\n  );\r\n}\r\nexport function NoteDraftShelf({\r\n  editor,\r\n  papers,\r\n  notes,\r\n  onRecover,\r\n}: {\r\n  editor: NoteEditorController;\r\n  papers: ResearchPaper[];\r\n  notes: ResearchNote[];\r\n  onRecover(entry: LocalNoteDraft): void;\r\n}) {\r\n  const [discarding, setDiscarding] = useState<string | null>(null);\r\n  const paperIds = new Set(papers.map((paper) => paper.id));\r\n  const noteIds = new Set(notes.map((note) => note.id));\r\n  const drafts = editor.drafts.filter(\r\n    (entry) =>\r\n      entry.key !== localNoteKey(editor.model) &&\r\n      (!entry.model.paperId || paperIds.has(entry.model.paperId)) &&\r\n      (!entry.model.id || noteIds.has(entry.model.id)) &&\r\n      entry.model.sources.every(\r\n        (source) => !source.paperId || paperIds.has(source.paperId),\r\n      ),\r\n  );\r\n  if (!drafts.length) return null;\r\n  return (\r\n    <details className={styles.draftShelf}>\r\n      <summary>\r\n        本机草稿 <span>{drafts.length}</span>\r\n      </summary>\r\n      <ul>\r\n        {drafts.map((entry) => (\r\n          <li key={entry.key}>\r\n            <div>\r\n              <strong>{entry.model.title || \"未命名笔记\"}</strong>\r\n              <span>\r\n                {\r\n                  papers.find((paper) => paper.id === entry.model.paperId)\r\n                    ?.title\r\n                }\r\n              </span>\r\n            </div>\r\n            <button disabled={editor.busy} onClick={() => onRecover(entry)}>\r\n              恢复\r\n            </button>\r\n            <button\r\n              disabled={editor.busy}\r\n              onClick={() => setDiscarding(entry.key)}\r\n            >\r\n              丢弃\r\n            </button>\r\n            {discarding === entry.key && (\r\n              <div className={styles.draftWarning} role=\"alert\">\r\n                <span>丢弃这份本机草稿？已保存的笔记不受影响。</span>\r\n                <button onClick={() => setDiscarding(null)}>保留</button>\r\n                <button\r\n                  onClick={() => {\r\n                    editor.discard(entry);\r\n                    setDiscarding(null);\r\n                  }}\r\n                >\r\n                  丢弃草稿\r\n                </button>\r\n              </div>\r\n            )}\r\n          </li>\r\n        ))}\r\n      </ul>\r\n    </details>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\learning\\NoteEditor.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'NoteEditor' has too many lines (168). Maximum allowed is 50.","line":33,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":200,"endColumn":2},{"ruleId":"complexity","severity":1,"message":"Function 'NoteEditor' has a complexity of 17. Maximum allowed is 10.","line":33,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":33,"endColumn":27}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\r\n\r\nimport type {\r\n  ResearchNote,\r\n  ResearchPaper,\r\n  SourceRef,\r\n} from \"@/lib/research/types\";\r\nimport { Check, Eye, FilePenLine } from \"lucide-react\";\r\nimport { useEffect, useState } from \"react\";\r\nimport { Modal, SourceChips } from \"../ResearchUi\";\r\nimport { StudyMarkdown } from \"../study/StudyMarkdown\";\r\nimport styles from \"../styles\";\r\nimport learningStyles from \"./learning.module.css\";\r\nimport { generatedNoteOrigin } from \"./note-drafts\";\r\nimport {\r\n  NoteDraftFeedback,\r\n  NoteDraftStatus,\r\n  NoteLeaveConfirm,\r\n} from \"./NoteDraftFeedback\";\r\nimport { useNoteEditor } from \"./use-note-editor\";\r\n\r\nexport interface NoteDraft {\r\n  id?: string;\r\n  version?: number;\r\n  title: string;\r\n  body: string;\r\n  sources: SourceRef[];\r\n  runId?: string;\r\n  origin?: string;\r\n  kind?: ResearchNote[\"kind\"];\r\n  confirmed?: boolean;\r\n}\r\nexport function NoteEditor({\r\n  paper,\r\n  draft,\r\n  onClose,\r\n  onSaved,\r\n  onOpenSource,\r\n  notify,\r\n  beforeSave,\r\n}: {\r\n  paper: ResearchPaper;\r\n  draft: NoteDraft;\r\n  onClose(): void;\r\n  onSaved(note: ResearchNote): Promise<void>;\r\n  onOpenSource(source: SourceRef): void;\r\n  notify(message: string, error?: boolean): void;\r\n  beforeSave?(): Promise<boolean>;\r\n}) {\r\n  const editor = useNoteEditor({\r\n    ...draft,\r\n    paperId: paper.id,\r\n    kind: draft.kind ?? \"reading\",\r\n    confirmed: draft.confirmed ?? false,\r\n    origin: generatedNoteOrigin(draft, draft.origin),\r\n  });\r\n  const [preview, setPreview] = useState(false);\r\n  const [pendingLeave, setPendingLeave] = useState<(() => void) | null>(null);\r\n  const { model, busy, unsaved } = editor;\r\n  const disabled = busy || !editor.ready || editor.blocked;\r\n  async function save(asNew = false) {\r\n    await editor.save({ asNew, beforeSave, onSaved, notify });\r\n  }\r\n  useEffect(() => {\r\n    const keydown = (event: KeyboardEvent) => {\r\n      if (\r\n        (event.ctrlKey || event.metaKey) &&\r\n        event.key.toLowerCase() === \"s\" &&\r\n        !event.altKey\r\n      ) {\r\n        event.preventDefault();\r\n        event.stopImmediatePropagation();\r\n        void editor.save({ beforeSave, onSaved, notify });\r\n      }\r\n    };\r\n    window.addEventListener(\"keydown\", keydown, true);\r\n    return () => window.removeEventListener(\"keydown\", keydown, true);\r\n  }, [editor, beforeSave, onSaved, notify]);\r\n  function close() {\r\n    if (busy) return;\r\n    if (pendingLeave && editor.protectLeave) {\r\n      setPendingLeave(null);\r\n      return;\r\n    }\r\n    requestLeave(onClose);\r\n  }\r\n  function requestLeave(action: () => void) {\r\n    if (busy) return;\r\n    if (editor.protectLeave) {\r\n      setPendingLeave(() => action);\r\n      return;\r\n    }\r\n    setPendingLeave(null);\r\n    action();\r\n  }\r\n  return (\r\n    <Modal\r\n      title={model.id ? \"编辑研究笔记\" : \"编辑阅读笔记\"}\r\n      wide\r\n      onClose={close}\r\n    >\r\n      <div className={styles.modalBody}>\r\n        <label className={styles.formLabel}>\r\n          笔记标题\r\n          <input\r\n            aria-label=\"笔记标题\"\r\n            value={model.title}\r\n            onChange={(event) => editor.change({ title: event.target.value })}\r\n            maxLength={500}\r\n            disabled={disabled}\r\n          />\r\n        </label>\r\n        <div className={learningStyles.editorTabs}>\r\n          <button\r\n            type=\"button\"\r\n            aria-pressed={!preview}\r\n            onClick={() => setPreview(false)}\r\n          >\r\n            <FilePenLine size={14} />\r\n            编辑\r\n          </button>\r\n          <button\r\n            type=\"button\"\r\n            aria-pressed={preview}\r\n            onClick={() => setPreview(true)}\r\n          >\r\n            <Eye size={14} />\r\n            预览\r\n          </button>\r\n          <NoteDraftStatus editor={editor} />\r\n        </div>\r\n        <NoteDraftFeedback editor={editor} onSaveCopy={() => void save(true)} />\r\n        {pendingLeave && editor.protectLeave && (\r\n          <NoteLeaveConfirm\r\n            disabled={busy}\r\n            onCancel={() => setPendingLeave(null)}\r\n            onContinue={() => {\r\n              if (busy) return;\r\n              setPendingLeave(null);\r\n              pendingLeave();\r\n            }}\r\n          />\r\n        )}\r\n        {preview ? (\r\n          <div className={learningStyles.notePreview}>\r\n            <StudyMarkdown content={model.body || \"暂无正文\"} />\r\n          </div>\r\n        ) : (\r\n          <textarea\r\n            aria-label=\"阅读笔记正文\"\r\n            className={learningStyles.noteBody}\r\n            rows={13}\r\n            value={model.body}\r\n            onChange={(event) => editor.change({ body: event.target.value })}\r\n            maxLength={200000}\r\n            disabled={disabled}\r\n          />\r\n        )}\r\n        {model.sources.length > 0 && (\r\n          <div className={learningStyles.sourceRow}>\r\n            <SourceChips\r\n              sources={model.sources}\r\n              onOpen={(source) => {\r\n                if (disabled) return;\r\n                requestLeave(() => {\r\n                  onClose();\r\n                  onOpenSource(source);\r\n                });\r\n              }}\r\n            />\r\n          </div>\r\n        )}\r\n      </div>\r\n      <div className={styles.modalFooter}>\r\n        <span className={learningStyles.saveShortcut}>Ctrl / ⌘ + S</span>\r\n        <button\r\n          className={styles.secondaryButton}\r\n          onClick={close}\r\n          disabled={busy}\r\n        >\r\n          关闭\r\n        </button>\r\n        <button\r\n          className={styles.primaryButton}\r\n          onClick={() => void save()}\r\n          disabled={\r\n            disabled ||\r\n            !!editor.server ||\r\n            !model.title.trim() ||\r\n            !model.body.trim() ||\r\n            !unsaved\r\n          }\r\n        >\r\n          <Check size={14} />\r\n          {busy ? \"保存中…\" : model.id ? \"保存修改\" : \"保存草稿\"}\r\n        </button>\r\n      </div>\r\n    </Modal>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\learning\\ReaderNotes.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'ReaderNotes' has too many lines (71). Maximum allowed is 50.","line":16,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":86,"endColumn":2}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\r\nimport type { ResearchNote, SourceRef } from \"@/lib/research/types\";\r\nimport {\r\n  FilePenLine,\r\n  ListChecks,\r\n  NotebookPen,\r\n  Plus,\r\n  Sparkles,\r\n} from \"lucide-react\";\r\nimport { displayDate } from \"../api\";\r\nimport { EmptyState, SourceChips } from \"../ResearchUi\";\r\nimport { StudyMarkdown } from \"../study/StudyMarkdown\";\r\nimport styles from \"../styles\";\r\nimport local from \"./learning.module.css\";\r\n\r\nexport function ReaderNotes({\r\n  notes,\r\n  active,\r\n  onCreate,\r\n  onEdit,\r\n  onOrganize,\r\n  onQuiz,\r\n  onReview,\r\n  onOpenSource,\r\n}: {\r\n  notes: ResearchNote[];\r\n  active: boolean;\r\n  onCreate(): void;\r\n  onEdit(note: ResearchNote): void;\r\n  onOrganize(): void;\r\n  onQuiz(): void;\r\n  onReview(note: ResearchNote): void;\r\n  onOpenSource(source: SourceRef): void;\r\n}) {\r\n  return (\r\n    <div className={styles.sidebarScroll}>\r\n      <div className={styles.panelIntro}>\r\n        <h3>笔记</h3>\r\n        <button className={styles.textButton} onClick={onCreate}>\r\n          <Plus size={14} />\r\n          新建\r\n        </button>\r\n      </div>\r\n      <div className={local.noteTools}>\r\n        <button disabled={active} onClick={onOrganize}>\r\n          <Sparkles size={14} />\r\n          整理重点\r\n        </button>\r\n        <button disabled={active} onClick={onQuiz}>\r\n          <ListChecks size={14} />\r\n          生成自测题\r\n        </button>\r\n      </div>\r\n      {notes.map((note) => (\r\n        <article className={styles.readerNote} key={note.id}>\r\n          <div className={styles.smallMeta}>\r\n            <span>{note.confirmed ? \"已确认\" : \"草稿\"}</span>\r\n            <span>{displayDate(note.updatedAt)}</span>\r\n          </div>\r\n          <h3>{note.title}</h3>\r\n          <div className={styles.readerNotePreview}>\r\n            <StudyMarkdown content={note.body.slice(0, 550)} />\r\n          </div>\r\n          <SourceChips sources={note.sources} onOpen={onOpenSource} />\r\n          <div className={local.noteTools}>\r\n            <button onClick={() => onEdit(note)}>\r\n              <FilePenLine size={13} />\r\n              继续编辑\r\n            </button>\r\n            <button onClick={() => onReview(note)} disabled={active}>\r\n              <ListChecks size={13} />\r\n              用这份笔记复习\r\n            </button>\r\n          </div>\r\n        </article>\r\n      ))}\r\n      {!notes.length && (\r\n        <EmptyState\r\n          icon={<NotebookPen size={22} />}\r\n          title=\"暂无笔记\"\r\n          description=\"\"\r\n        />\r\n      )}\r\n    </div>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\learning\\note-drafts.ts","messages":[{"ruleId":"complexity","severity":1,"message":"Function 'readLocalNote' has a complexity of 13. Maximum allowed is 10.","line":164,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":164,"endColumn":30}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { z } from \"zod\";\r\nimport { idSchema, sourceSchema } from \"@/lib/research/schemas\";\r\nimport type { ResearchNote, SourceRef } from \"@/lib/research/types\";\r\n\r\nexport interface EditableNote {\r\n  id?: string;\r\n  version?: number;\r\n  paperId: string;\r\n  title: string;\r\n  body: string;\r\n  kind: ResearchNote[\"kind\"];\r\n  sources: SourceRef[];\r\n  runId?: string;\r\n  confirmed: boolean;\r\n  origin: string;\r\n  slot?: string;\r\n}\r\n\r\nconst editableSchema = z\r\n  .object({\r\n    id: idSchema.optional(),\r\n    version: z.number().int().positive().optional(),\r\n    paperId: z.union([idSchema, z.literal(\"\")]),\r\n    title: z.string().max(500),\r\n    body: z.string().max(200000),\r\n    kind: z.enum([\"reading\", \"card\", \"concept\", \"reflection\", \"analysis\"]),\r\n    sources: z.array(sourceSchema).max(200),\r\n    runId: idSchema.optional(),\r\n    confirmed: z.boolean(),\r\n    origin: z.string().min(1).max(200),\r\n    slot: idSchema.optional(),\r\n  })\r\n  .refine(\r\n    (model) => !!model.id === (model.version !== undefined),\r\n    \"已有笔记需要编辑开始时的版本\",\r\n  );\r\nconst pendingSchema = z.object({\r\n  actionId: idSchema,\r\n  model: editableSchema,\r\n  confirmed: z.boolean(),\r\n});\r\nexport type PendingNoteCreate = z.infer<typeof pendingSchema>;\r\nconst draftSchema = z.object({\r\n  schema: z.literal(1),\r\n  type: z.literal(\"draft\"),\r\n  key: z.string().max(700),\r\n  token: z.string().min(1).max(100),\r\n  model: editableSchema,\r\n  pendingCreate: pendingSchema.optional(),\r\n  updatedAt: z.string().datetime(),\r\n});\r\nconst bindingSchema = z.object({\r\n  schema: z.literal(1),\r\n  type: z.literal(\"binding\"),\r\n  key: z.string().max(700),\r\n  paperId: idSchema,\r\n  noteId: idSchema,\r\n});\r\nexport type LocalNoteDraft = z.infer<typeof draftSchema>;\r\nexport type NoteDraftBinding = z.infer<typeof bindingSchema>;\r\nexport type NoteDraftEntry = LocalNoteDraft | NoteDraftBinding;\r\nexport type DraftStorage = Pick<\r\n  Storage,\r\n  \"getItem\" | \"setItem\" | \"removeItem\" | \"key\" | \"length\"\r\n>;\r\nexport const NOTE_DRAFT_PREFIX = \"jiaoyan:note-draft:v1:\";\r\nexport function needsNoteLeaveProtection(\r\n  unsaved: boolean,\r\n  status: \"local\" | \"memory\" | \"unavailable\" | \"conflict\",\r\n  busy = false,\r\n): boolean {\r\n  return busy || (unsaved && status !== \"local\");\r\n}\r\n\r\n// This is a local UI identity, never a security token. The stored model and paper\r\n// are checked again when reading a key, so identities cannot cross papers/notes.\r\nfunction fingerprint(content: string): string {\r\n  let first = 2166136261;\r\n  let second = 2246822519;\r\n  for (let index = 0; index < content.length; index++) {\r\n    first = Math.imul(first ^ content.charCodeAt(index), 16777619);\r\n    second = Math.imul(second ^ content.charCodeAt(index), 3266489917);\r\n  }\r\n  return `${(first >>> 0).toString(16)}${(second >>> 0).toString(16)}-${content.length}`;\r\n}\r\nexport function generatedNoteOrigin(\r\n  note: Pick<EditableNote, \"title\" | \"body\" | \"sources\" | \"runId\">,\r\n  explicitOrigin?: string,\r\n): string {\r\n  if (explicitOrigin) return explicitOrigin;\r\n  return note.runId\r\n    ? `run-${note.runId}`\r\n    : `source-${fingerprint(JSON.stringify([note.title, note.body, note.sources]))}`;\r\n}\r\n/** Keep excerpts separate from the full-answer binding, while reopening the same excerpt reliably. */\r\nexport function excerptNoteOrigin(runId: string, excerpt: string): string {\r\n  return `run-${runId.slice(0, 100)}-excerpt-${fingerprint(JSON.stringify([runId, excerpt]))}`;\r\n}\r\nexport function localNoteKey(\r\n  model: Pick<EditableNote, \"paperId\" | \"id\" | \"origin\" | \"slot\">,\r\n): string {\r\n  return (\r\n    NOTE_DRAFT_PREFIX +\r\n    encodeURIComponent(model.paperId) +\r\n    \":\" +\r\n    encodeURIComponent(model.id ? `note-${model.id}` : `new-${model.origin}`) +\r\n    (model.slot ? \":slot-\" + model.slot : \"\")\r\n  );\r\n}\r\nexport function noteTabSlot(\r\n  storage: Pick<Storage, \"getItem\" | \"setItem\">,\r\n): string {\r\n  const key = \"jiaoyan:note-editor-tab:v1\";\r\n  const previous = storage.getItem(key);\r\n  if (previous && idSchema.safeParse(previous).success) return previous;\r\n  const slot = crypto.randomUUID();\r\n  storage.setItem(key, slot);\r\n  return slot;\r\n}\r\nexport function editableNote(note: ResearchNote): EditableNote {\r\n  return {\r\n    id: note.id,\r\n    version: note.version,\r\n    paperId: note.paperId,\r\n    title: note.title,\r\n    body: note.body,\r\n    kind: note.kind,\r\n    sources: note.sources,\r\n    runId: note.runId,\r\n    confirmed: note.confirmed,\r\n    origin: `note-${note.id}`,\r\n  };\r\n}\r\nexport function sameNoteContent(\r\n  first: EditableNote,\r\n  second: EditableNote,\r\n): boolean {\r\n  return (\r\n    first.paperId === second.paperId &&\r\n    first.title === second.title &&\r\n    first.body === second.body &&\r\n    first.kind === second.kind &&\r\n    JSON.stringify(first.sources) === JSON.stringify(second.sources)\r\n  );\r\n}\r\nexport function hasUnsavedNote(\r\n  model: EditableNote,\r\n  baseline: EditableNote,\r\n): boolean {\r\n  return (\r\n    !sameNoteContent(model, baseline) ||\r\n    (!model.id && !!(model.title.trim() || model.body.trim()))\r\n  );\r\n}\r\nexport function noteVersionConflict(\r\n  model: EditableNote,\r\n  note: Pick<ResearchNote, \"id\" | \"paperId\" | \"version\">,\r\n): boolean {\r\n  return (\r\n    model.id === note.id &&\r\n    (model.paperId !== note.paperId || model.version !== note.version)\r\n  );\r\n}\r\nexport function readLocalNote(\r\n  storage: DraftStorage,\r\n  key: string,\r\n): NoteDraftEntry | null {\r\n  const raw = storage.getItem(key);\r\n  if (!raw) return null;\r\n  try {\r\n    const entry = z.union([draftSchema, bindingSchema]).parse(JSON.parse(raw));\r\n    if (entry.key !== key || !key.startsWith(NOTE_DRAFT_PREFIX)) return null;\r\n    if (entry.type === \"draft\" && localNoteKey(entry.model) !== key)\r\n      return null;\r\n    if (\r\n      entry.type === \"binding\" &&\r\n      !key.startsWith(\r\n        NOTE_DRAFT_PREFIX + encodeURIComponent(entry.paperId) + \":new-\",\r\n      )\r\n    )\r\n      return null;\r\n    if (\r\n      entry.type === \"draft\" &&\r\n      entry.pendingCreate &&\r\n      (entry.model.id ||\r\n        entry.pendingCreate.model.paperId !== entry.model.paperId)\r\n    )\r\n      return null;\r\n    return entry;\r\n  } catch {\r\n    return null;\r\n  }\r\n}\r\nexport function listLocalNotes(storage: DraftStorage): LocalNoteDraft[] {\r\n  const drafts: LocalNoteDraft[] = [];\r\n  for (let index = 0; index < sto