+import fs from "node:fs";
+import path from "node:path";
+import { z } from "zod";
+import { pdfCommentActionSchema } from "../library/pdf/comments";
+import {
+  activeWorkspace,
+  createNote,
+  ensureResearchIndex,
+  expectedVersion,
+  exportMarkdown,
+  importPaper,
+  mutateWorkspace,
+  paperById,
+  paperPages,
+  readWorkspace,
+  recoverResearchImports,
+  researchContext,
+  ResearchError,
+  saveKnowledge,
+  searchResearch,
+  updateNote,
+  updatePaper,
+} from "./store";
+import {
+  annotationMutationSchema,
+  annotationSchema,
+  graphActionSchema,
+  idSchema,
+  knowledgeSchema,
+  knowledgePatchSchema,
+  notePatchSchema,
+  noteSchema,
+  paperPatchSchema,
+  paperLifecycleSchema,
+  runSchema,
+  settingsSchema,
+} from "./schemas";
+import {
+  createAnnotation,
+  parsePdf,
+  recoverAnnotations,
+  researchPdfResponse,
+  saveNativeComment,
+  saveResearchPdf,
+} from "./pdf";
+import { mutateAnnotation } from "./annotation-mutations";
+import { readResearchComments } from "./comment-view";
+import {
+  addManualGraphEdge,
+  applyGraphRun,
+  decideGraphEdge,
+  getResearchGraph,
+  suggestGraph,
+} from "./graph";
+import { createResearchBackup } from "./backup";
+import { researchCoverResponse } from "./cover";
+import { prepareLearningInput } from "./learning-input";
+import { prepareQuestionInput } from "./discussion/input";
+import { effectiveAnswerStyle } from "./discussion/context";
+import { handleReviewRequest } from "./review/api";
+import {
+  cancelResearchRun,
+  configureResearchProvider,
+  getResearchHealth,
+  getResearchHistory,
+  getResearchRun,
+  startResearchRun,
+  respondResearchPermission,
+} from "./paperflow-client";
+import {
+  listTrashedPapers,
+  restoreResearchPaper,
+  trashResearchPaper,
+  withPaperLifecycle,
+} from "./paper-lifecycle";
+import {
+  body,
+  json,
+  versionFromRequest,
+  visibleRun,
+  type ResearchRequestContext,
+} from "./api-http";
+
+async function handleReview(ctx: ResearchRequestContext) {
+  return handleReviewRequest(ctx.request, ctx.segments.slice(1));
+}
+
+async function handleWorkspace() {
+  await withPaperLifecycle(async () => {
+    await recoverResearchImports();
+    await recoverAnnotations();
+  });
+  const indexReady = ensureResearchIndex();
+  const state = activeWorkspace();
+  const graph = await getResearchGraph();
+  const paperIds = new Set(state.papers.map((paper) => paper.id));
+  const history = (await getResearchHistory(undefined, false)).filter((run) =>
+    visibleRun(run, paperIds),
+  );
+  return json({
+    papers: state.papers,
+    notes: state.notes,
+    knowledge: state.knowledge,
+    annotations: state.annotations,
+    graph,
+    history,
+    settings: state.settings,
+    indexReady,
+  });
+}
+
+async function handleHealth() {
+  return json({ health: await getResearchHealth() });
+}
+
+function handleTrash() {
+  return json({ papers: listTrashedPapers() });
+}
+
+async function handleExamplesImport() {
+  const dir = path.resolve(
+    process.env.RESEARCH_EXAMPLES_DIR ||
+      path.join(process.cwd(), "..", "examples"),
+  );
+  if (!fs.existsSync(dir))
+    throw new ResearchError("样例目录尚未准备，请上传自己的PDF", 404);
+  const files = fs
+    .readdirSync(dir)
+    .filter((name) => name.toLowerCase().endsWith(".pdf"))
+    .slice(0, 10);
+  const papers = [];
+  for (const filename of files) {
+    const full = path.join(dir, filename);
+    if (!fs.lstatSync(full).isFile()) continue;
+    const bytes = new Uint8Array(fs.readFileSync(full));
+    const parsed = await parsePdf(bytes);
+    papers.push(
+      await importPaper({
+        bytes,
+        filename,
+        topic: "教育研究样例",
+        ...parsed,
+      }),
+    );
+  }
+  return json({ papers }, 201);
+}
+
+async function handlePaperCollection(ctx: ResearchRequestContext) {
+  if (ctx.method === "GET") return json({ papers: activeWorkspace().papers });
+  if (ctx.method === "POST") {
+    const form = await ctx.request.formData();
+    const parsed = z
+      .object({
+        file: z
+          .instanceof(File)
+          .refine(
+            (f) => f.size > 0 && f.size <= 100 * 1024 * 1024,
+            "PDF大小应在1字节至100MB之间",
+          ),
+        title: z.string().trim().max(500).optional(),
+        topic: z.string().trim().max(500).optional(),
+        tags: z.string().max(3000).optional(),
+      })
+      .parse({
+        file: form.get("file"),
+        title: form.get("title") || undefined,
+        topic: form.get("topic") || undefined,
+        tags: form.get("tags") || undefined,
+      });
+    const bytes = new Uint8Array(await parsed.file.arrayBuffer());
+    const extracted = await parsePdf(bytes);
+    const paper = await importPaper({
+      bytes,
+      filename: parsed.file.name,
+      topic: parsed.topic,
+      tags: parsed.tags
+        ?.split(/[,，]/)
+        .map((s) => s.trim())
+        .filter(Boolean),
+      ...extracted,
+      title: parsed.title || extracted.title,
+    });
+    return json({ paper }, 201, { etag: `"${paper.version}"` });
+  }
+  throw notFound();
+}
+
+async function paperLifecycleResponse(
+  request: Request,
+  id: string,
+  detail: string | undefined,
+  method: string,
+): Promise<Response | undefined> {
+  const isLifecycle =
+    (!detail && method === "DELETE") ||
+    (detail === "restore" && method === "POST");
+  if (!isLifecycle) return undefined;
+  const input = paperLifecycleSchema.parse(await body(request));
+  const version = versionFromRequest(request, input.version);
+  const updated =
+    detail === "restore"
+      ? await restoreResearchPaper(id, version)
+      : await trashResearchPaper(id, version);
+  return json({ paper: updated }, 200, { etag: `"${updated.version}"` });
+}
+
+async function paperMediaResponse(
+  request: Request,
+  id: string,
+  detail: string | undefined,
+  method: string,
+): Promise<Response | undefined> {
+  if (detail === "cover" && (method === "GET" || method === "HEAD"))
+    return await researchCoverResponse(request, id);
+  if (detail === "pdf") {
+    if (method === "GET" || method === "HEAD")
+      return researchPdfResponse(request, id);
+    if (method === "PUT") {
+      const saved = await withPaperLifecycle(() =>
+        saveResearchPdf(request, id),
+      );
+      return json(saved, 200, { etag: saved.etag });
+    }
+  }
+  return paperCommentResponse(request, id, detail, method);
+}
+
+async function paperCommentResponse(
+  request: Request,
+  id: string,
+  detail: string | undefined,
+  method: string,
+): Promise<Response | undefined> {
+  if (detail === "comments" && method === "GET") {
+    const comments = await readResearchComments(id);
+    return json(comments, 200, { etag: comments.etag });
+  }
+  if (detail === "comments" && method === "POST") {
+    const action = pdfCommentActionSchema.parse(await body(request));
+    const expected = z
+      .string()
+      .regex(/^"[a-f0-9]{64}"$/)
+      .parse(request.headers.get("if-match"));
+    const saved = await withPaperLifecycle(() =>
+      saveNativeComment(id, action, expected),
+    );
+    return json(saved, 200, { etag: saved.etag });
+  }
+  return undefined;
+}
+
+async function paperRecordResponse(
+  request: Request,
+  id: string,
+  detail: string | undefined,
+  method: string,
+  paper: ReturnType<typeof paperById>,
+): Promise<Response> {
+  if (detail === "text" && method === "GET")
+    return json({
+      pages: paperPages(paper),
+      status: paper.textStatus,
+      warning: paper.textWarning,
+    });
+  if (detail === "annotations" && method === "GET")
+    return json({
+      annotations: activeWorkspace().annotations.filter(
+        (a) => a.paperId === id,
+      ),
+    });
+  if (!detail && method === "GET") {
+    const state = activeWorkspace();
+    return json(
+      {
+        paper,
+        pages: paperPages(paper),
+        notes: state.notes.filter((n) => n.paperId === id),
+        annotations: state.annotations.filter((a) => a.paperId === id),
+      },
+      200,
+      { etag: `"${paper.version}"` },
+    );
+  }
+  if (!detail && method === "PATCH") {
+    const input = paperPatchSchema.parse(await body(request));
+    const updated = await updatePaper(id, {
+      ...input,
+      version: versionFromRequest(request, input.version),
+    });
+    return json({ paper: updated }, 200, { etag: `"${updated.version}"` });
+  }
+  throw notFound();
+}
+
+async function handlePaperItem(ctx: ResearchRequestContext) {
+  const { request, id, detail, method } = ctx;
+  if (!id) throw notFound();
+  idSchema.parse(id);
+  const lifecycle = await paperLifecycleResponse(request, id, detail, method);
+  if (lifecycle) return lifecycle;
+  const paper = paperById(id);
+  const media = await paperMediaResponse(request, id, detail, method);
+  if (media) return media;
+  return paperRecordResponse(request, id, detail, method, paper);
+}
+
+async function handleNoteItem(
+  request: Request,
+  id: string,
+  detail: string | undefined,
+  method: string,
+): Promise<Response> {
+  idSchema.parse(id);
+  const state = readWorkspace();
+  const note = state.notes.find((n) => n.id === id);
+  if (!note) throw new ResearchError("笔记不存在", 404);
+  paperById(note.paperId, state);
+  if (detail === "history" && method === "GET")
+    return json({ versions: state.noteHistory[id] || [] });
+  if (method === "GET")
+    return json({ note }, 200, { etag: `"${note.version}"` });
+  if (method === "PATCH") {
+    const input = notePatchSchema.parse(await body(request));
+    const updated = await updateNote(id, {
+      ...input,
+      version: versionFromRequest(request, input.version),
+    });
+    return json({ note: updated }, 200, { etag: `"${updated.version}"` });
+  }
+  throw notFound();
+}
+
+async function handleNotes(ctx: ResearchRequestContext) {
+  const { request, url, id, detail, method } = ctx;
+  if (!id && method === "GET") {
+    const paperId = z
+      .string()
+      .optional()
+      .parse(url.searchParams.get("paperId") || undefined);
+    return json({
+      notes: activeWorkspace().notes.filter(
+        (n) => !paperId || n.paperId === paperId,
+      ),
+    });
+  }
+  if (!id && method === "POST")
+    return json(
+      { note: await createNote(noteSchema.parse(await body(request))) },
+      201,
+    );
+  if (id) return handleNoteItem(request, id, detail, method);
+  throw notFound();
+}
+
+async function handleAnnotations(ctx: ResearchRequestContext) {
+  const { request, id, method } = ctx;
+  if (id && ["PATCH", "DELETE"].includes(method)) {
+    idSchema.parse(id);
+    const input = annotationMutationSchema.parse(await body(request));
+    return json(
+      await withPaperLifecycle(() =>
+        mutateAnnotation(id, input, method === "DELETE"),
+      ),
+    );
+  }
+  if (!id && method === "POST") {
+    const input = annotationSchema.parse(await body(request));
+    return json(await withPaperLifecycle(() => createAnnotation(input)), 201);
+  }
+  if (method === "GET")
+    return json({ annotations: activeWorkspace().annotations });
+  throw notFound();
+}
+
+async function handleKnowledgeItem(
+  request: Request,
+  id: string,
+  method: string,
+): Promise<Response> {
+  if (method === "GET") {
+    const entry = activeWorkspace().knowledge.find((k) => k.id === id);
+    if (!entry) throw new ResearchError("概念不存在", 404);
+    return json({ entry });
+  }
+  if (method === "PATCH") {
+    idSchema.parse(id);
+    const input = knowledgePatchSchema.parse(await body(request));
+    const existing = readWorkspace().knowledge.find((k) => k.id === id);
+    if (!existing) throw new ResearchError("概念不存在", 404);
+    return json({
+      entry: await saveKnowledge(
+        {
+          ...input,
+          title: input.title ?? existing.title,
+          version: versionFromRequest(request, input.version),
+        },
+        id,
+      ),
+    });
+  }
+  throw notFound();
+}
+
+async function handleKnowledge(ctx: ResearchRequestContext) {
+  const { request, id, method } = ctx;
+  if (!id && method === "GET")
+    return json({ knowledge: activeWorkspace().knowledge });
+  if (!id && method === "POST")
+    return json(
+      {
+        entry: await saveKnowledge(knowledgeSchema.parse(await body(request))),
+      },
+      201,
+    );
+  if (id) return handleKnowledgeItem(request, id, method);
+  throw notFound();
+}
+
+function handleSearch(ctx: ResearchRequestContext) {
+  const query = z
+    .object({
+      q: z.string().max(500).default(""),
+      scope: z.enum(["all", "education", "personal"]).default("all"),
+    })
+    .parse({
+      q: ctx.url.searchParams.get("q") || "",
+      scope: ctx.url.searchParams.get("scope") || "all",
+    });
+  return json({ results: searchResearch(query.q, query.scope) });
+}
+
+async function handleGraph(ctx: ResearchRequestContext) {
+  const { request, method } = ctx;
+  if (method === "GET") return json(await getResearchGraph());
+  if (method === "POST") {
+    const input = graphActionSchema.parse(await body(request));
+    if (input.action === "suggest")
+      return json(await suggestGraph(input.paperId));
+    if (input.action === "add")
+      return json(
+        await addManualGraphEdge({
+          source: z.string().min(1).parse(input.source),
+          target: z.string().min(1).parse(input.target),
+          kind: input.kind,
+          label: input.label,
+          rationale: input.rationale,
+          evidence: input.evidence || [],
+        }),
+      );
+    return json(
+      await decideGraphEdge(
+        idSchema.parse(input.edgeId),
+        input.action === "confirm"
+          ? "confirmed"
+          : input.action === "reject"
+            ? "rejected"
+            : "candidate",
+        input.version,
+      ),
+    );
+  }
+  throw notFound();
+}
+
+type RunInput = z.infer<typeof runSchema>;
+
+function discussionDocuments(context: ReturnType<typeof researchContext>) {
+  return [
+    {
+      document_id: context.paper.id,
+      title: context.paper.title,
+      content_revision: context.paper.contentRevision,
+      pages: context.pages,
+    },
+    ...(context.related ?? []).map((entry) => ({
+      document_id: entry.paper.id,
+      title: entry.paper.title,
+      content_revision: entry.paper.contentRevision,
+      pages: paperPages(entry.paper),
+    })),
+  ];
+}
+
+function assertAnalyzableText(
+  context: ReturnType<typeof researchContext>,
+  prepared: ReturnType<typeof prepareLearningInput>,
+) {
+  if (context.paper.textStatus === "ready") return;
+  if (prepared.selection?.text || prepared.selection?.quote) return;
+  if (prepared.context.studyMaterials?.length) return;
+  throw new ResearchError(
+    "此PDF没有可分析的文字层。请上传文字PDF或提供选区文字。",
+    422,
+  );
+}
+
+async function createResearchRun(input: RunInput) {
+  const context = researchContext(
+    input.paperId,
+    input.mode === "graph" ? undefined : input.question,
+    input.learning ? [input.paperId] : input.sourcePaperIds,
+  );
+  if (input.selection && input.selection.page > context.paper.pageCount)
+    throw new ResearchError("选区页码超出论文范围");
+  if (effectiveAnswerStyle(input) === "discussion")
+    context.sourceDocuments = discussionDocuments(context);
+  const prepared = prepareLearningInput(
+    prepareQuestionInput({ ...input, context }),
+  );
+  assertAnalyzableText(context, prepared);
+  return startResearchRun(prepared);
+}
+
+async function startRunResponse(request: Request): Promise<Response> {
+  const input = runSchema.parse(await body(request));
+  if (
+    input.sourcePaperIds &&
+    (input.mode !== "ask" || !input.sourcePaperIds.includes(input.paperId))
+  )
+    throw new ResearchError("来源选择用于问答，且必须包含当前论文");
+  const run = await withPaperLifecycle(() => createResearchRun(input));
+  return json({ run }, 202);
+}
+
+async function handleRunItem(
+  request: Request,
+  id: string,
+  detail: string | undefined,
+  method: string,
+): Promise<Response> {
+  idSchema.parse(id);
+  const local = (await getResearchHistory(undefined, false)).find(
+    (run) => run.id === id,
+  );
+  if (!local) throw new ResearchError("分析记录不存在", 404);
+  paperById(local.paperId);
+  const visible = visibleRun(
+    local,
+    new Set(activeWorkspace().papers.map((paper) => paper.id)),
+  );
+  if (!visible)
+    throw new ResearchError("分析来源论文已移入回收站，请先恢复后再查看", 410);
+  if (detail === "permission" && method === "POST") {
+    const input = z
+      .object({
+        toolUseId: idSchema,
+        decision: z.enum(["allow_once", "deny_once"]),
+      })
+      .parse(await body(request));
+    return json({
+      run: await respondResearchPermission(id, input.toolUseId, input.decision),
+    });
+  }
+  if (method === "GET") {
+    const run = await getResearchRun(id);
+    await applyGraphRun(run);
+    return json({ run });
+  }
+  if (method === "POST" && (!detail || detail === "cancel")) {
+    z.object({ action: z.literal("cancel").optional() }).parse(
+      await body(request),
+    );
+    return json({ run: await cancelResearchRun(id) });
+  }
+  throw notFound();
+}
+
+async function handleRuns(ctx: ResearchRequestContext) {
+  const { request, url, id, detail, method } = ctx;
+  if (!id && method === "GET") {
+    const paperId = url.searchParams.get("paperId") || undefined;
+    if (paperId) paperById(idSchema.parse(paperId));
+    const history = await getResearchHistory(paperId);
+    const ids = new Set(activeWorkspace().papers.map((paper) => paper.id));
+    return json({ history: history.filter((run) => visibleRun(run, ids)) });
+  }
+  if (!id && method === "POST") return startRunResponse(request);
+  if (id) return handleRunItem(request, id, detail, method);
+  throw notFound();
+}
+
+async function handleSettings(ctx: ResearchRequestContext) {
+  const { request, id, detail, method } = ctx;
+  if (method === "GET")
+    return json({
+      settings: readWorkspace().settings,
+      health: await getResearchHealth().catch(() => ({ available: false })),
+    });
+  if (method === "PATCH") {
+    const input = settingsSchema.parse(await body(request));
+    const settings = await mutateWorkspace((state) => {
+      expectedVersion(
+        state.settings.version,
+        versionFromRequest(request, input.version),
+      );
+      Object.assign(state.settings, input, {
+        version: state.settings.version + 1,
+      });
+      return state.settings;
+    });
+    return json({ settings });
+  }
+  if (method === "POST" && detail === undefined && id === "provider") {
+    const input = z
+      .object({
+        base_url: z.url().optional(),
+        model: z.string().min(1).max(200).optional(),
+        api_key: z.string().max(1000).optional(),
+      })
+      .parse(await body(request));
+    return json({ health: await configureResearchProvider(input) });
+  }
+  throw notFound();
+}
+
+function handleExport(ctx: ResearchRequestContext) {
+  const input = z
+    .object({
+      paperId: idSchema.optional(),
+      format: z.literal("markdown").default("markdown"),
+    })
+    .parse({
+      paperId: ctx.url.searchParams.get("paperId") || undefined,
+      format: ctx.url.searchParams.get("format") || "markdown",
+    });
+  return new Response(exportMarkdown(input.paperId), {
+    headers: {
+      "content-type": "text/markdown; charset=utf-8",
+      "content-disposition": `attachment; filename="research-notes.md"; filename*=UTF-8''${encodeURIComponent("教研阅记-研究笔记.md")}`,
+      "cache-control": "no-store",
+    },
+  });
+}
+
+async function handleBackup() {
+  const backup = await createResearchBackup();
+  return new Response(new Uint8Array(backup).buffer, {
+    headers: {
+      "content-type": "application/zip",
+      "content-disposition": 'attachment; filename="research-backup.zip"',
+      "cache-control": "no-store",
+    },
+  });
+}
+
+function notFound() {
+  return new ResearchError("此研究接口不存在或不支持该操作", 404);
+}
+
+type ResearchRoute = {
+  match: (ctx: ResearchRequestContext) => boolean;
+  handle: (ctx: ResearchRequestContext) => Response | Promise<Response>;
+};
+
+const routes: ResearchRoute[] = [
+  { match: ({ area }) => area === "review", handle: handleReview },
+  {
+    match: ({ area, method }) => !area && method === "GET",
+    handle: handleWorkspace,
+  },
+  {
+    match: ({ area, method }) => area === "health" && method === "GET",
+    handle: handleHealth,
+  },
+  {
+    match: ({ area, id, method }) =>
+      area === "trash" && !id && method === "GET",
+    handle: handleTrash,
+  },
+  {
+    match: ({ area, id, method }) =>
+      area === "examples" && id === "import" && method === "POST",
+    handle: handleExamplesImport,
+  },
+  {
+    match: ({ area, id }) => area === "papers" && !id,
+    handle: handlePaperCollection,
+  },
+  {
+    match: ({ area, id }) => area === "papers" && !!id,
+    handle: handlePaperItem,
+  },
+  { match: ({ area }) => area === "notes", handle: handleNotes },
+  { match: ({ area }) => area === "annotations", handle: handleAnnotations },
+  {
+    match: ({ area }) => area === "knowledge" || area === "concepts",
+    handle: handleKnowledge,
+  },
+  {
+    match: ({ area, method }) => area === "search" && method === "GET",
+    handle: handleSearch,
+  },
+  { match: ({ area }) => area === "graph", handle: handleGraph },
+  {
+    match: ({ area }) =>
+      area === "runs" || area === "tasks" || area === "history",
+    handle: handleRuns,
+  },
+  { match: ({ area }) => area === "settings", handle: handleSettings },
+  {
+    match: ({ area, method }) => area === "export" && method === "GET",
+    handle: handleExport,
+  },
+  {
+    match: ({ area, method }) => area === "backup" && method === "GET",
+    handle: handleBackup,
+  },
+];
+
+export async function dispatchResearchRoute(
+  ctx: ResearchRequestContext,
+): Promise<Response> {
+  for (const route of routes) {
+    if (route.match(ctx)) return route.handle(ctx);
+  }
+  throw notFound();
+}
