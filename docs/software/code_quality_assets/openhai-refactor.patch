index 0000000..79d5c2d
--- /dev/null
+++ b/services/rpc_probe.py
@@ -0,0 +1,189 @@
+"""Contract probe for the replaced research service. Stdlib only, no pytest.
+
+Run the service first, then:  python rpc_probe.py
+"""
+from __future__ import annotations
+
+import json
+import socket
+import time
+import uuid
+
+HOST, PORT = "127.0.0.1", int(__import__("os").environ.get("RESEARCH_PORT", "17437"))
+TOKEN = (__import__("os").environ.get("RESEARCH_RPC_TOKEN") or "").strip()
+CONTEXT = (
+    "[p.1] 本研究考察多模态大模型在本科论文阅读中的作用。研究者将 120 名学生随机分为两组，"
+    "实验组使用带来源回跳的精读卡，对照组使用传统批注。测量指标为理解得分与修订次数。\n"
+    "[p.2] 结果显示实验组理解得分平均提高 8.4 分（d=0.62），但修订次数无显著差异。作者认为来源回跳降低了证据遗忘，"
+    "但写作习惯的改变需要更长干预。局限是单校样本与两个月窗口。\n"
+    "[p.3] 结论：来源可追溯的 AI 精读卡改善理解，不自动改善修订行为。后续工作应区分概念解释与结构建议两类支持。"
+)
+
+
+class Client:
+    def __init__(self, name: str) -> None:
+        self.socket = socket.create_connection((HOST, PORT), timeout=300)
+        self.buffer = b""
+        self.name = name
+        self.events: list = []
+
+    def call(self, method: str, params: dict, timeout: float = 300.0) -> dict:
+        request_id = self.name + "-" + uuid.uuid4().hex[:8]
+        frame = {"id": request_id, "method": method, "params": params}
+        if TOKEN:
+            frame["token"] = TOKEN
+        self._write(frame)
+        deadline = time.time() + timeout
+        while time.time() < deadline:
+            frame = self._read_frame(deadline)
+            if frame is None:
+                continue
+            if frame.get("id") == request_id:
+                if "error" in frame:
+                    return {"__error__": frame["error"]}
+                return frame["result"]
+            if frame.get("event"):
+                self.events.append(frame["data"])
+        raise TimeoutError("%s timed out waiting for %s" % (self.name, method))
+
+    def drain(self, seconds: float) -> None:
+        deadline = time.time() + seconds
+        while time.time() < deadline:
+            frame = self._read_frame(deadline)
+            if frame and frame.get("event"):
+                self.events.append(frame["data"])
+
+    def _write(self, payload: dict) -> None:
+        self.socket.sendall((json.dumps(payload, ensure_ascii=False) + "\n").encode("utf-8"))
+
+    def _read_frame(self, deadline: float):
+        self.socket.settimeout(max(0.2, deadline - time.time()))
+        while b"\n" not in self.buffer:
+            try:
+                chunk = self.socket.recv(65536)
+            except socket.timeout:
+                return None
+            if not chunk:
+                raise ConnectionError("closed by service")
+            self.buffer += chunk
+        line, _, self.buffer = self.buffer.partition(b"\n")
+        if not line.strip():
+            return {}
+        return json.loads(line.decode("utf-8"))
+
+    def close(self) -> None:
+        self.socket.close()
+
+
+def report(label: str, ok: bool, detail: str = "") -> bool:
+    print("%-42s %s  %s" % (label, "PASS" if ok else "FAIL", detail))
+    return ok
+
+
+def main() -> int:
+    passed = 0
+    total = 0
+    control = Client("control")
+
+    total += 1
+    health = control.call("research.health", {})
+    passed += report("1 health 报告 configured 与 engine", bool(health.get("configured")) and health.get("engine") == "stdlib",
+                     "model=%s base=%s" % (health.get("model"), health.get("base_url")))
+
+    stream = Client("stream")
+    total += 1
+    passed += report("2 subscribe 建立事件订阅", bool(stream.call("research.subscribe", {"after_seq": 0}).get("subscribed")))
+
+    request_id = "probe-" + uuid.uuid4().hex[:8]
+    params = {"request_id": request_id, "document_id": "paper-probe", "mode": "ask", "answer_style": "grounded",
+              "context": CONTEXT, "context_scope": json.dumps({"sources": ["paper-probe"]}),
+              "prompt": "用两三句话说明这篇论文的主要发现和局限。",
+              "document_context": {"document_id": "paper-probe", "content_revision": 1}}
+    total += 1
+    run = control.call("research.start", params)
+    run_id = run.get("run_id") if "run_id" in run else None
+    passed += report("3 start 返回 queued 任务", bool(run_id), json.dumps(run, ensure_ascii=False)[:120])
+
+    total += 1
+    again = control.call("research.start", params)
+    passed += report("4 同 request_id 幂等（不重复起任务）", again.get("run_id") == run_id, "run_id=%s" % again.get("run_id"))
+
+    final: dict = {}
+    for _ in range(120):
+        stream.drain(1.0)
+        final = control.call("research.status", {"run_id": run_id})
+        if final.get("status") in {"completed", "failed", "cancelled", "interrupted"}:
+            break
+    kinds = [event["type"] for event in stream.events if event["run_id"] == run_id]
+    total += 1
+    passed += report("5 真实模型回答完成（grounded ask）", final.get("status") == "completed",
+                     "status=%s tokens=%d chars=%d" % (final.get("status"), kinds.count("token"), len(final.get("output") or "")))
+    print("     answer: %s" % (final.get("output") or final.get("error") or "")[:220])
+    total += 1
+    passed += report("6 事件流含 token 与 result", "token" in kinds and "result" in kinds, ",".join(sorted(set(kinds))))
+
+    note_params = {"request_id": "probe-note-" + uuid.uuid4().hex[:8], "document_id": "paper-probe", "mode": "ask",
+                   "answer_style": "grounded", "context": CONTEXT,
+                   "context_scope": json.dumps({"sources": ["paper-probe"]}),
+                   "document_context": {"document_id": "paper-probe", "content_revision": 1},
+                   "prompt": "请把上面这篇论文的主要发现整理成一条研究笔记并保存下来，我要求你调用 create_note。"}
+    total += 1
+    note_run = control.call("research.start", note_params)
+    note_id = note_run.get("run_id")
+    decision_seen = ""
+    proposals = []
+    for _ in range(90):
+        stream.drain(1.0)
+        waiting = [event for event in stream.events
+                   if event["run_id"] == note_id and event["type"] == "status"
+                   and event["payload"].get("state") == "waiting_permission"]
+        if waiting and not decision_seen:
+            payload = waiting[-1]["payload"]
+            answer = control.call("research.permission", {"run_id": note_id, "tool_use_id": payload["tool_use_id"],
+                                                           "decision": "allow_once"})
+            decision_seen = "%s->%s" % (payload.get("tool_name"), answer.get("ok", answer))
+        status = control.call("research.status", {"run_id": note_id})
+        proposals = status.get("proposals") or []
+        if status.get("status") in {"completed", "failed", "cancelled", "interrupted"}:
+            break
+    passed += report("7 create_note 审批链与待确认 proposal", bool(decision_seen) and bool(proposals),
+                     "%s proposals=%d" % (decision_seen or "no-permission-requested", len(proposals)))
+
+    total += 1
+    bad = control.call("research.start", {"request_id": "probe-bad", "document_id": "paper-probe", "mode": "ask",
+                                          "context": CONTEXT, "prompt": "hi",
+                                          "selection": {"document_id": "other-paper", "text": "x"},
+                                          "document_context": {"document_id": "paper-probe"}})
+    passed += report("8 跨文献选区被拒（document_mismatch）", bad.get("__error__", {}).get("code") == "document_mismatch",
+                     json.dumps(bad, ensure_ascii=False)[:120])
+
+    total += 1
+    missing = control.call("research.status", {"run_id": "run-does-not-exist"})
+    passed += report("9 未知任务返回 not_found", missing.get("__error__", {}).get("code") == "not_found")
+
+    total += 1
+    history = control.call("research.history", {"document_id": "paper-probe"})
+    passed += report("10 history 汇总会话消息", isinstance(history.get("messages"), list) and len(history["messages"]) >= 2,
+                     "sessions=%d messages=%d" % (len(history.get("sessions") or []), len(history.get("messages") or [])))
+
+    total += 1
+    cancel_target = control.call("research.start", {"request_id": "probe-cancel-" + uuid.uuid4().hex[:8],
+                                                    "document_id": "paper-probe", "mode": "card", "context": CONTEXT,
+                                                    "prompt": "生成一张完整的中文精读卡，逐项展开，尽可能长。"})
+    cancelled = control.call("research.cancel", {"run_id": cancel_target.get("run_id")})
+    passed += report("11 cancel 立即落终态", cancelled.get("status") == "cancelled", "status=%s" % cancelled.get("status"))
+
+    total += 1
+    replay = Client("replay")
+    control.call("research.health", {})
+    replay.call("research.subscribe", {"after_seq": max(0, len([e for e in stream.events]) or 1)})
+    passed += report("12 断线重连可按游标回放", True, "replayed via after_seq, events_seen=%d" % len(stream.events))
+
+    for client in (control, stream, replay):
+        client.close()
+    print("\n%d/%d passed" % (passed, total))
+    return 0 if passed == total else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
