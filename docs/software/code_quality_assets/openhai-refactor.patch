archBackendRun>>(),\r\n  sequence: 0,\r\n}));\r\nvi.mock(\"@/lib/agent/registry\", () => ({\r\n  getResearchProvider: () => ({ start: boundary.start }),\r\n}));\r\nlet directory: string;\r\nbeforeEach(() => {\r\n  directory = fs.mkdtempSync(path.join(os.tmpdir(), \"discussion-\"));\r\n  vi.stubEnv(\"PAPERNOOK_DATA_DIR\", directory);\r\n  vi.stubEnv(\"RESEARCH_DATA_DIR\", path.join(directory, \"research\"));\r\n  vi.stubGlobal(\"fetch\", () => {\r\n    throw new Error(\"No network allowed in this test\");\r\n  });\r\n  boundary.sequence = 0;\r\n  boundary.start.mockReset();\r\n  boundary.start.mockImplementation(async (params) => ({\r\n    run_id: \"discussion-run-\" + ++boundary.sequence,\r\n    session_id:\r\n      typeof params.session_id === \"string\"\r\n        ? params.session_id\r\n        : \"discussion-session-\" + boundary.sequence,\r\n    document_id: String(params.document_id),\r\n    mode: String(params.mode),\r\n    status: \"completed\",\r\n    output: \"A source-grounded explanation and some background knowledge.\",\r\n    created_at: new Date(\r\n      Date.UTC(2026, 10, 1, 0, 0, boundary.sequence),\r\n    ).toISOString(),\r\n  }));\r\n});\r\nafterEach(() => {\r\n  vi.unstubAllEnvs();\r\n  vi.unstubAllGlobals();\r\n  fs.rmSync(directory, { recursive: true, force: true });\r\n});\r\nconst now = \"2026-11-01T00:00:00Z\";\r\nfunction paper(id: string): ResearchPaper {\r\n  return {\r\n    id,\r\n    title: id,\r\n    filename: id + \".pdf\",\r\n    authors: \"\",\r\n    year: \"2026\",\r\n    topic: \"研究\",\r\n    tags: [],\r\n    readStatus: \"reading\",\r\n    pageCount: 60,\r\n    textStatus: \"ready\",\r\n    contentRevision: id + \"-revision\",\r\n    pdfEtag: '\"hash\"',\r\n    version: 1,\r\n    lastReadPage: 1,\r\n    createdAt: now,\r\n    updatedAt: now,\r\n    library: { topic: \"research\", slug: id },\r\n  };\r\n}\r\nfunction concept(\r\n  id: string,\r\n  title: string,\r\n  aliases: string[] = [],\r\n): KnowledgeEntry {\r\n  return {\r\n    id,\r\n    title,\r\n    aliases,\r\n    body: title + \"的核心理论及具体实践例子\",\r\n    definition: title,\r\n    category: \"教育\",\r\n    sources: [],\r\n    source: \"preset\",\r\n    origin: \"seed\",\r\n    version: 1,\r\n    createdAt: now,\r\n    updatedAt: now,\r\n  };\r\n}\r\nfunction input(): StartResearchRunInput {\r\n  return {\r\n    paperId: \"paper-one\",\r\n    mode: \"ask\",\r\n    question: \"这个机制如何联系自我调节学习？\",\r\n    selection: {\r\n      page: 53,\r\n      text: \"Learners monitor their progress.\",\r\n      contentRevision: \"paper-one-revision\",\r\n    },\r\n    sourcePaperIds: [\"paper-one\"],\r\n    context: {\r\n      paper: paper(\"paper-one\"),\r\n      pages: [\r\n        { page: 1, text: \"UNRELATED-FIRST-PAGE \" + \"x\".repeat(130000) },\r\n        {\r\n          page: 53,\r\n          text: \"Learning context before. Learners monitor their progress. Reflection follows.\",\r\n        },\r\n        {\r\n          page: 54,\r\n          text: \"Self-regulated learning links monitoring to reflection.\",\r\n        },\r\n      ],\r\n      notes: [],\r\n      knowledge: [\r\n        concept(\"srl\", \"自我调节学习\", [\"self-regulated learning\", \"SRL\"]),\r\n        concept(\"fa\", \"形成性评价\", [\"feedback\"]),\r\n      ],\r\n      related: [\r\n        {\r\n          paper: paper(\"other-paper\"),\r\n          pages: [{ page: 1, text: \"UNSELECTED-OTHER-PAPER\" }],\r\n          notes: [],\r\n        },\r\n      ],\r\n    },\r\n  };\r\n}\r\nfunction previous(request: StartResearchRunInput): ResearchRun {\r\n  return {\r\n    id: \"previous\",\r\n    paperId: request.paperId,\r\n    mode: \"ask\",\r\n    answerStyle: \"discussion\",\r\n    status: \"completed\",\r\n    question: \"前一问\",\r\n    answer: \"前一答\",\r\n    sessionId: \"session-one\",\r\n    contentRevision: request.context.paper.contentRevision,\r\n    contextScope: researchContextScope(request),\r\n    createdAt: now,\r\n    updatedAt: now,\r\n  };\r\n}\r\n\r\ndescribe(\"free discussion with bounded evidence\", () => {\r\n  it(\"does not carry chosen discussion concepts into paper cards, analysis or graph requests\", async () => {\r\n    for (const mode of [\"card\", \"analyze\", \"graph\"] as const) {\r\n      const request = {\r\n        ...input(),\r\n        mode,\r\n        referenceConceptIds: [\"srl\"],\r\n        question: \"请结合知识库整理材料\",\r\n      };\r\n      request.context.pages = request.context.pages.map((page) => ({\r\n        ...page,\r\n        text: page.text.slice(0, 300),\r\n      }));\r\n      const run = await startResearchRun(request);\r\n      const packet = boundary.start.mock.calls.at(-1)![0];\r\n      const context = JSON.parse(String(packet.context));\r\n      expect(context.education_library).toEqual([]);\r\n      expect(context.paper_pages).toContain(\"Learners monitor their progress.\");\r\n      expect(packet.answer_style).toBe(\"grounded\");\r\n      expect(run.referenceConceptIds).toEqual([]);\r\n      expect(run.referenceConcepts).toEqual([]);\r\n    }\r\n  });\r\n  it(\"bounds the tool-only pool and strips private page metadata while keeping a late selected page\", () => {\r\n    const documents = Array.from({ length: 4 }, (_, index) => ({\r\n      document_id: index ? \"related-\" + index : \"paper-one\",\r\n      title: \"test\",\r\n      content_revision: \"revision\",\r\n      pages: Array.from({ length: 2200 }, (_, page) => ({\r\n        page: page + 1,\r\n        text: \"x\".repeat(1000),\r\n        width: 600,\r\n        height: 800,\r\n      })),\r\n    }));\r\n    const pool = boundedSourceDocuments(documents, \"paper-one\", 2100);\r\n    expect(pool.truncated).toBe(true);\r\n    expect(pool.documents[0].pages[0].page).toBe(2100);\r\n    expect(\r\n      pool.documents\r\n        .flatMap((doc) => doc.pages)\r\n        .reduce((sum, page) => sum + page.text.length, 0),\r\n    ).toBeLessThanOrEqual(2000000);\r\n    expect(Object.keys(pool.documents[0]).sort()).toEqual([\r\n      \"document_id\",\r\n      \"pages\",\r\n      \"title\",\r\n    ]);\r\n    expect(Object.keys(pool.documents[0].pages[0]).sort()).toEqual([\r\n      \"page\",\r\n      \"text\",\r\n    ]);\r\n  });\r\n  it(\"matches a relevant preset or explicit aliases but does not force generic feedback into education\", () => {\r\n    const library = input().context.knowledge;\r\n    expect(\r\n      pickReferenceConcepts(library, \"请联系自我调节学习理解这段\").map(\r\n        (c) => c.id,\r\n      ),\r\n    ).toEqual([\"srl\"]);\r\n    expect(\r\n      pickReferenceConcepts(\r\n        library,\r\n        \"How does self-regulated learning work?\",\r\n      ).map((c) => c.id),\r\n    ).toEqual([\"srl\"]);\r\n    expect(\r\n      pickReferenceConcepts(library, \"Explain the AI harness feedback loop.\"),\r\n    ).toEqual([]);\r\n    expect(pickReferenceConcepts(library, \"SRL\", [])).toEqual([]);\r\n    expect(\r\n      pickReferenceConcepts(library, \"An unrelated topic\", [\"fa\"]).map(\r\n        (c) => c.id,\r\n      ),\r\n    ).toEqual([\"fa\"]);\r\n  });\r\n  it(\"starts from the real selected late page and relevant excerpts, not the first 100000 characters\", () => {\r\n    const request = input();\r\n    const context = buildResearchContext(request);\r\n    expect(context.answer_style).toBe(\"discussion\");\r\n    expect(context.provided_pages).toContain(53);\r\n    expect(context.paper_pages).toContain(\"Learning context before.\");\r\n    expect(context.paper_pages).not.toContain(\"UNRELATED-FIRST-PAGE\");\r\n    expect(context.related_papers).toEqual([]);\r\n    expect(context.education_library.map((entry) => entry.id)).toEqual([\"srl\"]);\r\n    expect(JSON.stringify(context).length).toBeLessThan(12000);\r\n  });\r\n  it(\"retrieves a relevant later page for a whole-paper question without silently injecting unrelated sources\", () => {\r\n    const request = input();\r\n    delete request.selection;\r\n    request.question = \"Explain monitoring and reflection\";\r\n    const context = buildResearchContext(request);\r\n    expect(context.provided_pages).toContain(54);\r\n    expect(context.paper_pages).not.toContain(\"UNRELATED-FIRST-PAGE\");\r\n    expect(JSON.stringify(context)).not.toContain(\"UNSELECTED-OTHER-PAPER\");\r\n  });\r\n  it(\"keeps evidence tasks strict even if an old client requests discussion\", () => {\r\n    for (const mode of [\"graph\", \"card\", \"analyze\", \"concept\"] as const)\r\n      expect(effectiveAnswerStyle({ ...input(), mode })).toBe(\"grounded\");\r\n    for (const task of [\"notes\", \"quiz\", \"understanding\"] as const)\r\n      expect(\r\n        effectiveAnswerStyle({\r\n          ...input(),\r\n          learning: { task, source: { kind: \"selection\" } },\r\n        }),\r\n      ).toBe(\"grounded\");\r\n    expect(effectiveAnswerStyle({ ...input(), answerStyle: \"grounded\" })).toBe(\r\n      \"grounded\",\r\n    );\r\n  });\r\n  it(\"isolates style, concept edits and body revisions while allowing same-passage follow-up after Explain\", () => {\r\n    const request = input();\r\n    request.referenceConceptIds = [\"srl\"];\r\n    const run = previous(request);\r\n    const scope = researchContextScope(request);\r\n    expect(JSON.parse(scope).policy).toBe(\"explicit-source-scope-v6\");\r\n    const explain = {\r\n      ...request,\r\n      learning: {\r\n        task: \"explain\" as const,\r\n        source: { kind: \"selection\" as const },\r\n      },\r\n      question: \"解释选文\",\r\n    };\r\n    expect(researchContextScope(explain)).toBe(scope);\r\n    expect(\r\n      canReuseResearchSession(\r\n        { ...run, learning: explain.learning },\r\n        request,\r\n        scope,\r\n      ),\r\n    ).toBe(true);\r\n    expect(researchContextScope({ ...request, question: \"为什么？\" })).toBe(\r\n      scope,\r\n    );\r\n    expect(\r\n      researchContextScope({ ...request, answerStyle: \"grounded\" }),\r\n    ).not.toBe(scope);\r\n    const changed = input();\r\n    changed.referenceConceptIds = [\"srl\"];\r\n    changed.context.knowledge[0].version++;\r\n    expect(researchContextScope(changed)).not.toBe(scope);\r\n    expect(\r\n      canReuseResearchSession(\r\n        { ...run, contextScope: scope.replace(\"v6\", \"v5\") },\r\n        request,\r\n        scope,\r\n      ),\r\n    ).toBe(false);\r\n  });\r\n  it(\"injects compact current evidence into the first model prompt and persists actual style and concepts\", async () => {\r\n    const request = input();\r\n    const created = await startResearchRun(request);\r\n    const packet = boundary.start.mock.calls[0][0];\r\n    expect(packet.answer_style).toBe(\"discussion\");\r\n    expect(packet.conversation_question).toBe(request.question);\r\n    expect(packet.prompt).toContain(\"Learners monitor their progress.\");\r\n    expect(packet.prompt).toContain(\"自我调节学习\");\r\n    expect(String(packet.prompt)).not.toContain(\"只使用本次context\");\r\n    expect(String(packet.prompt)).not.toContain(\"UNRELATED-FIRST-PAGE\");\r\n    expect(String(packet.prompt).length).toBeLessThan(15000);\r\n    expect(\r\n      (packet.source_documents as { document_id: string }[]).map(\r\n        (item) => item.document_id,\r\n      ),\r\n    ).toEqual([\"paper-one\"]);\r\n    expect(await getResearchRun(created.id)).toMatchObject({\r\n      answerStyle: \"discussion\",\r\n      referenceConceptIds: [\"srl\"],\r\n      referenceConcepts: [{ id: \"srl\", title: \"自我调节学习\", version: 1 }],\r\n      contextSummary: { pages: [53, 54] },\r\n    });\r\n  });\r\n  it(\"continues a matching discussion and never crosses to source-only mode or a different selection\", async () => {\r\n    const request = input();\r\n    request.referenceConceptIds = [\"srl\"];\r\n    const created = await startResearchRun(request);\r\n    await startResearchRun({ ...request, question: \"为什么？\" });\r\n    expect(boundary.start.mock.calls[1][0].session_id).toBe(created.sessionId);\r\n    await startResearchRun({ ...request, answerStyle: \"grounded\" });\r\n    expect(boundary.start.mock.calls[2][0].session_id).toBeUndefined();\r\n    expect(boundary.start.mock.calls[2][0].source_documents).toBeUndefined();\r\n    expect(boundary.start.mock.calls[2][0].prompt).toContain(\r\n      \"只使用本次context\",\r\n    );\r\n    await startResearchRun({\r\n      ...request,\r\n      selection: { ...request.selection!, page: 54 },\r\n    });\r\n    expect(boundary.start.mock.calls[3][0].session_id).toBeUndefined();\r\n  });\r\n});\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\tests\\lib\\research-graph-data.test.ts","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (163). Maximum allowed is 50.","line":52,"column":38,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":220,"endColumn":2}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { describe, expect, it } from \"vitest\";\r\nimport {\r\n  filterGraph,\r\n  nodeKindLabel,\r\n  shortNodeLabel,\r\n  type GraphFilters,\r\n} from \"../../src/components/research/graph/graph-data\";\r\nimport type {\r\n  GraphEdge,\r\n  GraphNode,\r\n  ResearchGraph,\r\n} from \"../../src/lib/research/types\";\r\n\r\nfunction node(id: string, changes: Partial<GraphNode> = {}): GraphNode {\r\n  return { id, label: id, title: id, kind: \"concept\", ...changes };\r\n}\r\n\r\nfunction edge(\r\n  source: string,\r\n  target: string,\r\n  changes: Partial<GraphEdge> = {},\r\n): GraphEdge {\r\n  return {\r\n    id: `${source}-${target}`,\r\n    source,\r\n    target,\r\n    kind: \"related\",\r\n    label: \"相关\",\r\n    status: \"confirmed\",\r\n    origin: \"source\",\r\n    evidence: [{ paperId: \"paper-one\" }],\r\n    rationale: \"来自研究记录\",\r\n    version: 1,\r\n    createdAt: \"2026-11-01T00:00:00Z\",\r\n    updatedAt: \"2026-11-01T00:00:00Z\",\r\n    ...changes,\r\n  };\r\n}\r\n\r\nfunction graph(nodes: GraphNode[], edges: GraphEdge[]): ResearchGraph {\r\n  return { nodes, edges, version: 1 };\r\n}\r\n\r\nconst defaults: GraphFilters = {\r\n  view: \"all\",\r\n  paperId: \"\",\r\n  query: \"\",\r\n  showCandidates: true,\r\n};\r\nconst ids = (nodes: GraphNode[]) => nodes.map((node) => node.id);\r\n\r\ndescribe(\"research graph filtering\", () => {\r\n  it(\"includes only direct search matches and one-hop neighbors regardless of edge order\", () => {\r\n    const nodes = [\r\n      node(\"a\", { label: \"Assessment\" }),\r\n      node(\"b\"),\r\n      node(\"c\"),\r\n      node(\"d\"),\r\n    ];\r\n    const edges = [edge(\"a\", \"b\"), edge(\"b\", \"c\"), edge(\"d\", \"a\")];\r\n    for (const ordered of [edges, [...edges].reverse()]) {\r\n      const result = filterGraph(graph(nodes, ordered), {\r\n        ...defaults,\r\n        query: \"  ASSESSMENT  \",\r\n      });\r\n      expect(ids(result.nodes)).toEqual([\"a\", \"b\", \"d\"]);\r\n      expect(result.matchedIds).toEqual([\"a\"]);\r\n      expect(result.edges.map((edge) => edge.id).sort()).toEqual([\r\n        \"a-b\",\r\n        \"d-a\",\r\n      ]);\r\n    }\r\n  });\r\n\r\n  it(\"matches definitions and returns an empty graph when no node matches\", () => {\r\n    const source = graph(\r\n      [node(\"a\", { definition: \"Formative feedback\" }), node(\"b\")],\r\n      [edge(\"a\", \"b\")],\r\n    );\r\n    const result = filterGraph(source, { ...defaults, query: \" FEEDBACK \" });\r\n    expect(ids(result.nodes)).toEqual([\"a\", \"b\"]);\r\n    expect(result.matchedIds).toEqual([\"a\"]);\r\n    expect(filterGraph(source, { ...defaults, query: \"missing\" })).toEqual({\r\n      nodes: [],\r\n      edges: [],\r\n      matchedIds: [],\r\n    });\r\n  });\r\n\r\n  it(\"scopes paper evidence before searching and retains the selected paper even without links\", () => {\r\n    const source = graph(\r\n      [\r\n        node(\"p1\", { kind: \"paper\", paperId: \"paper-one\" }),\r\n        node(\"p2\", { kind: \"paper\", paperId: \"paper-two\" }),\r\n        node(\"a\", { label: \"Target concept\" }),\r\n        node(\"b\", { label: \"Hidden concept\" }),\r\n      ],\r\n      [\r\n        edge(\"p1\", \"a\"),\r\n        edge(\"a\", \"p2\", { evidence: [{ paperId: \"paper-two\" }] }),\r\n        edge(\"a\", \"b\", { evidence: [{ paperId: \"paper-two\" }] }),\r\n      ],\r\n    );\r\n    expect(\r\n      ids(filterGraph(source, { ...defaults, paperId: \"paper-one\" }).nodes),\r\n    ).toEqual([\"p1\", \"a\"]);\r\n    const result = filterGraph(source, {\r\n      ...defaults,\r\n      paperId: \"paper-one\",\r\n      query: \"Target\",\r\n    });\r\n    expect(ids(result.nodes)).toEqual([\"p1\", \"a\"]);\r\n    expect(result.edges.map((edge) => edge.id)).toEqual([\"p1-a\"]);\r\n    expect(\r\n      filterGraph(source, {\r\n        ...defaults,\r\n        paperId: \"paper-one\",\r\n        query: \"Hidden\",\r\n      }).nodes,\r\n    ).toEqual([]);\r\n    expect(\r\n      ids(\r\n        filterGraph(graph(source.nodes, []), {\r\n          ...defaults,\r\n          paperId: \"paper-one\",\r\n        }).nodes,\r\n      ),\r\n    ).toEqual([\"p1\"]);\r\n  });\r\n\r\n  it(\"keeps paper-only search inside visible paper-to-paper relationships\", () => {\r\n    const source = graph(\r\n      [\r\n        node(\"p1\", { kind: \"paper\", label: \"Target paper\" }),\r\n        node(\"p2\", { kind: \"paper\" }),\r\n        node(\"p3\", { kind: \"paper\" }),\r\n        node(\"concept\"),\r\n      ],\r\n      [edge(\"p1\", \"concept\"), edge(\"concept\", \"p2\"), edge(\"p1\", \"p3\")],\r\n    );\r\n    const result = filterGraph(source, {\r\n      ...defaults,\r\n      view: \"papers\",\r\n      query: \"Target\",\r\n    });\r\n    expect(ids(result.nodes)).toEqual([\"p1\", \"p3\"]);\r\n    expect(result.edges.map((edge) => edge.id)).toEqual([\"p1-p3\"]);\r\n    expect(\r\n      filterGraph(source, {\r\n        ...defaults,\r\n        view: \"papers\",\r\n        query: \"concept\",\r\n      }).nodes,\r\n    ).toEqual([]);\r\n  });\r\n\r\n  it(\"never returns rejected edges and cannot expand search through hidden candidates\", () => {\r\n    const source = graph(\r\n      [node(\"a\"), node(\"b\"), node(\"c\"), node(\"d\")],\r\n      [\r\n        edge(\"a\", \"b\"),\r\n        edge(\"a\", \"c\", { status: \"candidate\" }),\r\n        edge(\"a\", \"d\", { status: \"rejected\" }),\r\n      ],\r\n    );\r\n    const withCandidates = filterGraph(source, { ...defaults, query: \"a\" });\r\n    expect(ids(withCandidates.nodes)).toEqual([\"a\", \"b\", \"c\"]);\r\n    expect(withCandidates.edges.map((edge) => edge.id)).toEqual([\"a-b\", \"a-c\"]);\r\n    const confirmed = filterGraph(source, {\r\n      ...defaults,\r\n      query: \"a\",\r\n      showCandidates: false,\r\n    });\r\n    expect(ids(confirmed.nodes)).toEqual([\"a\", \"b\"]);\r\n    expect(confirmed.edges.map((edge) => edge.id)).toEqual([\"a-b\"]);\r\n  });\r\n\r\n  it(\"focuses one hop inside the filtered graph and does not revive a hidden focus node\", () => {\r\n    const source = graph(\r\n      [node(\"a\"), node(\"b\"), node(\"c\"), node(\"d\")],\r\n      [edge(\"a\", \"b\"), edge(\"b\", \"c\"), edge(\"c\", \"d\")],\r\n    );\r\n    expect(\r\n      ids(filterGraph(source, { ...defaults, focusNodeId: \"b\" }).nodes),\r\n    ).toEqual([\"a\", \"b\", \"c\"]);\r\n    const focusedSearch = filterGraph(source, {\r\n      ...defaults,\r\n      query: \"a\",\r\n      focusNodeId: \"b\",\r\n    });\r\n    expect(ids(focusedSearch.nodes)).toEqual([\"a\", \"b\"]);\r\n    expect(focusedSearch.matchedIds).toEqual([\"a\"]);\r\n    for (const focusNodeId of [\"d\", \"missing\"]) {\r\n      expect(\r\n        filterGraph(source, { ...defaults, query: \"a\", focusNodeId }),\r\n      ).toEqual({ nodes: [], edges: [], matchedIds: [] });\r\n    }\r\n  });\r\n\r\n  it(\"treats blank search as no filter and leaves source records and ordering untouched\", () => {\r\n    const source = graph(\r\n      [node(\"a\"), node(\"b\"), node(\"isolated\")],\r\n      [edge(\"a\", \"b\"), edge(\"b\", \"isolated\", { status: \"rejected\" })],\r\n    );\r\n    const before = JSON.stringify(source);\r\n    for (const query of [\"\", \" \\t\\n \"]) {\r\n      const result = filterGraph(source, { ...defaults, query });\r\n      expect(ids(result.nodes)).toEqual([\"a\", \"b\", \"isolated\"]);\r\n      expect(result.edges.map((edge) => edge.id)).toEqual([\"a-b\"]);\r\n      expect(result.matchedIds).toEqual([]);\r\n    }\r\n    filterGraph(source, { ...defaults, query: \"a\", focusNodeId: \"b\" });\r\n    expect(JSON.stringify(source)).toBe(before);\r\n    expect(filterGraph(graph([], []), defaults)).toEqual({\r\n      nodes: [],\r\n      edges: [],\r\n      matchedIds: [],\r\n    });\r\n  });\r\n});\r\n\r\ndescribe(\"research graph display labels\", () => {\r\n  it(\"uses clear node kinds and preserves short labels\", () => {\r\n    expect(nodeKindLabel(\"paper\")).toBe(\"论文\");\r\n    expect(nodeKindLabel(\"concept\")).toBe(\"概念\");\r\n    expect(nodeKindLabel(\"note\")).toBe(\"笔记\");\r\n    expect(shortNodeLabel(\"形成性评价\", \"concept\")).toBe(\"形成性评价\");\r\n    expect(shortNodeLabel(\"课堂观察\", \"note\")).toBe(\"课堂观察\");\r\n    expect(shortNodeLabel(\"\", \"paper\")).toBe(\"\");\r\n  });\r\n\r\n  it(\"adds an ellipsis only beyond the kind's label limit without splitting Unicode characters\", () => {\r\n    expect(shortNodeLabel(\"概\".repeat(14), \"concept\")).toBe(\"概\".repeat(14));\r\n    expect(shortNodeLabel(\"概\".repeat(15), \"concept\")).toBe(\r\n      \"概\".repeat(14) + \"…\",\r\n    );\r\n    expect(shortNodeLabel(\"文\".repeat(20), \"paper\")).toBe(\"文\".repeat(20));\r\n    expect(shortNodeLabel(\"文\".repeat(21), \"paper\")).toBe(\r\n      \"文\".repeat(20) + \"…\",\r\n    );\r\n    expect(shortNodeLabel(\"📚\".repeat(15), \"note\")).toBe(\"📚\".repeat(14) + \"…\");\r\n  });\r\n});\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\tests\\lib\\research-highlight-selection.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\tests\\lib\\research-home-interactions.test.ts","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (94). Maximum allowed is 50.","line":75,"column":37,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":170,"endColumn":2}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { describe, expect, it } from \"vitest\";\r\nimport {\r\n  homeGraphConcepts,\r\n  recentHomeNotes,\r\n  searchHomePapers,\r\n} from \"../../src/components/research/home/home-data\";\r\nimport type {\r\n  GraphEdge,\r\n  ResearchGraph,\r\n  ResearchNote,\r\n  ResearchPaper,\r\n} from \"../../src/lib/research/types\";\r\n\r\nfunction paper(\r\n  id: string,\r\n  changes: Partial<ResearchPaper> = {},\r\n): ResearchPaper {\r\n  return {\r\n    id,\r\n    title: id,\r\n    filename: id + \".pdf\",\r\n    authors: \"\",\r\n    year: \"2026\",\r\n    topic: \"教育研究\",\r\n    tags: [],\r\n    readStatus: \"unread\",\r\n    pageCount: 1,\r\n    textStatus: \"ready\",\r\n    contentRevision: id + \"-text\",\r\n    pdfEtag: '\"test\"',\r\n    version: 1,\r\n    lastReadPage: 1,\r\n    createdAt: \"2026-10-01T00:00:00Z\",\r\n    updatedAt: \"2026-10-01T00:00:00Z\",\r\n    library: { topic: \"research\", slug: id },\r\n    ...changes,\r\n  };\r\n}\r\n\r\nfunction note(id: string, paperId: string, updatedAt: string): ResearchNote {\r\n  return {\r\n    id,\r\n    paperId,\r\n    title: id,\r\n    body: \"笔记\",\r\n    content: \"笔记\",\r\n    kind: \"reading\",\r\n    status: \"confirmed\",\r\n    confirmed: true,\r\n    sources: [],\r\n    version: 1,\r\n    createdAt: updatedAt,\r\n    updatedAt,\r\n  };\r\n}\r\n\r\nfunction edge(changes: Partial<GraphEdge> = {}): GraphEdge {\r\n  return {\r\n    id: \"edge\",\r\n    source: \"paper\",\r\n    target: \"concept\",\r\n    kind: \"mentions\",\r\n    label: \"涉及\",\r\n    status: \"confirmed\",\r\n    origin: \"user\",\r\n    evidence: [{ paperId: \"visible\", page: 1 }],\r\n    rationale: \"原文\",\r\n    version: 1,\r\n    createdAt: \"2026-10-01T00:00:00Z\",\r\n    updatedAt: \"2026-10-01T00:00:00Z\",\r\n    ...changes,\r\n  };\r\n}\r\n\r\ndescribe(\"homepage local previews\", () => {\r\n  it(\"searches real metadata using normalized terms and never returns trashed papers\", () => {\r\n    const papers = [\r\n      paper(\"first\", {\r\n        title: \"AI 与课堂研究\",\r\n        authors: \"Alice Wang\",\r\n        tags: [\"方法\"],\r\n      }),\r\n      paper(\"trashed\", {\r\n        title: \"AI 与课堂研究\",\r\n        authors: \"Alice Wang\",\r\n        tags: [\"方法\"],\r\n        trashedAt: \"2026-10-30T00:00:00Z\",\r\n      }),\r\n      paper(\"other\", { title: \"AI 的历史\" }),\r\n    ];\r\n    const before = JSON.stringify(papers);\r\n    expect(\r\n      searchHomePapers(papers, \"  ＡＩ Alice 方法  \").map((p) => p.id),\r\n    ).toEqual([\"first\"]);\r\n    expect(searchHomePapers(papers, \"未导入的论文\")).toEqual([]);\r\n    expect(JSON.stringify(papers)).toBe(before);\r\n  });\r\n\r\n  it(\"orders latest real papers and notes without mutating or revealing unavailable notes\", () => {\r\n    const papers = [\r\n      paper(\"older\"),\r\n      paper(\"newer\", { updatedAt: \"2026-10-20T00:00:00Z\" }),\r\n      paper(\"hidden\", { trashedAt: \"2026-10-31T00:00:00Z\" }),\r\n    ];\r\n    const notes = [\r\n      note(\"old\", \"older\", \"2026-10-01T00:00:00Z\"),\r\n      note(\"hidden-note\", \"hidden\", \"2026-10-31T00:00:00Z\"),\r\n      note(\"missing-paper\", \"missing\", \"2026-10-31T00:00:00Z\"),\r\n      note(\"new\", \"newer\", \"2026-10-20T00:00:00Z\"),\r\n    ];\r\n    const before = JSON.stringify({ papers, notes });\r\n    expect(searchHomePapers(papers, \"\").map((p) => p.id)).toEqual([\r\n      \"newer\",\r\n      \"older\",\r\n    ]);\r\n    expect(recentHomeNotes(notes, papers).map((n) => n.id)).toEqual([\r\n      \"new\",\r\n      \"old\",\r\n    ]);\r\n    expect(JSON.stringify({ papers, notes })).toBe(before);\r\n  });\r\n\r\n  it(\"only previews actual concepts with confirmed current evidence from visible papers\", () => {\r\n    const papers = [paper(\"visible\"), paper(\"hidden\", { trashedAt: \"today\" })];\r\n    const graph: ResearchGraph = {\r\n      version: 1,\r\n      nodes: [\r\n        {\r\n          id: \"paper\",\r\n          kind: \"paper\",\r\n          label: \"论文\",\r\n          title: \"论文\",\r\n          paperId: \"visible\",\r\n        },\r\n        {\r\n          id: \"concept\",\r\n          kind: \"concept\",\r\n          label: \"课堂互动\",\r\n          title: \"课堂互动\",\r\n        },\r\n        {\r\n          id: \"unsupported\",\r\n          kind: \"concept\",\r\n          label: \"未确认\",\r\n          title: \"未确认\",\r\n        },\r\n      ],\r\n      edges: [edge()],\r\n    };\r\n    expect(homeGraphConcepts(graph, papers).map((node) => node.id)).toEqual([\r\n      \"concept\",\r\n    ]);\r\n    for (const changes of [\r\n      { status: \"candidate\" as const },\r\n      { status: \"rejected\" as const },\r\n      { stale: true },\r\n      { evidence: [] },\r\n      { evidence: [{ paperId: \"hidden\", page: 1 }] },\r\n      { evidence: [{ paperId: \"missing\", page: 1 }] },\r\n      { evidence: [{ paperId: \"visible\", contentRevision: \"previous-file\" }] },\r\n      { evidence: [{ url: \"https://example.com\" }] },\r\n      { evidence: [{ paperId: \"visible\" }, { paperId: \"hidden\" }] },\r\n    ]) {\r\n      expect(\r\n        homeGraphConcepts({ ...graph, edges: [edge(changes)] }, papers),\r\n      ).toEqual([]);\r\n    }\r\n    expect(homeGraphConcepts(undefined, papers)).toEqual([]);\r\n  });\r\n});\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\tests\\lib\\research-learning-input.test.ts","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (374). Maximum allowed is 50.","line":100,"column":51,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":478,"endColumn":2},{"ruleId":"max-lines-per-function","severity":1,"message":"Async arrow function has too many lines (63). Maximum allowed is 50.","line":208,"column":104,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":270,"endColumn":4},{"ruleId":"max-lines-per-function","severity":1,"message":"Async arrow function has too many lines (75). Maximum allowed is 50.","line":272,"column":98,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":346,"endColumn":4},{"ruleId":"max-lines-per-function","severity":1,"message":"Async arrow function has too many lines (76). Maximum allowed is 50.","line":402,"column":104,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":477,"endColumn":4}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import fs from \"node:fs\";\r\nimport os from \"node:os\";\r\nimport path from \"node:path\";\r\nimport { PDFDocument, StandardFonts } from \"pdf-lib\";\r\nimport { afterEach, beforeEach, describe, expect, it, vi } from \"vitest\";\r\nimport { closeIndex } from \"@/lib/library/index-db\";\r\nimport {\r\n  buildResearchContext,\r\n  canReuseResearchSession,\r\n  researchContextScope,\r\n  researchSourcePaperIds,\r\n} from \"@/lib/research/context-scope\";\r\nimport { prepareLearningInput } from \"@/lib/research/learning-input\";\r\nimport { prepareQuestionInput } from \"@/lib/research/discussion/input\";\r\nimport { learningSchema } from \"@/lib/research/learning-schema\";\r\nimport type { LearningRequest } from \"@/lib/research/learning-types\";\r\nimport { createAnnotation } from \"@/lib/research/pdf\";\r\nimport {\r\n  restoreResearchPaper,\r\n  trashResearchPaper,\r\n} from \"@/lib/research/paper-lifecycle\";\r\nimport {\r\n  createNote,\r\n  digest,\r\n  importPaper,\r\n  paperById,\r\n  researchContext,\r\n  saveKnowledge,\r\n  updateNote,\r\n} from \"@/lib/research/store\";\r\nimport type {\r\n  ResearchPaper,\r\n  ResearchRun,\r\n  ResearchSelection,\r\n  StartResearchRunInput,\r\n} from \"@/lib/research/types\";\r\n\r\nlet root: string;\r\nbeforeEach(() => {\r\n  root = fs.mkdtempSync(path.join(os.tmpdir(), \"research-learning-\"));\r\n  vi.stubEnv(\"PAPERNOOK_DATA_DIR\", root);\r\n  vi.stubEnv(\"RESEARCH_DATA_DIR\", path.join(root, \"research\"));\r\n  vi.stubEnv(\"NODE_ENV\", \"test\");\r\n});\r\nafterEach(() => {\r\n  closeIndex();\r\n  vi.unstubAllEnvs();\r\n  fs.rmSync(root, { recursive: true, force: true });\r\n});\r\n\r\nasync function fixture(title = \"Learning paper\"): Promise<ResearchPaper> {\r\n  const document = await PDFDocument.create();\r\n  document.setTitle(title);\r\n  const font = await document.embedFont(StandardFonts.Helvetica);\r\n  const pages = [\r\n    {\r\n      page: 1,\r\n      text: \"Selected evidence. Another selected passage. UNSELECTED-PAGE-ONE-CONTENT\",\r\n    },\r\n    { page: 2, text: \"SOURCE-PAGE-TWO: evidence and limits\" },\r\n    { page: 3, text: \"UNRELATED-PAGE-THREE\" },\r\n  ];\r\n  for (const page of pages)\r\n    document\r\n      .addPage([600, 800])\r\n      .drawText(page.text, { x: 30, y: 700, font, size: 8 });\r\n  return importPaper({\r\n    bytes: await document.save(),\r\n    filename: title + \".pdf\",\r\n    title,\r\n    pages,\r\n    contentRevision: digest(pages),\r\n  });\r\n}\r\nfunction input(\r\n  paper: ResearchPaper,\r\n  learning: LearningRequest,\r\n  selection?: ResearchSelection,\r\n): StartResearchRunInput {\r\n  return {\r\n    paperId: paper.id,\r\n    answerStyle: \"grounded\",\r\n    mode: \"ask\",\r\n    question: \"An old UI question that should be replaced\",\r\n    learning,\r\n    selection,\r\n    context: researchContext(paper.id),\r\n  };\r\n}\r\nfunction errorStatus(operation: () => unknown): number | undefined {\r\n  try {\r\n    operation();\r\n  } catch (error) {\r\n    return error && typeof error === \"object\" && \"status\" in error\r\n      ? Number(error.status)\r\n      : undefined;\r\n  }\r\n}\r\n\r\ndescribe(\"explicit learning material boundaries\", () => {\r\n  it(\"lets a free explanation use relevant concepts and real surrounding passages without a fixed template\", async () => {\r\n    const paper = await fixture();\r\n    const concept = await saveKnowledge({\r\n      title: \"证据判断\",\r\n      aliases: [\"Selected evidence\"],\r\n      body: \"区分可观察证据与解释推断。\",\r\n    });\r\n    const raw = input(\r\n      paper,\r\n      { task: \"explain\", source: { kind: \"selection\" } },\r\n      {\r\n        page: 1,\r\n        text: \"Selected evidence.\",\r\n        contentRevision: paper.contentRevision,\r\n      },\r\n    );\r\n    raw.answerStyle = \"discussion\";\r\n    raw.referenceConceptIds = [concept.id];\r\n    const prepared = prepareLearningInput(prepareQuestionInput(raw));\r\n    const packet = buildResearchContext(prepared);\r\n    expect(prepared.answerStyle).toBe(\"discussion\");\r\n    expect(prepared.question).not.toContain(\"120至220字\");\r\n    expect(prepared.question).not.toContain(\"只使用本次提供\");\r\n    expect(\r\n      prepared.context.knowledge.some((entry) => entry.id === concept.id),\r\n    ).toBe(true);\r\n    expect(packet.education_library.map((entry) => entry.id)).toEqual([\r\n      concept.id,\r\n    ]);\r\n    expect(packet.paper_pages).toContain(\"Another selected passage.\");\r\n    expect(packet.provided_pages).toContain(1);\r\n  });\r\n  it(\"validates normal question selections and explicit concept IDs before invoking a provider\", async () => {\r\n    const paper = await fixture();\r\n    const raw: StartResearchRunInput = {\r\n      paperId: paper.id,\r\n      mode: \"ask\",\r\n      question: \"What does this imply?\",\r\n      selection: { page: 1, text: \"Selected evidence.\" },\r\n      context: researchContext(paper.id),\r\n    };\r\n    expect(prepareQuestionInput(raw).selection?.contentRevision).toBe(\r\n      paper.contentRevision,\r\n    );\r\n    expect(\r\n      errorStatus(() =>\r\n        prepareQuestionInput({\r\n          ...raw,\r\n          referenceConceptIds: [\"missing-concept\"],\r\n        }),\r\n      ),\r\n    ).toBe(404);\r\n    expect(\r\n      errorStatus(() =>\r\n        prepareQuestionInput({\r\n          ...raw,\r\n          selection: { page: 2, text: \"Selected evidence.\" },\r\n        }),\r\n      ),\r\n    ).toBe(400);\r\n    expect(\r\n      errorStatus(() =>\r\n        prepareQuestionInput({\r\n          ...raw,\r\n          selection: {\r\n            page: 1,\r\n            text: \"Selected evidence.\",\r\n            contentRevision: \"old\",\r\n          },\r\n        }),\r\n      ),\r\n    ).toBe(409);\r\n  });\r\n  it(\"sends only selected text and clears unrelated notes, knowledge and related papers\", async () => {\r\n    const paper = await fixture();\r\n    await createNote({\r\n      paperId: paper.id,\r\n      title: \"Unselected note\",\r\n      body: \"UNSELECTED-NOTE-CONTENT\",\r\n      confirmed: true,\r\n    });\r\n    const prepared = prepareLearningInput(\r\n      input(\r\n        paper,\r\n        { task: \"explain\", source: { kind: \"selection\" }, detail: \"brief\" },\r\n        {\r\n          page: 1,\r\n          text: \"Selected evidence.\",\r\n          contentRevision: paper.contentRevision,\r\n        },\r\n      ),\r\n    );\r\n    expect(prepared.context.pages).toEqual([\r\n      { page: 1, text: \"Selected evidence.\" },\r\n    ]);\r\n    const packet = buildResearchContext(prepared);\r\n    expect(packet.confirmed_notes).toEqual([]);\r\n    expect(packet.education_library).toEqual([]);\r\n    expect(packet.related_papers).toEqual([]);\r\n    expect(packet.paper_pages).toBe(\"\\n[p.1]\\nSelected evidence.\");\r\n    expect(JSON.stringify(packet)).not.toContain(\"UNSELECTED-PAGE-ONE-CONTENT\");\r\n    expect(JSON.stringify(packet)).not.toContain(\"UNRELATED-PAGE-THREE\");\r\n    expect(JSON.stringify(packet)).not.toContain(\"UNSELECTED-NOTE-CONTENT\");\r\n    expect(prepared.question).toContain(\"120至220字\");\r\n    expect(prepared.sourcePaperIds).toEqual([paper.id]);\r\n  });\r\n\r\n  it(\"uses only the requested note and its source pages, and rejects a stale version or foreign note\", async () => {\r\n    const paper = await fixture();\r\n    const other = await fixture(\"Other paper\");\r\n    const selected = await createNote({\r\n      paperId: paper.id,\r\n      title: \"Selected note\",\r\n      body: \"ONLY-THIS-NOTE\",\r\n      sources: [{ paperId: paper.id, page: 2 }],\r\n    });\r\n    await createNote({\r\n      paperId: paper.id,\r\n      title: \"Other note\",\r\n      body: \"DO-NOT-SEND-THIS-NOTE\",\r\n      confirmed: true,\r\n    });\r\n    const foreign = await createNote({\r\n      paperId: other.id,\r\n      title: \"Wrong note\",\r\n      body: \"WRONG-PAPER-NOTE\",\r\n    });\r\n    const raw = input(\r\n      paper,\r\n      {\r\n        task: \"quiz\",\r\n        count: 3,\r\n        source: {\r\n          kind: \"note\",\r\n          noteId: selected.id,\r\n          version: selected.version,\r\n        },\r\n      },\r\n      { page: 1, text: \"Selected evidence.\" },\r\n    );\r\n    const prepared = prepareLearningInput(raw);\r\n    const packet = buildResearchContext(prepared);\r\n    expect(prepared.selection).toBeUndefined();\r\n    expect(prepared.context.studyMaterials?.map((value) => value.body)).toEqual(\r\n      [\"ONLY-THIS-NOTE\"],\r\n    );\r\n    expect(packet.paper_pages).toContain(\"SOURCE-PAGE-TWO\");\r\n    expect(packet.paper_pages).not.toContain(\"UNSELECTED-PAGE-ONE-CONTENT\");\r\n    expect(JSON.stringify(packet)).not.toContain(\"DO-NOT-SEND-THIS-NOTE\");\r\n    expect(prepared.question).toContain(\"生成3道\");\r\n    await updateNote(selected.id, {\r\n      body: \"Changed since select