{\r\n    await fs.rm(tempPath, { force: true }).catch(() => undefined);\r\n  }\r\n}\r\n\r\nasync function withPdfWriteLock<T>(\r\n  topic: string,\r\n  slug: string,\r\n  operation: (pdfPath: string) => Promise<T>,\r\n  kind: PdfKind = \"paper\",\r\n): Promise<T> {\r\n  const file = paperPdfPath(topic, slug, kind);\r\n  if (!file) throw new PdfFileError(`Unknown paper ${topic}/${slug}`);\r\n\r\n  try {\r\n    return await withFilesystemLock(\r\n      \"pdf\",\r\n      kind === \"paper\" ? `${topic}/${slug}` : `${topic}/${slug}/exercises`,\r\n      PDF_LOCK_WAIT_MS,\r\n      () => operation(file),\r\n    );\r\n  } catch (error) {\r\n    if (error instanceof FilesystemBusyError) {\r\n      throw new PdfBusyError(\r\n        \"Another PDF operation is still running. Try again in a moment.\",\r\n      );\r\n    }\r\n    throw error;\r\n  }\r\n}\r\n\r\n/** Enrol a verified, atomically imported PDF in the same recent-write tracking\r\n * used by replacePdf/rewritePdf. This is called only by the initial importer,\r\n * after its bytes and companion metadata have been committed. */\r\nexport async function registerInitialPdfWrite(\r\n  topic: string,\r\n  slug: string,\r\n  expectedEtag: string,\r\n): Promise<void> {\r\n  await withPdfWriteLock(topic, slug, async (file) => {\r\n    const current = await readStableFile(file);\r\n    if (current.etag !== expectedEtag)\r\n      throw new PdfConflictError(\r\n        \"The PDF changed while it was being imported.\",\r\n      );\r\n    recentAppWrites.set(file, { etag: current.etag, writtenAt: Date.now() });\r\n  });\r\n}\r\n\r\nexport async function replacePdf(\r\n  topic: string,\r\n  slug: string,\r\n  expectedEtag: string | null,\r\n  bytes: Uint8Array,\r\n  commit?: (operation: () => void) => void,\r\n  kind: PdfKind = \"paper\",\r\n): Promise<{ etag: string }> {\r\n  assertWritablePdf(bytes);\r\n\r\n  return withPdfWriteLock(\r\n    topic,\r\n    slug,\r\n    async (pdfPath) => {\r\n      const current = await fs.readFile(