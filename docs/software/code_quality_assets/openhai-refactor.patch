Style): void;\r\n  onConcepts(ids: string[] | undefined): void;\r\n}) {\r\n  const menu = useRef<HTMLDetailsElement>(null);\r\n  useEffect(() => {\r\n    const close = (event: PointerEvent) => {\r\n      if (\r\n        event.target instanceof Node &&\r\n        menu.current &&\r\n        !menu.current.contains(event.target)\r\n      )\r\n        menu.current.open = false;\r\n    };\r\n    document.addEventListener(\"pointerdown\", close);\r\n    return () => document.removeEventListener(\"pointerdown\", close);\r\n  }, []);\r\n  const chosen = pickReferenceConcepts(knowledge, query, referenceConceptIds);\r\n  const ids = chosen.map((entry) => entry.id);\r\n  return (\r\n    <div className={styles.controls}>\r\n      <div className={styles.row}>\r\n        <strong title=\"可以结合模型知识讨论、解释和举例；论文引用仍需原文依据。\">\r\n          {answerStyle === \"discussion\" ? \"自由讨论\" : \"原文核对\"}\r\n        </strong>\r\n        <details\r\n          hidden={answerStyle === \"grounded\"}\r\n          ref={menu}\r\n          className={styles.concepts}\r\n          onKeyDown={(event) => {\r\n            if (event.key === \"Escape\" && menu.current) {\r\n              event.preventDefault();\r\n              menu.current.open = false;\r\n              menu.current.querySelector(\"summary\")?.focus();\r\n            }\r\n          }}\r\n        >\r\n          <summary aria-label=\"选择参考概念\">\r\n            概念{chosen.length ? ` ${chosen.length}` : \"\"}\r\n            <ChevronDown size={11} />\r\n          </summary>\r\n          <div className={styles.options}>\r\n            <div className={styles.optionTools}>\r\n              <button\r\n                type=\"button\"\r\n                aria-pressed={referenceConceptIds === undefined}\r\n                onClick={() => onConcepts(undefined)}\r\n              >\r\n                自动匹配\r\n              </button>\r\n              <button\r\n                type=\"button\"\r\n                aria-pressed={referenceConceptIds?.length === 0}\r\n                onClick={() => onConcepts([])}\r\n              >\r\n                不参考\r\n              </button>\r\n            </div>\r\n            {knowledge.map((entry) => (\r\n              <label key={entry.id}>\r\n                <input\r\n                  type=\"checkbox\"\r\n                  checked={ids.includes(entry.id)}\r\n                  disabled={!ids.includes(entry.id) && ids.length >= 4}\r\n                  onChange={(event) =>\r\n                    onConcepts(\r\n                      event.target.checked\r\n                        ? [...ids, entry.id]\r\n                        : ids.filter((id) => id !== entry.id),\r\n                    )\r\n                  }\r\n                />\r\n                <span>{entry.title}</span>\r\n              </label>\r\n            ))}\r\n            {!knowledge.length && <p>概念库暂无条目。</p>}\r\n            <small>最多参考 4 个概念</small>\r\n          </div>\r\n        </details>\r\n        <label\r\n          className={styles.strict}\r\n          title=\"开启后，仅依据所选论文和笔记回答。\"\r\n        >\r\n          <input\r\n            type=\"checkbox\"\r\n            checked={answerStyle === \"grounded\"}\r\n            onChange={(event) =>\r\n              onStyle(event.target.checked ? \"grounded\" : \"discussion\")\r\n            }\r\n          />\r\n          仅依据原文\r\n        </label>\r\n      </div>\r\n      {answerStyle === \"discussion\" && !!chosen.length && (\r\n        <div className={styles.chips} aria-label=\"本次参考概念\">\r\n          {chosen.map((entry) => (\r\n            <span key={entry.id}>\r\n              {entry.title}\r\n              <button\r\n                type=\"button\"\r\n                aria-label={`移除参考概念 ${entry.title}`}\r\n                onClick={() => onConcepts(ids.filter((id) => id !== entry.id))}\r\n              >\r\n                <X size={10} />\r\n              </button>\r\n            </span>\r\n          ))}\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\qa\\discussion\\ReaderConversation.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\qa\\discussion\\discussion-note.ts","messages":[{"ruleId":"complexity","severity":1,"message":"Function 'discussionNote' has a complexity of 13. Maximum allowed is 10.","line":9,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":9,"endColumn":31}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type {\r\n  ResearchPaper,\r\n  ResearchRun,\r\n  SourceRef,\r\n} from \"@/lib/research/types\";\r\nimport { responseSources } from \"../../reader-context\";\r\nimport { runContextMetadata } from \"../run-context\";\r\n\r\nexport function discussionNote(\r\n  run: ResearchRun,\r\n  paper: ResearchPaper,\r\n  answer = run.answer,\r\n) {\r\n  const metadata = runContextMetadata(run);\r\n  const quote = run.selection?.quote || run.selection?.text;\r\n  const sources: SourceRef[] = responseSources(answer, {\r\n    ...paper,\r\n    contentRevision: run.contentRevision ?? paper.contentRevision,\r\n  });\r\n  if (quote && run.selection)\r\n    sources.unshift({\r\n      paperId: paper.id,\r\n      page: run.selection.page,\r\n      quote,\r\n      contentRevision: run.contentRevision ?? run.selection.contentRevision,\r\n      title: paper.title,\r\n    });\r\n  const body = [\r\n    quote\r\n      ? `## 原文\\n\\n${quote\r\n          .split(/\\r?\\n/)\r\n          .map((line) => \"> \" + line)\r\n          .join(\r\n            \"\\n\",\r\n          )}\\n\\n[返回原文第 ${run.selection?.page} 页](/workspace?paperId=${paper.id}&page=${run.selection?.page})`\r\n      : \"\",\r\n    `## 问题\\n\\n${metadata.question}`,\r\n    `## ${run.answerStyle === \"discussion\" ? \"阅读讨论\" : \"回答\"}\\n\\n${answer}`,\r\n    \"## 我的思考\\n\\n\",\r\n  ]\r\n    .filter(Boolean)\r\n    .join(\"\\n\\n\");\r\n  return {\r\n    body,\r\n    sources: sources.filter(\r\n      (source, index) =>\r\n        sources.findIndex(\r\n          (entry) =>\r\n            entry.paperId === source.paperId && entry.page === source.page,\r\n        ) === index,\r\n    ),\r\n  };\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\qa\\discussion\\passage-thread.ts","messages":[{"ruleId":"complexity","severity":1,"message":"Function 'findPassageDiscussion' has a complexity of 26. Maximum allowed is 10.","line":15,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":15,"endColumn":38}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type {\r\n  AnswerStyle,\r\n  ResearchPaper,\r\n  ResearchRun,\r\n  ResearchSelection,\r\n} from \"@/lib/research/types\";\r\n\r\nfunction passageText(selection: ResearchSelection): string {\r\n  return (selection.quote?.trim() || selection.text || \"\")\r\n    .normalize(\"NFKC\")\r\n    .replace(/\\s+/g, \"\");\r\n}\r\n\r\n/** Restore only a completed discussion bound to this exact passage and source version. */\r\nexport function findPassageDiscussion(\r\n  history: ResearchRun[],\r\n  paper: ResearchPaper,\r\n  selection: ResearchSelection | null,\r\n  answerStyle: AnswerStyle,\r\n  referenceConceptIds?: string[],\r\n): ResearchRun | null {\r\n  if (\r\n    !selection ||\r\n    (selection.contentRevision &&\r\n      selection.contentRevision !== paper.contentRevision)\r\n  )\r\n    return null;\r\n  const quote = passageText(selection);\r\n  if (!quote) return null;\r\n  const concepts = referenceConceptIds\r\n    ? JSON.stringify([...referenceConceptIds].sort())\r\n    : undefined;\r\n  let latest: ResearchRun | null = null;\r\n  let latestTime = Number.NEGATIVE_INFINITY;\r\n  for (const entry of history) {\r\n    if (\r\n      entry.paperId !== paper.id ||\r\n      !entry.contentRevision ||\r\n      entry.contentRevision !== paper.contentRevision ||\r\n      !entry.selection ||\r\n      (entry.selection.contentRevision &&\r\n        entry.selection.contentRevision !== paper.contentRevision) ||\r\n      entry.selection.page !== selection.page ||\r\n      passageText(entry.selection) !== quote ||\r\n      entry.mode !== \"ask\" ||\r\n      entry.status !== \"completed\" ||\r\n      (entry.learning && entry.learning.task !== \"explain\") ||\r\n      (entry.answerStyle ?? \"grounded\") !== answerStyle ||\r\n      (concepts !== undefined &&\r\n        JSON.stringify([...(entry.referenceConceptIds ?? [])].sort()) !==\r\n          concepts)\r\n    )\r\n      continue;\r\n    const timestamp = Date.parse(entry.createdAt);\r\n    if (Number.isFinite(timestamp) && timestamp > latestTime) {\r\n      latest = entry;\r\n      latestTime = timestamp;\r\n    }\r\n  }\r\n  return latest;\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\qa\\question-draft.ts","messages":[{"ruleId":"complexity","severity":1,"message":"Function 'readQuestionDraft' has a complexity of 12. Maximum allowed is 10.","line":44,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":44,"endColumn":34}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { z } from \"zod\";\r\nimport { idSchema, runSchema } from \"@/lib/research/schemas\";\r\nimport type { AnswerStyle, ResearchSelection } from \"@/lib/research/types\";\r\n\r\nexport interface QuestionInput {\r\n  question: string;\r\n  selection: ResearchSelection | null;\r\n  sourcePaperIds: string[];\r\n  answerStyle?: AnswerStyle;\r\n  referenceConceptIds?: string[];\r\n}\r\nconst storedQuestion = z.object({\r\n  schema: z.literal(1),\r\n  paperId: idSchema,\r\n  contentRevision: z.string(),\r\n  question: z.string().max(30000),\r\n  selection: runSchema.shape.selection.nullable(),\r\n  sourcePaperIds: z.array(idSchema).max(4),\r\n  answerStyle: z.enum([\"discussion\", \"grounded\"]).optional(),\r\n  referenceConceptIds: z.array(idSchema).max(4).optional(),\r\n});\r\nexport function questionDraftKey(paperId: string) {\r\n  return \"jiaoyan:question-draft:v1:\" + paperId;\r\n}\r\nexport function questionSignature(input: QuestionInput): string {\r\n  const selected = input.selection;\r\n  return JSON.stringify({\r\n    question: input.question,\r\n    sources: [...input.sourcePaperIds].sort(),\r\n    answerStyle: input.answerStyle ?? \"discussion\",\r\n    concepts: input.referenceConceptIds\r\n      ? [...input.referenceConceptIds].sort()\r\n      : \"auto\",\r\n    selection: selected\r\n      ? {\r\n          page: selected.page,\r\n          text: selected.text,\r\n          quote: selected.quote,\r\n          revision: selected.contentRevision,\r\n        }\r\n      : null,\r\n  });\r\n}\r\nexport function readQuestionDraft(\r\n  raw: string | null,\r\n  paperId: string,\r\n  contentRevision: string,\r\n): { input: QuestionInput; sourceChanged: boolean } | null {\r\n  if (!raw) return null;\r\n  let value: unknown;\r\n  try {\r\n    value = JSON.parse(raw);\r\n  } catch {\r\n    return null;\r\n  }\r\n  const parsed = storedQuestion.safeParse(value);\r\n  if (\r\n    !parsed.success ||\r\n    parsed.data.paperId !== paperId ||\r\n    !parsed.data.question.trim()\r\n  )\r\n    return null;\r\n  const record = parsed.data;\r\n  const sourceChanged =\r\n    !!record.selection &&\r\n    (record.contentRevision !== contentRevision ||\r\n      record.selection.contentRevision !== contentRevision);\r\n  return {\r\n    input: {\r\n      question: record.question,\r\n      selection: sourceChanged ? null : (record.selection ?? null),\r\n      sourcePaperIds: record.sourcePaperIds,\r\n      ...(record.answerStyle ? { answerStyle: record.answerStyle } : {}),\r\n      ...(record.referenceConceptIds\r\n        ? { referenceConceptIds: record.referenceConceptIds }\r\n        : {}),\r\n    },\r\n    sourceChanged,\r\n  };\r\n}\r\nexport function writeQuestionDraft(\r\n  storage: Pick<Storage, \"setItem\" | \"removeItem\">,\r\n  paperId: string,\r\n  contentRevision: string,\r\n  input: QuestionInput,\r\n) {\r\n  const key = questionDraftKey(paperId);\r\n  if (!input.question.trim()) storage.removeItem(key);\r\n  else\r\n    storage.setItem(\r\n      key,\r\n      JSON.stringify({ schema: 1, paperId, contentRevision, ...input }),\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\qa\\run-context.ts","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'runContextMetadata' has too many lines (55). Maximum allowed is 50.","line":225,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":280,"endColumn":2}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { learningTitle } from \"@/lib/research/learning-types\";\nimport type { ResearchPaper, ResearchRun } from \"@/lib/research/types\";\nimport { studyLabel, studyPurpose } from \"../study/frameworks\";\n\ntype SavedScope = { policy?: string; sources?: string[] };\n\nfunction savedScope(value?: string): SavedScope {\n  if (!value) return {};\n  try {\n    const parsed: unknown = JSON.parse(value);\n    if (!parsed || typeof parsed !== \"object\") return {};\n    const record = parsed as Record<string, unknown>;\n    return {\n      policy: typeof record.policy === \"string\" ? record.policy : undefined,\n      sources:\n        Array.isArray(record.sources) &&\n        record.sources.every((id) => typeof id === \"string\" && !!id)\n          ? (record.sources as string[])\n          : undefined,\n    };\n  } catch {\n    return {};\n  }\n}\n\nfunction visibleQuestion(run: ResearchRun) {\n  if (run.learning) return learningTitle(run.learning);\n  const purpose = studyPurpose(run.question);\n  if (purpose) return purpose + \" · \" + studyLabel(run.question);\n  if (/^\\s*\\[学习讲解\\]/.test(run.question)) return \"解释选文\";\n  if (/^\\s*\\[理解反馈\\]/.test(run.question)) return \"检查我的理解\";\n  return run.question;\n}\n\nfunction suppliedSourceIds(run: ResearchRun): string[] | undefined {\n  return Array.isArray(run.sourcePaperIds) ? run.sourcePaperIds : undefined;\n}\n\nfunction recordedSourceIds(run: ResearchRun): string[] {\n  const supplied = suppliedSourceIds(run);\n  return [\n    ...new Set(supplied?.filter((id) => typeof id === \"string\" && !!id) ?? []),\n  ];\n}\n\nfunction hasKnownScopePolicy(scope: SavedScope): boolean {\n  return [\n    \"explicit-source-scope-v4\",\n    \"explicit-source-scope-v5\",\n    \"explicit-source-scope-v6\",\n  ].includes(scope.policy ?? \"\");\n}\n\nfunction sourcesAreComplete(\n  run: ResearchRun,\n  scope: SavedScope,\n  recordedIds: string[],\n): boolean {\n  if (!hasKnownScopePolicy(scope)) return false;\n  const scopedIds = scope.sources ?? [];\n  const supplied = suppliedSourceIds(run);\n  if (!scopedIds.length || new Set(scopedIds).size !== scopedIds.length)\n    return false;\n  if (!supplied?.length || supplied.length !== recordedIds.length) return false;\n  if (!recordedIds.includes(run.paperId)) return false;\n  if (scopedIds.length !== recordedIds.length) return false;\n  return scopedIds.every((id) => recordedIds.includes(id));\n}\n\nfunction availablePapers(\n  run: ResearchRun,\n  paper?: ResearchPaper,\n  papers: ResearchPaper[] = [],\n): Map<string, ResearchPaper> {\n  return new Map(\n    [...papers, ...(paper?.id === run.paperId ? [paper] : [])]\n      .filter((item) => !item.trashedAt)\n      .map((item) => [item.id, item]),\n  );\n}\n\nfunction savedSelectionPage(run: ResearchRun): number | undefined {\n  const page = run.selection?.page;\n  return page && Number.isInteger(page) && page > 0 ? page : undefined;\n}\n\nfunction versionMatchesCurrent(\n  run: ResearchRun,\n  current: ResearchPaper | undefined,\n  revision: string | undefined,\n): boolean {\n  return (\n    !!current &&\n    !!revision &&\n    revision === current.contentRevision &&\n    (!run.selection?.contentRevision ||\n      run.selection.contentRevision === current.contentRevision)\n  );\n}\n\nfunction sourceScopeLabel(\n  run: ResearchRun,\n  selected: boolean,\n  selectionPage: number | undefined,\n  materialKind: string | undefined,\n  legacyRangeMissing: boolean,\n): string {\n  if (selected) {\n    return selectionPage ? `选文 · 第${selectionPage}页` : \"选文 · 页码未保存\";\n  }\n  if (materialKind === \"note\") return \"已保存笔记\";\n  if (materialKind === \"annotations\") {\n    const ids =\n      run.learning?.source.kind === \"annotations\"\n        ? run.learning.source.ids\n        : [];\n    return `所选批注 · ${new Set(ids).size}条`;\n  }\n  if (legacyRangeMissing) return \"范围未完整保存\";\n  return run.answerStyle === \"discussion\" ? \"按问题查阅原文\" : \"整篇论文\";\n}\n\ntype SourceState = {\n  sourceComplete: boolean;\n  sources: Array<{ paper?: ResearchPaper }>;\n  revision: string | undefined;\n  versionMatches: boolean;\n  selected: boolean;\n  selectionPage: number | undefined;\n  quote: string;\n  current: ResearchPaper | undefined;\n  legacyRangeMissing: boolean;\n  materialKind: string | undefined;\n};\n\nfunction selectionIsIncomplete(state: SourceState): boolean {\n  if (!state.selected) return false;\n  if (!state.selectionPage || !state.quote) return true;\n  return state.selectionPage > (state.current?.pageCount ?? 0);\n}\n\nfunction sourceRecordProblem(state: SourceState): string {\n  if (!state.sourceComplete) return \"来源记录不完整，请重新选择提问材料。\";\n  if (state.sources.some((source) => !source.paper))\n    return \"部分来源已不可用，请检查文献库或回收站。\";\n  if (!state.revision) return \"这条记录未保存原文版本，请重新选择来源。\";\n  if (!state.versionMatches) return \"原文已有更新，请重新选择来源。\";\n  return \"\";\n}\n\nfunction sourceBlockReason(state: SourceState): string {\n  const recordProblem = sourceRecordProblem(state);\n  if (recordProblem) return recordProblem;\n  if (selectionIsIncomplete(state))\n    return \"这条记录未保存完整选文，请重新选择原文。\";\n  if (state.legacyRangeMissing) return \"旧记录未保存选文范围，请重新选择来源。\";\n  if (state.materialKind === \"note\" || state.materialKind === \"annotations\")\n    return \"请在论文中核对笔记或批注版本后重新选择来源。\";\n  if (state.sources.length > 4) return \"请重新选择最多4篇论文作为提问来源。\";\n  const unreadySource = state.sources.some(\n    (source) => source.paper?.textStatus !== \"ready\",\n  );\n  if (unreadySource && !state.selected)\n    return \"部分来源正文暂不可用，请先检查论文解析结果。\";\n  return \"\";\n}\n\nfunction sourceNotice(\n  state: SourceState & { sourceComplete: boolean },\n): string {\n  if (state.current && state.revision && !state.versionMatches)\n    return \"显示当时的提问快照；原文已有更新。\";\n  if (state.selected && (!state.selectionPage || !state.quote))\n    return \"这条旧记录未保存完整选文，无法还原当时的范围。\";\n  if (state.legacyRangeMissing)\n    return \"这条旧记录未保存选文范围，无法确认当时是否使用了选文。\";\n  if (!state.sourceComplete) return \"这条记录的来源信息不完整。\";\n  return \"\";\n}\n\nfunction selectionQuote(run: ResearchRun): string {\n  return (run.selection?.quote || run.selection?.text || \"\").trim();\n}\n\nfunction selectionPresent(run: ResearchRun): boolean {\n  return !!run.selection || run.learning?.source.kind === \"selection\";\n}\n\nfunction legacyRangeMissing(run: ResearchRun, scope: SavedScope): boolean {\n  if (run.learning || run.selection) return false;\n  return ![\"explicit-source-scope-v5\", \"explicit-source-scope-v6\"].includes(\n    scope.policy ?? \"\",\n  );\n}\n\nfunction learningReflection(run: ResearchRun): string | undefined {\n  return run.learning?.task === \"understanding\"\n    ? run.learning.reflection\n    : undefined;\n}\n\nfunction sourceEntries(\n  available: Map<string, ResearchPaper>,\n  sourceIds: string[],\n  currentId: string,\n) {\n  return sourc