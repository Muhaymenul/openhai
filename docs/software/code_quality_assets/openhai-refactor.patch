@@ -0,0 +1,124 @@
+"""Offline tests for the streaming client that do not need a model server."""
+from __future__ import annotations
+
+import io
+import json
+import sys
+import urllib.error
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+import llm_client  # noqa: E402
+
+
+class FakeResponse:
+    def __init__(self, lines):
+        self.lines = lines
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *_args):
+        return False
+
+    def __iter__(self):
+        return iter(self.lines)
+
+
+def sse(*chunks):
+    return [("data: " + json.dumps(chunk)).encode("utf-8") for chunk in chunks] + [b"data: [DONE]"]
+
+
+def http_error(status, body=b"boom"):
+    return urllib.error.HTTPError("https://model.invalid/v1", status, "boom", {}, io.BytesIO(body))
+
+
+def test_stream_accumulates_text_and_merges_tool_calls(monkeypatch):
+    events = []
+    chunks = (
+        {"choices": [{"delta": {"content": "你"}}]},
+        {"choices": [{"delta": {"content": "好", "tool_calls": [
+            {"index": 0, "id": "call_1", "function": {"name": "read_paper_text", "arguments": '{"page":'}}]}}]},
+        {"choices": [{"delta": {"tool_calls": [
+            {"index": 0, "function": {"arguments": "2}"}}]}, "finish_reason": "tool_calls"}]},
+    )
+    monkeypatch.setattr(llm_client, "_request", lambda *args, **kwargs: FakeResponse(sse(*chunks)))
+
+    stream = llm_client.stream_chat("https://model.invalid/v1", "key", "model", [], on_event=events.append, attempts=1)
+
+    assert stream.text == "你好"
+    assert stream.finish_reason == "tool_calls"
+    assert stream.tool_calls == [{"id": "call_1", "name": "read_paper_text", "arguments": '{"page":2}'}]
+    assert events == [{"kind": "token", "text": "你"}, {"kind": "token", "text": "好"}]
+
+
+def test_stream_rejects_an_invalid_json_frame(monkeypatch):
+    monkeypatch.setattr(llm_client, "_request", lambda *args, **kwargs: FakeResponse([b"data: not-json", b"data: [DONE]"]))
+
+    with pytest.raises(llm_client.LlmError) as failure:
+        llm_client.stream_chat("https://model.invalid/v1", "key", "model", [], attempts=1)
+
+    assert failure.value.kind == "protocol"
+
+
+def test_stream_maps_error_chunks_and_redacts_secrets(monkeypatch):
+    chunk = {"error": {"message": "bad key sk-secret12345678"}}
+    monkeypatch.setattr(llm_client, "_request", lambda *args, **kwargs: FakeResponse(sse(chunk)))
+
+    with pytest.raises(llm_client.LlmError) as failure:
+        llm_client.stream_chat("https://model.invalid/v1", "key", "model", [], attempts=1)
+
+    assert failure.value.kind == "http"
+    assert "sk-" not in failure.value.message
+
+
+def test_stream_retries_before_the_first_token(monkeypatch):
+    calls = {"count": 0}
+
+    def request(*_args, **_kwargs):
+        calls["count"] += 1
+        if calls["count"] == 1:
+            raise http_error(500)
+        return FakeResponse(sse({"choices": [{"delta": {"content": "ok"}}]}))
+
+    monkeypatch.setattr(llm_client, "_request", request)
+    monkeypatch.setattr(llm_client, "_sleep_before_retry", lambda *_args: None)
+
+    stream = llm_client.stream_chat("https://model.invalid/v1", "key", "model", [], attempts=2)
+
+    assert stream.text == "ok"
+    assert calls["count"] == 2
+
+
+def test_stream_does_not_retry_an_auth_failure(monkeypatch):
+    calls = {"count": 0}
+
+    def request(*_args, **_kwargs):
+        calls["count"] += 1
+        raise http_error(401)
+
+    monkeypatch.setattr(llm_client, "_request", request)
+
+    with pytest.raises(llm_client.LlmError) as failure:
+        llm_client.stream_chat("https://model.invalid/v1", "key", "model", [], attempts=3)
+
+    assert failure.value.kind == "http"
+    assert "凭据" in failure.value.message
+    assert calls["count"] == 1
+
+
+def test_stream_reports_an_interruption_after_the_first_token(monkeypatch):
+    class BreakingResponse(FakeResponse):
+        def __iter__(self):
+            yield b'data: {"choices":[{"delta":{"content":"hi"}}]}\n'
+            raise TimeoutError("socket stalled")
+
+    monkeypatch.setattr(llm_client, "_request", lambda *args, **kwargs: BreakingResponse([]))
+
+    with pytest.raises(llm_client.LlmError) as failure:
+        llm_client.stream_chat("https://model.invalid/v1", "key", "model", [], attempts=3)
+
+    assert failure.value.kind == "interrupted"
