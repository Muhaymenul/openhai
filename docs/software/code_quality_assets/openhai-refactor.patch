   <span\r\n                  className={\r\n                    isRunActive(run)\r\n                      ? styles.statIconIndigo\r\n                      : run.status === \"completed\"\r\n                        ? styles.statIconTeal\r\n                        : styles.statIconAmber\r\n                  }\r\n                >\r\n                  {isRunActive(run) ? (\r\n                    <LoaderCircle size={17} className={styles.spin} />\r\n                  ) : run.status === \"completed\" ? (\r\n                    <Check size={17} />\r\n                  ) : (\r\n                    <Clock3 size={17} />\r\n                  )}\r\n                </span>\r\n                <div>\r\n                  <strong>\r\n                    {studyLabel(run.question) ?? run.question.slice(0, 90)}\r\n                  </strong>\r\n                  <p>\r\n                    {papers.find((paper) => paper.id === run.paperId)?.title ||\r\n                      \"研究论文\"}\r\n                  </p>\r\n                </div>\r\n                <span\r\n                  className={\r\n                    isRunActive(run) ? styles.runningTag : styles.mutedSmall\r\n                  }\r\n                >\r\n                  {runLabels[run.status]}\r\n                </span>\r\n                <small>{displayDate(run.createdAt)}</small>\r\n                <ChevronRight size={16} />\r\n              </button>\r\n            ))}\r\n          {!history.length && (\r\n            <EmptyState\r\n              icon={<Activity size={24} />}\r\n              title=\"暂无分析任务\"\r\n              description=\"\"\r\n            />\r\n          )}\r\n        </div>\r\n      ) : (\r\n        <div className={styles.settingsGrid}>\r\n          <section className={styles.settingsCard}>\r\n            <div className={styles.panelHeading}>\r\n              <h3>\r\n                <Sparkles size={17} />\r\n                分析服务\r\n              </h3>\r\n              <span\r\n                className={health?.ok ? styles.confirmedTag : styles.draftTag}\r\n              >\r\n                {health?.ok ? \"服务就绪\" : \"待检查\"}\r\n              </span>\r\n            </div>\r\n            <div className={styles.settingsBody}>\r\n              <dl>\r\n                <div>\r\n                  <dt>当前模型</dt>\r\n                  <dd>{health?.model || settings?.model || \"尚未载入\"}</dd>\r\n                </div>\r\n                <div>\r\n                  <dt>分析核心</dt>\r\n                  <dd>本地标准库智能体</dd>\r\n                </div>\r\n                <div>\r\n                  <dt>模型配置</dt>\r\n                  <dd>{health?.configured ? \"已配置\" : \"请检查本地配置\"}</dd>\r\n                </div>\r\n              </dl>\r\n              <div className={styles.softInfo}>\r\n                <p>\r\n                  接入自己的模型：在项目目录打开 <code>private/model.env</code>\r\n                  ，填写接口根地址、模型 ID 和自己的令牌。\r\n                </p>\r\n                <p>\r\n                  对应字段为 <code>PAPERFLOW_LLM_BASE_URL</code>、\r\n                  <code>PAPERFLOW_LLM_DEFAULT_MODEL</code>、\r\n                  <code>PAPERFLOW_LLM_API_KEY</code>。保存后运行\r\n                  <code> docker compose restart paperflow</code>，再点击检查。\r\n                </p>\r\n                <p>\r\n                  <a\r\n                    href=\"https://github.com/Muhaymenul/openhai#首次接入自己的-ai\"\r\n                    target=\"_blank\"\r\n                    rel=\"noreferrer\"\r\n                  >\r\n                    查看接入说明\r\n                  </a>\r\n                  。论文片段在分析时发送给模型服务；资料保存在本机。\r\n                </p>\r\n              </div>\r\n            </div>\r\n          </section>\r\n          <section className={styles.settingsCard}>\r\n            <div className={styles.panelHeading}>\r\n              <h3>\r\n                <FolderOpen size={17} />\r\n                工作区与数据\r\n              </h3>\r\n            </div>\r\n            <div className={styles.settingsBody}>\r\n              <label className={styles.formLabel}>\r\n                默认研究主题\r\n                <input\r\n                  value={topic}\r\n                  onChange={(event) => setTopic(event.target.value)}\r\n                  placeholder=\"我的教育研究\"\r\n                />\r\n              </label>\r\n              <button\r\n                className={styles.secondaryButton}\r\n                onClick={() => void saveSettings()}\r\n              >\r\n                <Check size={14} />\r\n                保存偏好\r\n              </button>\r\n              <div className={styles.dataLocation}>\r\n                <span>本地数据位置</span>\r\n                <code>{settings?.dataLocation || \"本机工作区\"}</code>\r\n              </div>\r\n            </div>\r\n          </section>\r\n          <section className={styles.settingsCard}>\r\n            <div className={styles.panelHeading}>\r\n              <h3>\r\n                <ShieldCheck size={17} />\r\n                备份与导出\r\n              </h3>\r\n            </div>\r\n            <div className={styles.settingsBody}>\r\n              <div className={styles.actionRow}>\r\n                <a\r\n                  href=\"/api/research/backup\"\r\n                  download\r\n                  className={styles.primaryButton}\r\n                >\r\n                  <Download size={15} />\r\n                  下载工作区备份\r\n                </a>\r\n                <a\r\n                  href=\"/api/research/export?format=markdown\"\r\n                  download\r\n                  className={styles.secondaryButton}\r\n                >\r\n                  导出 Markdown\r\n                </a>\r\n              </div>\r\n            </div>\r\n          </section>\r\n        </div>\r\n      )}\r\n      {selected && (\r\n        <Modal\r\n          title={runLabels[selected.status]}\r\n          subtitle={\r\n            papers.find((paper) => paper.id === selected.paperId)?.title\r\n          }\r\n          onClose={() => setSelected(null)}\r\n          wide\r\n        >\r\n          <div className={styles.modalBody}>\r\n            <h3>{studyLabel(selected.question) ?? selected.question}</h3>\r\n            <div className={styles.articleBody}>\r\n              <StudyMarkdown\r\n                content={\r\n                  selected.answer || selected.error || \"任务还没有生成结果。\"\r\n                }\r\n              />\r\n            </div>\r\n            <button\r\n              className={styles.secondaryButton}\r\n              onClick={() => {\r\n                onOpenSource({ paperId: selected.paperId });\r\n                setSelected(null);\r\n              }}\r\n            >\r\n              <BookOpen size={14} />\r\n              返回论文\r\n            </button>\r\n          </div>\r\n        </Modal>\r\n      )}\r\n    </div>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\ResearchUi.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'Modal' has too many lines (78). Maximum allowed is 50.","line":74,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":151,"endColumn":2}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\r\n\r\nimport type { SourceRef } from \"@/lib/research/types\";\r\nimport {\r\n  ArrowUpRight,\r\n  BookOpen,\r\n  Check,\r\n  CircleAlert,\r\n  LoaderCircle,\r\n  X,\r\n} from \"lucide-react\";\r\nimport { useEffect, useRef, type ReactNode } from \"react\";\r\nimport styles from \"./styles\";\r\n\r\nexport function EmptyState({\r\n  icon,\r\n  title,\r\n  description,\r\n  action,\r\n}: {\r\n  icon?: ReactNode;\r\n  title: string;\r\n  description: string;\r\n  action?: ReactNode;\r\n}) {\r\n  return (\r\n    <div className={styles.empty}>\r\n      <div className={styles.emptyIcon}>{icon ?? <BookOpen size={24} />}</div>\r\n      <h3>{title}</h3>\r\n      {description && <p>{description}</p>}\r\n      {action}\r\n    </div>\r\n  );\r\n}\r\n\r\nexport function Loading({ label = \"正在载入工作区…\" }: { label?: string }) {\r\n  return (\r\n    <div className={styles.loading}>\r\n      <LoaderCircle size={21} className={styles.spin} />\r\n      <span>{label}</span>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport function SourceChips({\r\n  sources,\r\n  onOpen,\r\n}: {\r\n  sources: SourceRef[];\r\n  onOpen(source: SourceRef): void;\r\n}) {\r\n  return (\r\n    <div className={styles.sourceChips}>\r\n      {sources.map((source, index) => (\r\n        <button\r\n          key={source.anchorId ?? source.url ?? String(index)}\r\n          className={styles.sourceChip}\r\n          onClick={() => onOpen(source)}\r\n          title={\r\n            source.quote ?? source.title ?? source.citation ?? \"查看资料来源\"\r\n          }\r\n        >\r\n          <BookOpen size={12} />\r\n          {source.page\r\n            ? \"第 \" + source.page + \" 页\"\r\n            : source.title || source.citation || \"资料来源\"}\r\n          <ArrowUpRight size={11} />\r\n        </button>\r\n      ))}\r\n    </div>\r\n  );\r\n}\r\n\r\nexport function Modal({\r\n  title,\r\n  subtitle,\r\n  children,\r\n  onClose,\r\n  wide = false,\r\n}: {\r\n  title: string;\r\n  subtitle?: string;\r\n  children: ReactNode;\r\n  onClose(): void;\r\n  wide?: boolean;\r\n}) {\r\n  const dialog = useRef<HTMLDivElement>(null);\r\n  const closeRef = useRef(onClose);\r\n  useEffect(() => {\r\n    closeRef.current = onClose;\r\n  }, [onClose]);\r\n  useEffect(() => {\r\n    const previous = document.activeElement;\r\n    dialog.current?.focus();\r\n    const onKey = (event: KeyboardEvent) => {\r\n      if (event.key === \"Escape\") closeRef.current();\r\n      if (event.key !== \"Tab\") return;\r\n      const elements = dialog.current?.querySelectorAll<HTMLElement>(\r\n        'button:not([disabled]), input, textarea, select, a[href], [tabindex=\"0\"]',\r\n      );\r\n      if (!elements?.length) return;\r\n      const first = elements[0],\r\n        last = elements[elements.length - 1];\r\n      if (event.shiftKey && document.activeElement === first) {\r\n        event.preventDefault();\r\n        last.focus();\r\n      }\r\n      if (!event.shiftKey && document.activeElement === last) {\r\n        event.preventDefault();\r\n        first.focus();\r\n      }\r\n    };\r\n    document.addEventListener(\"keydown\", onKey);\r\n    return () => {\r\n      document.removeEventListener(\"keydown\", onKey);\r\n      if (previous instanceof HTMLElement) previous.focus();\r\n    };\r\n  }, []);\r\n  return (\r\n    <div\r\n      className={styles.modalBackdrop}\r\n      onMouseDown={(event) => {\r\n        if (event.target === event.currentTarget) onClose();\r\n      }}\r\n    >\r\n      <div\r\n        className={wide ? styles.modalWide : styles.modal}\r\n        ref={dialog}\r\n        tabIndex={-1}\r\n        role=\"dialog\"\r\n        aria-modal=\"true\"\r\n        aria-label={title}\r\n      >\r\n        <div className={styles.modalHeader}>\r\n          <div>\r\n            <h2>{title}</h2>\r\n            {subtitle && <p>{subtitle}</p>}\r\n          </div>\r\n          <button\r\n            className={styles.iconButton}\r\n            onClick={onClose}\r\n            aria-label=\"关闭对话框\"\r\n          >\r\n            <X size={19} />\r\n          </button>\r\n        </div>\r\n        {children}\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport function Toast({\r\n  message,\r\n  error,\r\n  onClose,\r\n}: {\r\n  message: string;\r\n  error: boolean;\r\n  onClose(): void;\r\n}) {\r\n  useEffect(() => {\r\n    const timer = setTimeout(onClose, error ? 9000 : 4500);\r\n    return () => clearTimeout(timer);\r\n  }, [message, error, onClose]);\r\n  return (\r\n    <div\r\n      className={error ? styles.toastError : styles.toast}\r\n      role={error ? \"alert\" : \"status\"}\r\n    >\r\n      {error ? <CircleAlert size={18} /> : <Check size={18} />}\r\n      <span>{message}</span>\r\n      <button onClick={onClose} aria-label=\"关闭提示\">\r\n        <X size={15} />\r\n      </button>\r\n    </div>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\ResearchWorkspace.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'ResearchWorkspace' has too many lines (706). Maximum allowed is 50.","line":73,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":783,"endColumn":2},{"ruleId":"complexity","severity":1,"message":"Function 'ResearchWorkspace' has a complexity of 43. Maximum allowed is 10.","line":73,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":73,"endColumn":34},{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (65). Maximum allowed is 50.","line":144,"column":13,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":208,"endColumn":4},{"ruleId":"complexity","severity":1,"message":"Arrow function has a complexity of 14. Maximum allowed is 10.","line":145,"column":32,"nodeType":"ArrowFunctionExpression","messageId":"complex","endLine":145,"endColumn":34},{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (51). Maximum allowed is 50.","line":218,"column":5,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":269,"endColumn":6},{"ruleId":"complexity","severity":1,"message":"Arrow function has a complexity of 16. Maximum allowed is 10.","line":218,"column":25,"nodeType":"ArrowFunctionExpression","messageId":"complex","endLine":218,"endColumn":27},{"ruleId":"complexity","severity":1,"message":"Arrow function has a complexity of 13. Maximum allowed is 10.","line":607,"column":35,"nodeType":"ArrowFunctionExpression","messageId":"complex","endLine":607,"endColumn":37},{"ruleId":"max-lines","severity":1,"message":"File has too many lines (774). Maximum allowed is 600.","line":610,"column":