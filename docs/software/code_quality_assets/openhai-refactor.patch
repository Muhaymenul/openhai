diff --git a/app/tests/lib/research-api-routing.test.ts b/app/tests/lib/research-api-routing.test.ts
new file mode 100644
index 0000000..ca3ef1b
--- /dev/null
+++ b/app/tests/lib/research-api-routing.test.ts
@@ -0,0 +1,97 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { handleResearchRequest } from "@/lib/research/api";
+import { closeIndex } from "@/lib/library/index-db";
+
+let root: string;
+
+beforeEach(() => {
+  root = fs.mkdtempSync(path.join(os.tmpdir(), "research-routing-"));
+  vi.stubEnv("PAPERNOOK_DATA_DIR", root);
+  vi.stubEnv("RESEARCH_DATA_DIR", path.join(root, "research"));
+  vi.stubEnv("NODE_ENV", "test");
+});
+
+afterEach(() => {
+  closeIndex();
+  vi.unstubAllEnvs();
+  fs.rmSync(root, { recursive: true, force: true });
+});
+
+function call(
+  segments: string[],
+  init?: { method?: string; headers?: HeadersInit; body?: string },
+) {
+  return new Request(`http://localhost/api/research/${segments.join("/")}`, {
+    method: init?.method ?? "GET",
+    headers: init?.headers,
+    body: init?.body,
+  });
+}
+
+describe("research API routing", () => {
+  it("serves the workspace snapshot at the root", async () => {
+    const response = await handleResearchRequest(call([]), []);
+    expect(response.status).toBe(200);
+    expect(Object.keys(await response.json())).toEqual(
+      expect.arrayContaining(["papers", "notes", "history", "settings"]),
+    );
+  });
+
+  it("routes health to the configured or unavailable service", async () => {
+    const response = await handleResearchRequest(call(["health"]), ["health"]);
+    expect([200, 503]).toContain(response.status);
+    const payload = await response.json();
+    expect(payload.health ?? payload.code).toBeDefined();
+  });
+
+  it("returns 404 for an unknown area and an unsupported method", async () => {
+    const unknown = await handleResearchRequest(call(["nope"]), ["nope"]);
+    expect(unknown.status).toBe(404);
+    expect((await unknown.json()).error).toContain("不存在");
+
+    const wrongMethod = await handleResearchRequest(
+      call(["health"], { method: "POST" }),
+      ["health"],
+    );
+    expect(wrongMethod.status).toBe(404);
+  });
+
+  it("rejects malformed path segments before dispatch", async () => {
+    const response = await handleResearchRequest(call(["bad segment"]), [
+      "bad segment",
+    ]);
+    expect(response.status).toBe(400);
+    expect((await response.json()).details[0].path).toBe("0");
+  });
+
+  it("refuses cross-origin writes while allowing same-origin writes", async () => {
+    const crossOrigin = await handleResearchRequest(
+      call(["settings"], {
+        method: "PATCH",
+        headers: {
+          origin: "https://evil.example",
+          "content-type": "application/json",
+        },
+        body: "{}",
+      }),
+      ["settings"],
+    );
+    expect(crossOrigin.status).toBe(403);
+
+    const sameOrigin = await handleResearchRequest(
+      call(["settings"], {
+        method: "PATCH",
+        headers: {
+          origin: "http://localhost",
+          "content-type": "application/json",
+        },
+        body: "{}",
+      }),
+      ["settings"],
+    );
+    expect(sameOrigin.status).not.toBe(403);
+  });
+});
