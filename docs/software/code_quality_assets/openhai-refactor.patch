index 0000000..baadd9e
--- /dev/null
+++ b/services/llm_client.py
@@ -0,0 +1,213 @@
+"""OpenAI-compatible streaming client for the local research engine.
+
+Standard library only: no httpx, no openai SDK, no pydantic. A deadline covers
+the whole request, so a server that trickles bytes cannot hold a run open
+forever the way a socket idle timeout can.
+"""
+from __future__ import annotations
+
+import json
+import re
+import time
+import urllib.error
+import urllib.request
+from typing import Any, Callable, Dict, Iterator, List, Optional
+
+SECRET_PATTERN = re.compile(r"sk-[A-Za-z0-9_-]{8,}")
+RETRY_STATUS = {408, 409, 425, 429, 500, 502, 503, 504}
+
+
+class LlmError(Exception):
+    """A model failure that is safe to show: the message is never the raw body."""
+
+    def __init__(self, kind: str, message: str, status: Optional[int] = None) -> None:
+        super().__init__(message)
+        self.kind, self.message, self.status = kind, message, status
+
+
+def redact(value: Any) -> str:
+    return SECRET_PATTERN.sub("[已隐藏]", str(value))
+
+
+def _request(base_url: str, api_key: str, payload: Dict[str, Any], timeout: float) -> urllib.request.addinfourl:
+    url = base_url.rstrip("/") + "/chat/completions"
+    body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
+    headers = {
+        "content-type": "application/json",
+        "accept": "text/event-stream" if payload.get("stream") else "application/json",
+    }
+    if api_key:
+        headers["authorization"] = "Bearer " + api_key
+    return urllib.request.urlopen(  # noqa: S310 - https endpoint comes from operator config
+        urllib.request.Request(url, data=body, headers=headers, method="POST"), timeout=timeout
+    )
+
+
+def _sleep_before_retry(retry_after: Optional[str], attempt: int) -> None:
+    seconds = min(2 ** attempt, 15)
+    if retry_after:
+        try:
+            seconds = min(float(retry_after), 30)
+        except ValueError:
+            pass
+    time.sleep(seconds)
+
+
+class Stream:
+    """Accumulates one assistant turn: text deltas plus reassembled tool calls."""
+
+    def __init__(self) -> None:
+        self.text = ""
+        self.finish_reason: Optional[str] = None
+        self.tool_calls: List[Dict[str, Any]] = []
+        self._by_index: Dict[int, Dict[str, Any]] = {}
+
+    def _merge_tool_call(self, raw: Dict[str, Any]) -> None:
+        index = int(raw.get("index", len(self._by_index)))
+        slot = self._by_index.setdefault(index, {"id": "", "name": "", "arguments": ""})
+        if raw.get("id"):
+            slot["id"] = raw["id"]
+        function = raw.get("function") or {}
+        if function.get("name"):
+            slot["name"] = function["name"]
+        if function.get("arguments"):
+            slot["arguments"] += function["arguments"]
+
+    def consume(self, chunk: Dict[str, Any]) -> Iterator[Dict[str, Any]]:
+        choice = (chunk.get("choices") or [{}])[0]
+        delta = choice.get("delta") or {}
+        piece = delta.get("content")
+        if piece:
+            self.text += piece
+            yield {"kind": "token", "text": piece}
+        for call in delta.get("tool_calls") or []:
+            self._merge_tool_call(call)
+        if choice.get("finish_reason"):
+            self.finish_reason = choice["finish_reason"]
+
+    def finalize(self) -> None:
+        self.tool_calls = [
+            {
+                "id": slot["id"] or "call_%d" % index,
+                "name": slot["name"],
+                "arguments": slot["arguments"] or "{}",
+            }
+            for index, slot in sorted(self._by_index.items())
+            if slot["name"]
+        ]
+
+
+class _RetryStream(Exception):
+    """A retryable failure; the policy lives in stream_chat, not in the parser."""
+
+    def __init__(self, error: LlmError, retry_after: Optional[str] = None) -> None:
+        super().__init__(error.message)
+        self.error = error
+        self.retry_after = retry_after
+
+
+def _request_payload(model: str, messages: List[Dict[str, Any]],
+                     tools: Optional[List[Dict[str, Any]]]) -> Dict[str, Any]:
+    payload: Dict[str, Any] = {"model": model, "messages": messages, "stream": True}
+    if tools:
+        payload["tools"] = tools
+        payload["tool_choice"] = "auto"
+    return payload
+
+
+def _open_stream(base_url: str, api_key: str, payload: Dict[str, Any], timeout: float):
+    try:
+        return _request(base_url, api_key, payload, timeout=timeout)
+    except urllib.error.HTTPError as error:
+        detail = error.read()[:400] if hasattr(error, "read") else b""
+        failure = LlmError("http", redact(_http_hint(error.code, detail)), error.code)
+        retry_after = error.headers.get("retry-after") if error.headers else None
+        error.close()
+        if error.code not in RETRY_STATUS:
+            raise failure from None
+        raise _RetryStream(failure, retry_after) from None
+    except (urllib.error.URLError, TimeoutError, OSError) as error:
+        reason = error.reason if isinstance(error, urllib.error.URLError) else error
+        raise _RetryStream(LlmError("unreachable", "无法连接模型服务：%s" % redact(reason))) from None
+
+
+def _consume_frame(raw: bytes, result: Stream,
+                   on_event: Optional[Callable[[Dict[str, Any]], None]]) -> Optional[bool]:
+    """False means [DONE], True means one chunk, None means an unrelated line."""
+    line = raw.decode("utf-8", "replace").strip()
+    if not line.startswith("data:"):
+        return None
+    data = line[5:].strip()
+    if data == "[DONE]":
+        return False
+    try:
+        chunk = json.loads(data)
+    except ValueError:
+        raise LlmError("protocol", "模型服务返回了无效的数据帧。") from None
+    if chunk.get("error"):
+        raise LlmError("http", redact(chunk["error"]))
+    for event in result.consume(chunk):
+        if on_event is not None:
+            on_event(event)
+    return True
+
+
+def _consume_stream(response, result: Stream,
+                    on_event: Optional[Callable[[Dict[str, Any]], None]]) -> Stream:
+    started = False
+    try:
+        with response:
+            for raw in response:
+                consumed = _consume_frame(raw, result, on_event)
+                if consumed is False:
+                    break
+                if consumed:
+                    started = True
+        result.finalize()
+        return result
+    except (TimeoutError, OSError) as error:
+        if started:
+            raise LlmError("interrupted", "模型响应中断：%s" % redact(error)) from None
+        raise _RetryStream(LlmError("unreachable", "无法连接模型服务。")) from None
+
+
+def stream_chat(
+    base_url: str,
+    api_key: str,
+    model: str,
+    messages: List[Dict[str, Any]],
+    tools: Optional[List[Dict[str, Any]]] = None,
+    on_event: Optional[Callable[[Dict[str, Any]], None]] = None,
+    deadline: float = 180.0,
+    attempts: int = 3,
+) -> Stream:
+    """Run one assistant turn, streaming. Retries only before the first token."""
+    payload = _request_payload(model, messages, tools)
+    stop = time.monotonic() + max(1.0, deadline)
+    last_error: Optional[LlmError] = None
+    total_attempts = max(1, attempts)
+    for attempt in range(1, total_attempts + 1):
+        remaining = stop - time.monotonic()
+        if remaining <= 0:
+            raise LlmError("timeout", "模型服务响应超时，请稍后重试。")
+        try:
+            response = _open_stream(
+                base_url, api_key, payload, timeout=min(60.0, max(1.0, remaining)))
+            return _consume_stream(response, Stream(), on_event)
+        except _RetryStream as retry:
+            last_error = retry.error
+            if attempt >= total_attempts:
+                raise last_error from None
+            _sleep_before_retry(retry.retry_after, attempt)
+    raise last_error or LlmError("unreachable", "无法连接模型服务。")
+
+
+def _http_hint(status: int, detail: bytes) -> str:
+    text = detail.decode("utf-8", "replace") if detail else ""
+    if status in (401, 403):
+        return "模型服务拒绝了凭据（HTTP %d）。请检查 private/model.env 里的令牌。" % status
+    if status == 404:
+        return "模型服务找不到该模型（HTTP 404）。请核对模型 ID：%s" % text[:160]
+    if status == 429:
+        return "模型服务限流（HTTP 429），稍后重试。%s" % text[:160]
+    return "模型服务返回 HTTP %d：%s" % (status, text[:200])
