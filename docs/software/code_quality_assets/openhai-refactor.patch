index 0000000..ec3434c
--- /dev/null
+++ b/app/src/lib/research/api-http.ts
@@ -0,0 +1,66 @@
+import { z } from "zod";
+import { recordedRunPaperIds } from "./context-scope";
+import { ResearchError } from "./store";
+import type { ResearchRun } from "./types";
+
+export type ResearchRequestContext = {
+  request: Request;
+  url: URL;
+  segments: string[];
+  method: string;
+  area?: string;
+  id?: string;
+  detail?: string;
+};
+
+export const json = (
+  body: unknown,
+  status = 200,
+  headers?: Record<string, string>,
+) =>
+  Response.json(body, {
+    status,
+    headers: { "cache-control": "no-store", ...headers },
+  });
+
+export function visibleRun(run: ResearchRun, paperIds: Set<string>): boolean {
+  return recordedRunPaperIds(run).every((id) => paperIds.has(id));
+}
+
+export async function body(request: Request): Promise<unknown> {
+  if (Number(request.headers.get("content-length") || 0) > 2 * 1024 * 1024)
+    throw new ResearchError("请求正文过大", 413);
+  try {
+    return await request.json();
+  } catch {
+    throw new ResearchError("请求必须包含有效 JSON");
+  }
+}
+
+export function guard(request: Request) {
+  const url = new URL(request.url);
+  const host = request.headers.get("host") || url.host;
+  if (!/^(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?$/i.test(host))
+    throw new ResearchError("此研究工作区仅允许本机访问", 403);
+  if (!["GET", "HEAD"].includes(request.method)) {
+    const origin = request.headers.get("origin");
+    if (origin && origin !== `${url.protocol}//${host}`)
+      throw new ResearchError("跨来源写入请求已拒绝", 403);
+    if (request.headers.get("sec-fetch-site") === "cross-site")
+      throw new ResearchError("跨来源写入请求已拒绝", 403);
+  }
+}
+
+export function versionFromRequest(
+  request: Request,
+  value?: number,
+): number | undefined {
+  if (value !== undefined) return value;
+  const header = request.headers.get("if-match");
+  if (!header) return undefined;
+  const parsed = z
+    .string()
+    .regex(/^"?\d+"?$/)
+    .parse(header);
+  return Number(parsed.replaceAll('"', ""));
+}
