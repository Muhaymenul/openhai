-                mcp_manager=self._mcp_manager,
-            ),
-            bus=self._bus,
-            provider=compact_provider,
-        )
-
-        server = SocketServer(
-            self._config.host,
-            self._config.port,
-            self._broadcaster,
-            trace=self._trace,
-        )
-        server.register("core.ping", self._ping_handler)
