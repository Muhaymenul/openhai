nst now = new Date().toISOString();\r\n    const deck: ReviewDeck = {\r\n      id: randomUUID(),\r\n      paperId: paper.id,\r\n      noteId: note?.id,\r\n      noteVersion: note?.version,\r\n      runId: run?.id,\r\n      title: input.title || paper.title + \" · 自测复习\",\r\n      contentRevision: paper.contentRevision,\r\n      questions: questions.map((question) => ({\r\n        id: randomUUID(),\r\n        question: question.question,\r\n        answer: question.answer,\r\n        sources: checkedSources(\r\n          question.sources?.length\r\n            ? question.sources\r\n            : note?.sources.length\r\n              ? note.sources\r\n              : [{ paperId: paper.id, title: paper.title }],\r\n          state,\r\n          paper.id,\r\n        ),\r\n        response: \"\",\r\n        attemptCount: 0,\r\n        attempts: [],\r\n        excluded: false,\r\n      })),\r\n      session: { onlyMissed: false },\r\n      version: 1,\r\n      createdAt: now,\r\n      updatedAt: now,\r\n    };\r\n    deck.session.currentQuestionId = deck.questions[0].id;\r\n    (state.reviewDecks ??= []).unshift(deck);\r\n    state.actions[input.actionId] = {\r\n      kind: \"review-create\",\r\n      id: deck.id,\r\n      digest: fingerprint,\r\n    };\r\n    return deck;\r\n  });\r\n}\r\n\r\nfunction changed(deck: ReviewDeck): ReviewDeck {\r\n  deck.version++;\r\n  deck.updatedAt = new Date().toISOString();\r\n  return deck;\r\n}\r\n\r\nexport async function saveReviewAttempt(\r\n  id: string,\r\n  input: AttemptInput,\r\n): Promise<ReviewDeck> {\r\n  const fingerprint = digest({\r\n    id,\r\n    ...input,\r\n    version: undefined,\r\n    actionId: undefined,\r\n  });\r\n  return mutateWorkspace((state) => {\r\n    const deck = getDeck(state, id);\r\n    const duplicate = existingAction(\r\n      state,\r\n      input.actionId,\r\n      \"review-attempt\",\r\n      fingerprint,\r\n    );\r\n    if (duplicate) return duplicate;\r\n    expectedVersion(deck.version, inpu