  )}\r\n                          <button onClick={() => select(\"node\", id)}>\r\n                            {nodesById.get(id) && nodeMark(nodesById.get(id)!)}\r\n                            <span>{nodesById.get(id)?.label ?? id}</span>\r\n                            <ArrowUpRight size={14} />\r\n                          </button>\r\n                        </div>\r\n                      ),\r\n                    )}\r\n                  </div>\r\n                  {selectedEdge.rationale && <p>{selectedEdge.rationale}</p>}\r\n                  {selectedEdge.stale && (\r\n                    <p className={styles.notice}>原文已更新，请重新核对。</p>\r\n                  )}\r\n                  <h3>\r\n                    原文证据 <span>{selectedEdge.evidence.length}</span>\r\n                  </h3>\r\n                  {selectedEdge.evidence.map((source, index) => (\r\n                    <div className={styles.evidence} key={index}>\r\n                      {source.quote && <blockquote>{source.quote}</blockquote>}\r\n                      <SourceChips sources={[source]} onOpen={onOpenSource} />\r\n                    </div>\r\n                  ))}\r\n                  {!selectedEdge.evidence.length && (\r\n                    <p className={styles.muted}>暂无原文摘录。</p>\r\n                  )}\r\n                  {selectedEdge.status === \"candidate\" && (\r\n                    <div className={styles.detailActions}>\r\n                      <button\r\n                        className={styles.primary}\r\n                        disabled={saving}\r\n                        onClick={() => void updateEdge(selectedEdge, \"confirm\")}\r\n                      >\r\n                        <Check size={14} />\r\n                        确认关系\r\n                      </button>\r\n                      <button\r\n                        className={styles.secondary}\r\n                        disabled={saving}\r\n                        onClick={() => void updateEdge(selectedEdge, \"reject\")}\r\n                      >\r\n                        <X size={14} />\r\n                        拒绝\r\n                      </button>\r\n                    </div>\r\n                  )}\r\n                </div>\r\n              ) : selectedNode ? (\r\n                <div className={styles.detail}>\r\n                  <div className={styles.detailMeta}>\r\n                    {nodeMark(selectedNode)}\r\n                    {nodeKindLabel(selectedNode.kind)}\r\n                    <span>{degrees.get(selectedNode.id) ?? 0} 条关系</span>\r\n                  </div>\r\n                  <h2>{selectedNode.label}</h2>\r\n                  {selectedNode.definition && <p>{selectedNode.definition}</p>}\r\n                  <div className={styles.detailActions}>\r\n                    {(selectedNode.paperId || selectedNode.noteId) && (\r\n                      <button\r\n                        className={styles.secondary}\r\n                        onClick={() =>\r\n                          onOpenSource({\r\n                            paperId: selectedNode.paperId,\r\n                            noteId: selectedNode.noteId,\r\n                          })\r\n                        }\r\n                      >\r\n                        <BookOpen size={14} />\r\n                        {selectedNode.kind === \"note\" ? \"打开笔记\" : \"打开论文\"}\r\n                      </button>\r\n                    )}\r\n                    <button\r\n                      className={styles.secondary}\r\n                      aria-pressed={focusNodeId === selectedNode.id}\r\n                      onClick={() =>\r\n                        setFocusNodeId(\r\n                          focusNodeId === selectedNode.id\r\n                            ? null\r\n                            : selectedNode.id,\r\n                        )\r\n                      }\r\n                    >\r\n                      <Focus size={14} />\r\n                      {focusNodeId === selectedNode.id\r\n                        ? \"显示全图\"\r\n                        : \"只看相邻\"}\r\n                    </button>\r\n                  </div>\r\n                  <h3>相连的关系</h3>\r\n                  {visible.edges\r\n                    .filter(\r\n                      (edge) =>\r\n                        edge.source === selectedNode.id ||\r\n                        edge.target === selectedNode.id,\r\n                    )\r\n                    .map((edge) => relationshipRow(edge, selectedNode.id))}\r\n                  {!degrees.get(selectedNode.id) && (\r\n                    <p className={styles.muted}>暂无相连关系。</p>\r\n                  )}\r\n                </div>\r\n              ) : list === \"nodes\" ? (\r\n                <div className={styles.nodeList}>\r\n                  {listedNodes.map((node) => (\r\n                    <button\r\n                      className={styles.nodeRow}\r\n                      key={node.id}\r\n                      onClick={() => select(\"node\", node.id)}\r\n                    >\r\n                      {nodeMark(node)}\r\n                      <span>\r\n                        <strong>{node.label}</strong>\r\n                        <small>{nodeKindLabel(node.kind)}</small>\r\n                      </span>\r\n                      <span className={styles.degree} title=\"相连关系数\">\r\n                        {degrees.get(node.id) ?? 0}\r\n                      </span>\r\n                    </button>\r\n                  ))}\r\n                  {!listedNodes.length && (\r\n                    <p className={styles.listEmpty}>没有匹配的节点。</p>\r\n                  )}\r\n                </div>\r\n              ) : (\r\n                <div className={styles.candidateList}>\r\n                  {candidates.map((edge) => relationshipRow(edge))}\r\n                  {!candidates.length && (\r\n                    <p className={styles.listEmpty}>\r\n                      {showCandidates\r\n                        ? \"当前范围没有待核对关系。\"\r\n                        : \"开启“候选关系”后查看。\"}\r\n                    </p>\r\n                  )}\r\n                </div>\r\n              )}\r\n            </div>\r\n          </aside>\r\n        </div>\r\n\r\n        <footer className={styles.footer}>\r\n          <div className={styles.legend} aria-label=\"图谱图例\">\r\n            <span>\r\n              <i className={styles.paper} />\r\n              论文\r\n            </span>\r\n            <span>\r\n              <i className={styles.concept} />\r\n              概念\r\n            </span>\r\n            <span>\r\n              <i className={styles.note} />\r\n              笔记\r\n            </span>\r\n            <span className={styles.candidateKey}>\r\n              <i />\r\n              候选\r\n            </span>\r\n          </div>\r\n          <span role=\"status\">\r\n            {visible.nodes.length} 个节点 · {visible.edges.length} 条关系\r\n          </span>\r\n        </footer>\r\n      </div>\r\n    </section>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\ResearchKnowledge.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'ResearchKnowledge' has too many lines (211). Maximum allowed is 50.","line":18,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":229,"endColumn":2}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\r\n\r\nimport { Markdown } from \"@/components/chat/Markdown\";\r\nimport type { KnowledgeEntry, SourceRef } from \"@/lib/research/types\";\r\nimport {\r\n  ArrowUpRight,\r\n  BookMarked,\r\n  Check,\r\n  GraduationCap,\r\n  Plus,\r\n  Search,\r\n} from \"lucide-react\";\r\nimport { useMemo, useState } from \"react\";\r\nimport { errorText, postJson } from \"./api\";\r\nimport { EmptyState, Modal, SourceChips } from \"./ResearchUi\";\r\nimport styles from \"./styles\";\r\n\r\nexport function ResearchKnowledge({\r\n  entries,\r\n  onRefresh,\r\n  onOpenSource,\r\n  notify,\r\n}: {\r\n  entries: KnowledgeEntry[];\r\n  onRefresh(): Promise<void>;\r\n  onOpenSource(source: SourceRef): void;\r\n  notify(message: string, error?: boolean): void;\r\n}) {\r\n  const [query, setQuery] = useState(\"\");\r\n  const [category, setCategory] = useState(\"全部概念\");\r\n  const [selected, setSelected] = useState<KnowledgeEntry | null>(null);\r\n  const [creating, setCreating] = useState(false);\r\n  const [title, setTitle] = useState(\"\");\r\n  const [definition, setDefinition] = useState(\"\");\r\n  const [source, setSource] = useState(\"\");\r\n  const [saving, setSaving] = useState(false);\r\n  const categories = [\r\n    \"全部概念\",\r\n    ...new Set(entries.map((entry) => entry.category)),\r\n  ];\r\n  const filtered = useMemo(\r\n    () =>\r\n      entries.filter(\r\n        (entry) =>\r\n          (category === \"全部概念\" || category === entry.category) &&\r\n          [entry.title, ...entry.aliases, entry.definition]\r\n            .join(\" \")\r\n            .toLowerCase()\r\n            .includes(query.toLowerCase()),\r\n      ),\r\n    [entries, category, query],\r\n  );\r\n  async function create() {\r\n    if (!title.trim() || !definition.trim() || !source.trim()) {\r\n      notify(\"请填写概念名称、解释及资料出处。\", true);\r\n      return;\r\n    }\r\n    setSaving(true);\r\n    try {\r\n      await postJson(\"/knowledge\", {\r\n        title,\r\n        definition,\r\n        body: definition,\r\n        source,\r\n        category: \"自建概念\",\r\n        aliases: [],\r\n        sources: [{ title: source }],\r\n      });\r\n      await onRefresh();\r\n      setCreating(false);\r\n      setTitle(\"\");\r\n      setDefinition(\"\");\r\n      setSource(\"\");\r\n      notify(\"概念已保存，阅读分析可以检索这份资料。\");\r\n    } catch (error) {\r\n      notify(errorText(error), true);\r\n    } finally {\r\n      setSaving(false);\r\n    }\r\n  }\r\n  return (\r\n    <div className={styles.standardPage}>\r\n      <div className={styles.pageHeading}>\r\n        <div>\r\n          <h1>\r\n            教育概念库 <span>{entries.length}</span>\r\n          </h1>\r\n        </div>\r\n        <button\r\n          className={styles.primaryButton}\r\n          onClick={() => setCreating(true)}\r\n        >\r\n          <Plus size={17} />\r\n          添加概念\r\n        </button>\r\n      </div>\r\n\r\n      <div className={styles.filterToolbar}>\r\n        <div className={styles.filterTabs}>\r\n          {categories.map((label) => (\r\n            <button\r\n              key={label}\r\n              className={category === label ? styles.filterActive : \"\"}\r\n              onClick={() => setCategory(label)}\r\n            >\r\n              {label}\r\n            </button>\r\n          ))}\r\n        </div>\r\n        <div className={styles.fieldWithIcon}>\r\n          <Search size={16} />\r\n          <input\r\n            value={query}\r\n            onChange={(event) => setQuery(event.target.value)}\r\n            placeholder=\"搜索概念或别名…\"\r\n            aria-label=\"搜索教育概念\"\r\n          />\r\n        </div>\r\n      </div>\r\n      <div className={styles.conceptGrid}>\r\n        {filtered.map((entry) => (\r\n          <button\r\n            key={entry.id}\r\n            className={styles.conceptCard}\r\n            onClick={() => setSelected(entry)}\r\n          >\r\n            <div className={styles.conceptCardTop}>\r\n              <span className={styles.conceptCategory}>{entry.category}</span>\r\n              <ArrowUpRight size={17} />\r\n            </div>\r\n            <h2>{entry.title}</h2>\r\n            <div className={styles.conceptAliases}>\r\n              {entry.aliases.join(\" · \") || \"教育研究参考\"}\r\n            </div>\r\n            <p>{entry.definition.replace(/[#*_>]/g, \"\").slice(0, 180)}</p>\r\n            <footer>\r\n              <BookMarked size={13} />\r\n              <span>\r\n                {entry.source || entry.sources[0]?.title || \"已整理参考资料\"}\r\n              </span>\r\n            </footer>\r\n          </button>\r\n        ))}\r\n      </div>\r\n      {!filtered.length && (\r\n        <EmptyState\r\n          icon={<GraduationCap size={25} />}\r\n          title=\"还没有找到这个概念\"\r\n          description=\"试试别名，或把你的可靠参考资料加入概念库。\"\r\n        />\r\n      )}\r\n      {selected && (\r\n        <Modal\r\n          title={selected.title}\r\n          subtitle={selected.aliases.join(\" · \") || selected.category}\r\n          onClose={() => setSelected(null)}\r\n          wide\r\n        >\r\n          <div className={styles.modalBody}>\r\n            <div className={styles.provenanceLabel}>\r\n              <Check size={13} />\r\n              {selected.origin === \"seed\"\r\n                ? \"预先整理的参考资料\"\r\n                : \"用户补充资料\"}\r\n            </div>\r\n            <div className={styles.articleBody}>\r\n              <Markdown content={selected.body || selected.definition} />\r\n            </div>\r\n            <div className={styles.referenceBox}>\r\n              <strong>\r\n                <BookMarked size={15} />\r\n                资料出处\r\n              </strong>\r\n              <p>{selected.source}</p>\r\n              <SourceChips sources={selected.sources} onOpen={onOpenSource} />\r\n            </div>\r\n          </div>\r\n        </Modal>\r\n      )}\r\n      {creating && (\r\n        <Modal title=\"添加教育概念\" onClose={() => setCreating(false)}>\r\n          <div className={styles.modalBody}>\r\n            <label className={styles.formLabel}>\r\n              概念名称\r\n              <input\r\n                value={title}\r\n                onChange={(event) => setTitle(event.target.value)}\r\n                placeholder=\"例如：形成性评价\"\r\n              />\r\n            </label>\r\n            <label className={styles.formLabel}>\r\n              概念解释\r\n              <textarea\r\n                rows={7}\r\n                value={definition}\r\n                onChange={(event) => setDefinition(event.target.value)}\r\n                placeholder=\"定义、理论背景、适用情境，以及容易混淆的概念…\"\r\n              />\r\n            </label>\r\n            <label className={styles.formLabel}>\r\n              资料出处\r\n              <textarea\r\n                rows={2}\r\n                value={source}\r\n                onChange={(event) => setSource(event.target.value)}\r\n                placeholder=\"作者、书名或论文名、年份、页码或可靠链接\"\r\n              />\r\n            </label>\r\n          </div>\r\n          <div className={styles.modalFooter}>\r\n            <button\r\n              className={styles.secondaryButton}\r\n              onClick={() => setCreating(false)}\r\n            >\r\n              取消\r\n            </button>\r\n            <button\r\n              className={styles.primaryButton}\r\n              disabled={saving}\r\n              onClick={() => void create()}\r\n            >\r\n              {saving ? \"正在保存…\" : \"保存概念\"}\r\n            </button>\r\n          </div>\r\n        </Modal>\r\n      )}\r\n    </div>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\ResearchLibrary.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'LibraryView' has too many lines (460). Maximum allowed is 50.","line":45,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":506,"endColumn":2},{"ruleId":"complexity","severity":1,"message":"Function 'LibraryView' has a complexity of 22. Maximum allowed is 10.","line":45,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":45,"endColumn":28},{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (66). Maximum allowed is 50.","line":299,"column":23,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":364,"endColumn":10},{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'UploadModal' has too many lines (203). Maximum allowed is 50.","line":508,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":710,"endColumn":2},{"ruleId":"complexity","severity":1,"message":"Function 'UploadModal' has a complexity of 11. Maximum allowed is 10.","line":508,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":508,"endColumn":28},{"ruleId":"max-lines","severity":1,"message":"File has too many lines (705). Maximum allowed is 600.","line":606,"column":1,"nodeType":null,"messageId":"exceed","endLine":711,"endColumn":1}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\r\n\r\nimport type { ResearchPaper } from \"@/lib/research/types\";\r\nimport {\r\n  Check,\r\n  ChevronDown,\r\n  FileText,\r\n  Grid2X2,\r\n  Layers3,\r\n  LayoutList,\r\n  LoaderCircle,\r\n  NotebookPen,\r\n  Plus,\r\n  Search,\r\n  ShieldCheck,\r\n  Tag,\r\n  Trash2,\r\n  Upload,\r\n  X,\r\n} from \"lucide-react\";\r\nimport { useRef, useState, type FormEvent } from \"react\";\r\nimport {\r\n  displayDate,\r\n  errorText,\r\n  patchJson,\r\n  postJson,\r\n  researchApi,\r\n  type WorkspaceSnapshot,\r\n} from \"./api\";\r\nimport { EmptyState, Modal } from \"./ResearchUi\";\r\nimport styles from \"./styles\";\r\nimport {\r\n  filterAndSortPapers,\r\n  libraryTagOptions,\r\n  type LibraryReadFilter,\r\n  type LibrarySort,\r\n} from \"./library/filters\";\r\nimport filterStyles from \"./library/filters.module.css\";\r\nimport coverStyles from \"./library/cover.module.css\";\r\nimport { PaperCover } from \"./library/PaperCover\";\r\nimport { PaperTrashModal, RemovePaperModal } from \"./library/PaperTrash\";\r\nimport trashStyles from \"./library/trash.module.css\";\r\nimport { uploadPendingPdfs } from \"./library/upload-queue\";\r\n\r\nexport function LibraryView({\r\n  data,\r\n  topic,\r\n  setTopic,\r\n  onUpload,\r\n  onOpen,\r\n  onRefresh,\r\n  notify,\r\n}: {\r\n  data: WorkspaceSnapshot;\r\n  topic: string;\r\n  setTopic(value: string): void;\r\n  onUpload(): void;\r\n  onOpen(paper: ResearchPaper): void;\r\n  onRefresh(): Promise<void>;\r\n  onNotes(): void;\r\n  onGraph(): void;\r\n  notify(message: string, error?: boolean): void;\r\n}) {\r\n  const [filter, setFilter] = useState<LibraryReadFilter>(\"all\");\r\n  const [query, setQuery] = useState(\"\");\r\n  const [layout, setLayout] = useState(\"grid\");\r\n  const [selectedTags, setSelectedTags] = useState<string[]>([]);\r\n  const [sort, setSort] = useState<LibrarySort>(\"added\");\r\n  const [importing, setImporting] = useState(false);\r\n  const [edit, setEdit] = useState<ResearchPaper | null>(null);\r\n  const [saving, setSaving] = useState(false);\r\n  const [removeId, setRemoveId] = useState(\"\");\r\n  const [trashOpen, setTrashOpen] = useState(false);\r\n  const topics = [\r\n    \"全部文献\",\r\n    ...new Set(data.papers.map((paper) => paper.topic)),\r\n  ];\r\n  const tagOptions = libraryTagOptions(data.papers);\r\n  const currentTopic = topics.includes(topic) ? topic : \"全部文献\";\r\n  const removingPaper = data.papers.find((paper) => paper.id === removeId);\r\n  const noteCounts = new Map<string, number>();\r\n  for (const note of data.notes)\r\n    noteCounts.set(note.paperId, (noteCounts.get(note.paperId) ?? 0) + 1);\r\n  const filtered = filterAndSortPapers(data.papers, {\r\n    topic: currentTopic,\r\n    readStatus: filter,\r\n    query,\r\n    tags: selectedTags,\r\n    sort,\r\n  });\r\n  const hasFilters =\r\n    filter !== \"all\" ||\r\n    currentTopic !== \"全部文献\" ||\r\n    !!query.trim() ||\r\n    selectedTags.length > 0;\r\n  function clearFilters() {\r\n    setFilter(\"all\");\r\n    setTopic(\"全部文献\");\r\n    setQuery(\"\");\r\n    setSelectedTags([]);\r\n  }\r\n  async function examples() {\r\n    setImporting(true);\r\n    try {\r\n      await postJson(\"/examples/import\", {});\r\n      await onRefresh();\r\n      notify(\"示例论文已导入，可以开始阅读。\");\r\n    } catch (error) {\r\n      notify(errorText(error), true);\r\n    } finally {\r\n      setImporting(false);\r\n    }\r\n  }\r\n  async function updatePaper(event: FormEvent) {\r\n    event.preventDefault();\r\n    if (!edit) return;\r\n    setSaving(true);\r\n    try {\r\n      await patchJson(\"/papers/\" + edit.id, {\r\n        title: edit.title,\r\n        authors: edit.authors,\r\n        year: edit.year,\r\n        topic: edit.topic,\r\n        tags: edit.tags,\r\n        readStatus: edit.readStatus,\r\n        version: edit.version,\r\n      });\r\n      await onRefresh();\r\n      setEdit(null);\r\n      notify(\"论文信息已更新。\");\r\n    } catch (error) {\r\n      notify(errorText(error), true);\r\n    } finally {\r\n      setSaving(false);\r\n    }\r\n  }\r\n  return (\r\n    <div className={styles.libraryPage}>\r\n      <div className={styles.welcomeHeading}>\r\n        <h1>\r\n          文献库 <span>{data.papers.length}</span>\r\n        </h1>\r\n        <div className={styles.actionRow}>\r\n          <button\r\n            className={styles.textButton}\r\n            onClick={() => setTrashOpen(true)}\r\n          >\r\n            <Trash2 size={15} aria-hidden=\"true\" />\r\n            回收站\r\n          </button>\r\n          <button\r\n            className={styles.textButton}\r\n            disabled={importing}\r\n            onClick={() => void examples()}\r\n          >\r\n            <Layers3 size={15} />\r\n            {importing ? \"正在导入…\" : \"导入示例\"}\r\n          </button>\r\n          <div className={styles.layoutSwitch}>\r\n            <button\r\n              className={layout === \"grid\" ? styles.layoutActive : \"\"}\r\n              onClick={() => setLayout(\"grid\")}\r\n              aria-label=\"网格视图\"\r\n              aria-pressed={layout === \"grid\"}\r\n            >\r\n              <Grid2X2 size={16} />\r\n            </button>\r\n            <button\r\n              className={layout === \"list\" ? styles.layoutActive : \"\"}\r\n              onClick={() => setLayout(\"list\")}\r\n              aria-label=\"列表视图\"\r\n              aria-pressed={layout === \"list\"}\r\n            >\r\n              <LayoutList size={17} />\r\n            </button>\r\n          </div>\r\n          <button className={styles.primaryButton} onClick={onUpload}>\r\n            <Plus size={17} />\r\n            导入论文\r\n          </button>\r\n        </div>\r\n      </div>\r\n      <div className={styles.filterToolbar}>\r\n        <div className={styles.filterTabs}>\r\n          {[\r\n            [\"all\", \"全部文献\"],\r\n            [\"unread\", \"未阅读\"],\r\n            [\"reading\", \"阅读中\"],\r\n            [\"finished\", \"已读完\"],\r\n          ].map(([value, label]) => (\r\n            <button\r\n              key={value}\r\n              className={filter === value ? styles.filterActive : \"\"}\r\n              onClick={() => setFilter(value as LibraryReadFilter)}\r\n            >\r\n              {label}\r\n              {value === \"all\" && <span>{data.papers.length}</span>}\r\n            </button>\r\n          ))}\r\n        </div>\r\n        <div className={styles.libraryFilters}>\r\n          <select\r\n            value={currentTopic}\r\n            onChange={(event) => setTopic(event.target.value)}\r\n            aria-label=\"筛选研究主题\"\r\n          >\r\n            {topics.map((label) => (\r\n              <option key={label}>{label}</option>\r\n            ))}\r\n          </select>\r\n          <div className={styles.fieldWithIcon}>\r\n            <Search size={15} />\r\n            <input\r\n              value={query}\r\n              onChange={(event) => setQuery(event.target.value)}\r\n              placeholder=\"搜索当前文献…\"\r\n              aria-label=\"搜索文献库\"\r\n            />\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div className={filterStyles.utilityRow}>\r\n        <div className={filterStyles.filterGroup}>\r\n          {tagOptions.length > 0 && (\r\n            <details className={filterStyles.tagMenu}>\r\n              <summary>\r\n                <Tag size={13} aria-hidden=\"true\" />\r\n                筛选标签\r\n                {selectedTags.length > 0 && <span>{selectedTags.length}</span>}\r\n                <ChevronDown size={13} aria-hidden=\"true\" />\r\n              </summary>\r\n              <div className={filterStyles.tagPopover}>\r\n                <p>多选时，论文需同时具备全部所选标签。</p>\r\n                <div className={filterStyles.tagOptions}>\r\n                  {tagOptions.map((tag) => (\r\n                    <label key={tag.label}>\r\n                      <input\r\n                        type=\"checkbox\"\r\n                        aria-label={\"筛选标签：\" + tag.label}\r\n                        checked={selectedTags.includes(tag.label)}\r\n                        onChange={(event) =>\r\n                          setSelectedTags((current) =>\r\n                            event.target.checked\r\n                              ? [...current, tag.label]\r\n                              : current.filter((value) => value !== tag.label),\r\n                          )\r\n                        }\r\n                      />\r\n                      <span>{tag.label}</span>\r\n                      <small>{tag.count}</small>\r\n                    </label>\r\n                  ))}\r\n                </div>\r\n              </div>\r\n            </details>\r\n          )}\r\n          <span className={filterStyles.resultCount} aria-live=\"polite\">\r\n            显示 {filtered.length} / {data.papers.length} 篇\r\n          </span>\r\n          {hasFilters && (\r\n            <button className={filterStyles.clear} onClick={clearFilters}>\r\n              清除筛选\r\n            </button>\r\n          )}\r\n        </div>\r\n        <label className={filterStyles.sort}>\r\n          <span>排序</span>\r\n          <select\r\n            aria-label=\"文献排序\"\r\n            value={sort}\r\n            onChange={(event) => setSort(event.target.value as LibrarySort)}\r\n 