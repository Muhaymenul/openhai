理的批注。\");\r\n  const unique = [\r\n    ...new Map(annotations.map((item) => [item.id, item])).values(),\r\n  ];\r\n  if (unique.length > 200)\r\n    throw new Error(\"一次最多整理 200 条批注，请分批选择。\");\r\n  for (const item of unique) {\r\n    if (item.paperId !== paper.id)\r\n      throw new Error(\"所选批注不属于当前论文，请重新选择。\");\r\n    if (item.contentRevision !== paper.contentRevision)\r\n      throw new Error(\"有批注对应旧版正文，请先核对原文后重新整理。\");\r\n    if (\r\n      !Number.isInteger(item.page) ||\r\n      item.page < 1 ||\r\n      item.page > paper.pageCount\r\n    )\r\n      throw new Error(\"有批注页码超出论文范围，请重新载入批注。\");\r\n  }\r\n  const ordered = unique.sort(\r\n    (a, b) =>\r\n      a.page - b.page ||\r\n      a.createdAt.localeCompare(b.createdAt) ||\r\n      a.id.localeCompare(b.id),\r\n  );\r\n  const sections = [`# ${paper.title}`, \"\"];\r\n  const sources: SourceRef[] = [];\r\n  let previousPage = 0;\r\n  for (const item of ordered) {\r\n    if (item.page !== previousPage) {\r\n      sections.push(`## 第 ${item.page} 页`, \"\");\r\n      previousPage = item.page;\r\n    }\r\n    const quote = item.quote.trim();\r\n    const comment = item.comment.trim();\r\n    if (quote)\r\n      sections.push(\r\n        quote\r\n          .split(/\\r?\\n/)\r\n          .map((line) => \"> \" + line)\r\n          .join(\"\\n\"),\r\n        \"\",\r\n      );\r\n    if (comment) sections.push(\"**批注**\", \"\", comment, \"\");\r\n    else if (!quote && item.text.trim())\r\n      sections.push(\"**记录**\", \"\", item.text.trim(), \"\");\r\n    sections.push(\r\n      `[返回原文第 ${item.page} 页](/workspace?paperId=${encodeURIComponent(paper.id)}&page=${item.page})`,\r\n      \"\",\r\n    );\r\n    sources.push({\r\n      paperId: item.paperId,\r\n      page: item.page,\r\n      annotationId: item.id,\r\n      contentRevision: item.contentRevision,\r\n      title: paper.title,\r\n      ...(quote ? { quote } : {}),\r\n    });\r\n  }\r\n  sections.push(\"## 我的思考\", \"\", \"\");\r\n  const body = sections.join(\"\\n\");\r\n  if (body.length > 200000)\r\n    throw new Error(\"所选批注内容过长，请减少选择后分批整理。\");\r\n  return { title: `${paper.title.slice(0, 470)} · 批注摘录`, body, sources };\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\study\\frameworks.ts","messages":[{"ruleId":"complexity","severity":1,"message":"Function 'studyParts' has a complexity of 11. Maximum allowed is 10.","line":74,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":74,"endColumn":27}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"export const studyFrameworks = {\r\n  cornell: {\r\n    label: \"康奈尔笔记\",\r\n    title: \"整理重点\",\r\n    scenario: \"初读或回顾时，把论文要点整理成可查阅的笔记。\",\r\n    output: \"问题线索、主要笔记、总结\",\r\n    action: \"整理重点笔记\",\r\n    example:\r\n      \"| 线索 / 问题 | 主要笔记 |\\n| --- | --- |\\n| 研究解决什么问题？ | …… [p.页码] |\\n\\n## 总结\\n核心论点与局限：……\",\r\n    instruction:\r\n      \"先给出标题，然后用 Markdown 两列表格整理‘线索 / 问题’与‘主要笔记’，最后用‘## 总结’概括核心论点与局限。表格中的每条可核实主张附原文页码。\",\r\n  },\r\n  feynman: {\r\n    label: \"费曼解释\",\r\n    title: \"通俗讲解\",\r\n    scenario: \"概念难懂时，用日常语言和类比建立理解。\",\r\n    output: \"一句话解释、类比、论文依据、待解问题\",\r\n    action: \"生成通俗讲解\",\r\n    example:\r\n      \"## 一句话理解\\n……\\n## 用一个类比解释\\n理解类比（非论文证据）：……\\n## 回到论文\\n术语、依据与边界：…… [p.页码]\\n## 我还需要弄懂什么\\n……\",\r\n    instruction:\r\n      \"使用‘## 一句话理解’‘## 用一个类比解释’‘## 回到论文’‘## 我还需要弄懂什么’四部分。类比明确标为帮助理解的类比，不可作为论文证据。保留关键英文术语，解释其含义与适用边界。\",\r\n  },\r\n  recall: {\r\n    label: \"自测问答\",\r\n    title: \"自测复习\",\r\n    scenario: \"读后复习时，先回答问题，再核对参考答案。\",\r\n    output: \"5 道递进问题、可展开答案、原文页码\",\r\n    action: \"生成自测题\",\r\n    example:\r\n      \"### 问题1：研究的关键证据是什么？\\n答案：…… [p.页码]\\n\\n### 问题2：结论适用于哪些条件？\\n答案：…… [p.页码]\\n\\n……共 5 题\",\r\n    instruction:\r\n      \"生成 5 个由理解到批判的问题。必须严格采用 Markdown 格式：每题以‘### 问题1：问题内容’为标题，下一行起以‘答案：’开头给出参考答案并附原文页码；依次编号。答案应包含论证依据，不能只列术语。不要在问题标题内泄露答案。\",\r\n  },\r\n} as const;\r\n\r\nexport type StudyFramework = keyof typeof studyFrameworks;\r\n\r\nexport function studyPrompt(framework: StudyFramework): string {\r\n  return (\r\n    \"[学习笔记:\" +\r\n    framework +\r\n    \"]\\n\" +\r\n    \"请基于当前论文可用原文生成中文\" +\r\n    studyFrameworks[framework].label +\r\n    \"。\" +\r\n    \"如有选区，优先围绕选区；请区分作者结论、你的解释和未获支持的推断。\" +\r\n    \"关键陈述标注 [p.页码]，只引用本次实际可见的原文；资料不完整时说明覆盖范围。\" +\r\n    \"不要调用写入工具，直接返回可编辑的 Markdown 草稿。\\n\" +\r\n    studyFrameworks[framework].instruction\r\n  );\r\n}\r\n\r\nexport function studyLabel(prompt: string): string | null {\r\n  const framework = prompt.match(/^\\[学习笔记:(cornell|feynman|recall)\\]/)?.[1];\r\n  return framework && framework in studyFrameworks\r\n    ? studyFrameworks[framework as StudyFramework].label\r\n    : null;\r\n}\r\n\r\n/** Plain-language purpose for compact run history; historic labels remain stable. */\r\nexport function studyPurpose(prompt: string): string | null {\r\n  const framework = prompt.match(/^\\[学习笔记:(cornell|feynman|recall)\\]/)?.[1];\r\n  return framework && framework in studyFrameworks\r\n    ? studyFrameworks[framework as StudyFramework].title\r\n    : null;\r\n}\r\n\r\nexport type StudyPart =\r\n  | { type: \"markdown\"; content: string }\r\n  | { type: \"question\"; question: string; answer: string };\r\n\r\n/** Only the explicit question-heading format becomes a closed answer card. */\r\nexport function studyParts(content: string): StudyPart[] {\r\n  const lines = content.split(/\\r?\\n/);\r\n  const parts: StudyPart[] = [];\r\n  let prose: string[] = [];\r\n  let question = \"\";\r\n  let answer: string[] = [];\r\n  let fence = \"\";\r\n  function flush() {\r\n    if (question) {\r\n      const body = answer.join(\"\\n\").trim();\r\n      if (body) {\r\n        parts.push({\r\n          type: \"question\",\r\n          question,\r\n          answer: body.replace(/^答案\\s*[：:]\\s*/, \"\"),\r\n        });\r\n      } else prose.push(\"### \" + question);\r\n      question = \"\";\r\n      