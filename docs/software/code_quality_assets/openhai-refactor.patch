rrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\lib\\pdf\\view\\reading-position.ts","messages":[{"ruleId":"complexity","severity":1,"message":"Function 'readingPositionFromUnknown' has a complexity of 14. Maximum allowed is 10.","line":55,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":55,"endColumn":43}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Where a reader left off in a paper: the page and zoom the viewer restores\r\n * the next time the same paper opens. Stored per paper in the browser's\r\n * localStorage under `readingPositionKey` and, on signed-in surfaces,\r\n * mirrored per profile on the server so a position follows the reader\r\n * across devices. `updatedAt` decides which copy wins.\r\n */\r\nexport interface ReadingPosition {\r\n  /** 1-based page number. */\r\n  page: number;\r\n  /** pdf.js `currentScale`; 1 is 100%. */\r\n  scale: number;\r\n  /** Epoch ms of the move that produced this position; 0 when unknown. */\r\n  updatedAt: number;\r\n  /**\r\n   * Width in CSS px of the reader container that produced the position;\r\n   * 0 when unknown. Zoom is meaningful only relative to the surface it\r\n   * was chosen on, so a restore applies the stored scale only when the\r\n   * viewports are comparable (see `scaleTransfers`).\r\n   */\r\n  viewport: number;\r\n}\r\n\r\n/**\r\n * pdf.js's own `MIN_SCALE` / `MAX_SCALE`: every zoom the toolbar, wheel, or\r\n * pinch can reach lies inside this window.\r\n */\r\nexport const MIN_READING_SCALE = 0.1;\r\nexport const MAX_READING_SCALE = 25;\r\n\r\n/**\r\n * The username keeps profiles on a shared browser apart: the server copy is\r\n * per profile, so the local mirror must be too, or one reader's synced spot\r\n * would seed another's.\r\n */\r\nexport function readingPositionKey(\r\n  topic: string,\r\n  slug: string,\r\n  username: string,\r\n): string {\r\n  return `papernook:reading-position:${username}:${topic}/${slug}`;\r\n}\r\n\r\n/**\r\n * Turns an already-parsed value into a position, or null when it is not one\r\n * the viewer can show (a non-integer or below-1 page). A finite zoom\r\n * outside the viewer's range is clamped rather than rejected, so a foreign\r\n * or hand-edited value degrades to the nearest displayable zoom instead of\r\n * forgetting the page along with it. A missing or malformed `updatedAt`\r\n * degrades to 0 (older than every real timestamp), so positions written\r\n * before timestamps existed still restore but always lose a freshness\r\n * race. Callers still clamp the page to the document's page count, since\r\n * the PDF may have been re-expanded or replaced since it was written.\r\n */\r\nexport function readingPositionFromUnknown(\r\n  value: unknown,\r\n): ReadingPosition | null {\r\n  if (!value || typeof value !== \"object\") return null;\r\n  const { page, scale, updatedAt } = value as Record<string, unknown>;\r\n  if (typeof page !== \"number\" || !Number.isInteger(page) || page < 1) {\r\n    return null;\r\n  }\r\n  if (typeof scale !== \"number\" || !Number.isFinite(scale)) return null;\r\n  const { viewport } = value as Record<string, unknown>;\r\n  return {\r\n    page,\r\n    scale: Math.min(MAX_READING_SCALE, Math.max(MIN_READING_SCALE, scale)),\r\n    updatedAt:\r\n      typeof updatedAt === \"number\" &&\r\n      Number.isFinite(updatedAt) &&\r\n      updatedAt > 0\r\n        ? updatedAt\r\n        : 0,\r\n    viewport:\r\n      typeof viewport === \"number\" && Number.isFinite(viewport) && viewport > 0\r\n        ? viewport\r\n        : 0,\r\n  };\r\n}\r\n\r\n/** `readingPositionFromUnknown` over a stored JSON string. */\r\nexport function parseReadingPosition(\r\n  raw: string | null | undefined,\r\n): ReadingPosition | null {\r\n  if (!raw) return null;\r\n  let value: unknown;\r\n  try {\r\n    value = JSON.parse(raw);\r\n  } catch {\r\n    return null;\r\n  }\r\n  return readingPositionFromUnknown(value);\r\n}\r\n\r\nexport function serializeReadingPosition(position: ReadingPosition): string {\r\n  return JSON.stringify({\r\n    page: position.page,\r\n    scale: position.scale,\r\n    updatedAt: position.updatedAt,\r\n    viewport: position.viewport,\r\n  });\r\n}\r\n\r\n/**\r\n * The more recently written of two positions; a tie (both copies from the\r\n * same move, or both timestampless) keeps the first argument, so callers\r\n * pass the copy they would rather trust — the local one — first.\r\n */\r\n/**\r\n * Whether a stored zoom is meaningful on the current surface: true when the\r\n * widths are within 20% of each other. A position from an unknown viewport\r\n * (0) never transfers its zoom — restoring a desktop zoom on a tablet (or\r\n * vice versa) reads as a broken fit, while the page number transfers fine.\r\n */\r\nexport function scaleTransfers(\r\n  position: ReadingPosition,\r\n  containerWidth: number,\r\n): boolean {\r\n  if (position.viewport <= 0 || containerWidth <= 0) return false;\r\n  const ratio = position.viewport / containerWidth;\r\n  return ratio >= 0.8 && ratio <= 1.25;\r\n}\r\n\r\nexport function newerReadingPosition(\r\n  a: ReadingPosition | null,\r\n  b: ReadingPosition | null,\r\n): ReadingPosition | null {\r\n  if (!a) return b;\r\n  if (!b) return a;\r\n  return b.updatedAt > a.updatedAt ? b : a;\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\lib\\research\\annotation-mutations.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\lib\\research\\annotation-records.ts","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'managedMarks' has too many lines (77). Maximum allowed is 50.","line":37,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":115,"endColumn":2},{"ruleId":"complexity","severity":1,"message":"Arrow function has a complexity of 17. Maximum allowed is 10.","line":42,"column":42,"nodeType":"ArrowFunctionExpression","messageId":"complex","endLine":42,"endColumn":44},{"ruleId":"max-lines-per-function","severity":1,"message":"Async function 'synchronizeAnnotations' has too many lines (75). Maximum allowed is 50.","line":117,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":191,"endColumn":2},{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (64). Maximum allowed is 50.","line":127,"column":25,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":190,"endColumn":4}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\r\n  PDFArray,\r\n  PDFDict,\r\n  PDFDocument,\r\n  PDFHexString,\r\n  PDFName,\r\n  PDFRef,\r\n  PDFString,\r\n} from \"pdf-lib\";\r\nimport { digest, mutateWorkspace, paperById, readWorkspace } from \"./store\";\r\nimport { readVersionedPdf } from \"../library/pdf/file\";\r\nimport type { ResearchAnnotation } from \"./types\";\r\n\r\ntype Mark = {\r\n  name: string;\r\n  refId: string;\r\n  page: number;\r\n  subtype: string;\r\n  contents: string;\r\n  rect: number[];\r\n  dict: PDFDict;\r\n  array: PDFArray;\r\n  index: number;\r\n};\r\nexport type ManagedMark = {\r\n  name: string;\r\n  page: number;\r\n  contents: string;\r\n  rects: number[][];\r\n  kind: \"comment\" | \"highlight\";\r\n  marks: Mark[];\r\n};\r\nconst value = (dict: PDFDict, key: string) =>\r\n  dict.lookupMaybe(PDFName.of(key), PDFString, PDFHexString)?.decodeText() ??\r\n  \"\";\r\n\r\nexport function managedMarks(document: PDFDocument): ManagedMark[] {\r\n  const marks: Mark[] = [];\r\n  document.getPages().forEach((page, pageIndex) => {\r\n    const array = page.node.Annots();\r\n    if (!array) return;\r\n    array.asArray().forEach((ref, index) => {\r\n      const dict = document.context.lookup(ref);\r\n      if (!(dict instanceof PDFDict) || !(ref instanceof PDFRef)) return;\r\n      const name = value(dict, \"NM\");\r\n      const subtype = dict\r\n        .lookupMaybe(PDFName.of(\"Subtype\"), PDFName)\r\n        ?.asString();\r\n      if (![\"/Text\", \"/Highlight\"].includes(subtype ?? \"\")) return;\r\n      if (!name.startsWith(\"jy-\") && !name.startsWith(\"papernook-\")) return;\r\n      const owner = value(dict, \"PapernookAuthor\");\r\n      if (\r\n        owner !== \"local\" &&\r\n        !(name.startsWith(\"jy-\") && subtype === \"/Highlight\" && !owner)\r\n      )\r\n        return;\r\n      const rect =\r\n        dict\r\n          .lookupMaybe(PDFName.of(\"Rect\"), PDFArray)\r\n          ?.asArray()\r\n          .map((v) => Number(v.toString())) ?? [];\r\n      if (rect.length !== 4 || !rect.every(Number.isFinite)) return;\r\n      marks.push({\r\n        name,\r\n        refId: `${ref.objectNumber}R${ref.generationNumber || \"\"}`,\r\n        page: pageIndex + 1,\r\n        subtype: subtype!,\r\n        contents: value(dict, \"Contents\"),\r\n        rect,\r\n        dict,\r\n        array,\r\n        index,\r\n      });\r\n    });\r\n  });\r\n  // Earlier builds gave a highlight's Text companion an unrelated papernook NM.\r\n  // Link only an unambiguous, identical-position/content companion; leave other notes alone.\r\n  for (const text of marks.filter(\r\n    (m) => m.subtype === \"/Text\" && m.name.startsWith(\"papernook-\"),\r\n  )) {\r\n    const matches = marks.filter(\r\n      (m) =>\r\n        m.subtype === \"/Highlight\" &&\r\n        m.name.startsWith(\"jy-\") &&\r\n        m.page === text.page &&\r\n        m.contents === text.contents &&\r\n        Math.abs(m.rect[0] - text.rect[0]) < 0.01 &&\r\n        Math.abs(m.rect[1] - text.rect[1]) < 0.01,\r\n    );\r\n    const names = [...new Set(matches.map((m) => m.name))];\r\n    if (names.length === 1) text.name = names[0];\r\n  }\r\n  const groups = new Map<string, ManagedMark>();\r\n  for (const mark of marks) {\r\n    let group = groups.get(mark.name);\r\n    if (!group) {\r\n      group = {\r\n        name: mark.name,\r\n        page: mark.page,\r\n        contents: mark.contents,\r\n        rects: [],\r\n        kind: \"comment\",\r\n        marks: [],\r\n      };\r\n      groups.set(mark.name, group);\r\n    }\r\n    group.marks.push(mark);\r\n    if (mark.subtype === \"/Text\") group.contents = mark.contents;\r\n    if (mark.subtype === \"/Highlight\") {\r\n      group.kind = \"highlight\";\r\n      group.rects.push(mark.rect);\r\n    }\r\n  }\r\n  return [...groups.values()];\r\n}\r\n\r\nexport async function synchronizeAnnotations(paperId: string): Promise<void> {\r\n  const paper = paperById(paperId);\r\n  const current = await readVersionedPdf(\r\n    paper.library.topic,\r\n    paper.library.slug,\r\n  );\r\n  if (!current) return;\r\n  const groups = managedMarks(\r\n    await PDFDocument.load(current.bytes, { updateMetadata: false }),\r\n  );\r\n  await mutateWorkspace((state) => {\r\n    const savedPaper = paperById(paperId, state);\r\n    const old = state.annotations.filter((a) => a.paperId === paperId);\r\n    const now = new Date().toISOString();\r\n    const next = groups.map((group) => {\r\n      const previous = old.find(\r\n        (a) => (a.pdfName ?? `jy-${a.id}`) === group.name,\r\n      );\r\n      const id =\r\n        previous?.id ??\r\n        (group.name.startsWith(\"jy-\")\r\n          ? group.name.slice(3)\r\n          : `pdf-${digest(`${paperId}:${group.name}`).slice(0, 32)}`);\r\n      const comment =\r\n        previous && !previous.comment && group.contents === previous.quote\r\n          ? \"\"\r\n          : group.contents;\r\n      const annotation: ResearchAnnotation = previous\r\n        ? {\r\n            ...previous,\r\n            pdfName: group.name,\r\n            comment,\r\n            page: group.page,\r\n            kind: group.kind,\r\n            rects: group.rects,\r\n            pdfSaved: true,\r\n          }\r\n        : {\r\n            id,\r\n            paperId,\r\n            page: group.page,\r\n            text: \"\",\r\n            quote: \"\",\r\n            comment,\r\n            color: \"#f6c84c\",\r\n            rects: group.rects,\r\n            kind: group.kind,\r\n            pdfName: group.name,\r\n            contentRevision: savedPaper.contentRevision,\r\n            createdAt: now,\r\n            updatedAt: now,\r\n            version: 1,\r\n            pdfSaved: true,\r\n          };\r\n      if (\r\n        previous &&\r\n        digest({ ...annotation, updatedAt: \"\", version: 0 }) !==\r\n          digest({ ...previous, updatedAt: \"\", version: 0 })\r\n      ) {\r\n        annotation.version = previous.version + 1;\r\n        annotation.updatedAt = now;\r\n      }\r\n      return annotation;\r\n    });\r\n    state.annotations = state.annotations\r\n      .filter((a) => a.paperId !== paperId)\r\n      .concat(next);\r\n    if (savedPaper.pdfEtag !== current.etag)\r\n      Object.assign(savedPaper, {\r\n        pdfEtag: current.etag,\r\n        version: savedPaper.version + 1,\r\n        updatedAt: now,\r\n      });\r\n  });\r\n}\r\n\r\nexport async function recoverChangedAnnotations(): Promise<void> {\r\n  for (const paper of readWorkspace().papers.filter(\r\n    (value) => !value.trashedAt,\r\n  )) {\r\n    const current = await readVersionedPdf(\r\n      paper.library.topic,\r\n      paper.library.slug,\r\n    );\r\n    if (current && current.etag !== paper.pdfEtag)\r\n      await synchronizeAnnotations(paper.id);\r\n  }\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\lib\\research\\api-http.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\lib\\research\\api-routes.ts","messages":[{"ruleId":"max-lines","severity":1,"message":"File has too many lines (686). Maximum allowed is 600.","line":628,"column":1,"nodeType":null,"messageId":"exceed","endLine":719,"endColumn":1}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import fs from \"node:fs\";\nimport path from \"node:path\";\nimport { z } from \"zod\";\nimport { pdfCommentActionSchema } from \"../library/pdf/comments\";\nimport {\n  activeWorkspace,\n  createNote,\n  ensureResearchIndex,\n  expectedVersion,\n  exportMarkdown,\n  importPaper,\n  mutateWorkspace,\n  paperById,\n  paperPages,\n  readWorkspace,\n  recoverResearchImports,\n  researchContext,\n  ResearchError,\n  saveKnowledge,\n  searchResearch,\n  updateNote,\n  updatePaper,\n} from \"./store\";\nimport {\n  annotationMutationSchema,\n  annotationSchema,\n  graphActionSchema,\n  idSchema,\n  knowledgeSchema,\n  knowledgePatchSchema,\n  notePatchSchema,\n  noteSchema,\n  paperPatchSchema,\n  paperLifecycleSchema,\n  runSchema,\n  settingsSchema,\n} from \"./schemas\";\nimport {\n  createAnnotation,\n  parsePdf,\n  recoverAnnotations,\n  researchPdfResponse,\n  saveNativeComment,\n  saveResearchPdf,\n} from \"./pdf\";\nimport { mutateAnnotation } from \"./annotation-mutations\";\nimport { readResearchComments } from \"./comment-view\";\nimport {\n  addManualGraphEdge,\n  applyGraphRun,\n  decideGraphEdge,\n  getResearchGraph,\n  suggestGraph,\n} from \"./graph\";\nimport { createResearchBackup } from \"./backup\";\nimport { researchCoverResponse } from \"./cover\";\nimport { prepareLearningInput } from \"./learning-input\";\nimport { prepareQuestionInput } from \"./discussion/input\";\nimport { effectiveAnswerStyle } from \"./discussion/context\";\nimport { handleReviewRequest } from \"./review/api\";\nimport {\n  cancelResearchRun,\n  configureResearchProvider,\n  getResearchHealth,\n  getResearchHistory,\n  getResearchRun,\n  startResearchRun,\n  respondResearchPermission,\n} from \"./paperflow-client\";\nimport {\n  listTrashedPapers,\n  restoreResearchPaper,\n  trashResearchPaper,\n  withPaperLifecycle,\n} from \"./paper-lifecycle\";\nimport {\n  body,\n  json,\n  versionFromRequest,\n  visibleRun,\n  type ResearchRequestContext,\n} from \"./api-http\";\n\nasync function handleReview(ctx: ResearchRequestContext) {\n  return handleReviewRequest(ctx.request, ctx.segments.slice(1));\n}\n\nasync function handleWorkspace() {\n  await withPaperLifecycle(async () => {\n    await recoverResearchImports();\n    await recoverAnnotations();\n  });\n  const indexReady = ensureResearchIndex();\n  const state = activeWorkspace();\n  const graph = await getResearchGraph();\n  const paperIds = new Set(state.papers.map((paper) => paper.id));\n  const history = (await getResearchHistory(undefined, false)).filter((run) =>\n    visibleRun(run, paperIds),\n  );\n  return json({\n    papers: state.papers,\n    notes: state.notes,\n    knowledge: state.knowledge,\n    annotations: state.annotations,\n    graph,\n    history,\n    settings: state.settings,\n    indexReady,\n  });\n}\n\nasync function handleHealth() {\n  return json({ health: await getResearchHealth() });\n}\n\nfunction handleTrash() {\n  return json({ papers: listTrashedPapers() });\n}\n\nasync function handleExamplesImport() {\n  const dir = path.resolve(\n    process.env.RESEARCH_EXAMPLES_DIR ||\n      path.join(process.cwd(), \"..\", \"examples\"),\n  );\n  if (!fs.existsSync(dir))\n    throw new ResearchError(\"样例目录尚未准备，请上传自己的PDF\", 404);\n  const files = fs\n    .readdirSync(dir)\n    .filter((name) => name.toLowerCase().endsWith(\".pdf\"))\n    .slice(0, 10);\n  const papers = [];\n  for (const filename of files) {\n    const full = path.join(dir, filename);\n    if (!fs.lstatSync(full).isFile()) continue;\n    const bytes = new Uint8Array(fs.readFileSync(full));\n    const parsed = await parsePdf(bytes);\n    papers.push(\n      await importPaper({\n        bytes,\n        filename,\n        topic: \"教育研究样例\",\n        ...parsed,\n      }),\n    );\n  }\n  return json({ papers }, 201);\n}\n\nasync function handlePaperCollection(ctx: ResearchRequestContext) {\n  if (ctx.method === \"GET\") return json({ papers: activeWorkspace().papers });\n  if (ctx.method === \"POST\") {\n    const form = await ctx.request.formData();\n    const parsed = z\n      .object({\n        file: z\n          .instanceof(File)\n          .refine(\n            (f) => f.size > 0 && f.size <= 100 * 1024 * 1024,\n            \"PDF大小应在1字节至100MB之间\",\n          ),\n        title: z.string().trim().max(500).optional(),\n        topic: z.string().trim().max(500).optional(),\n        tags: z.string().max(3000).optional(),\n      })\n      .parse({\n        file: form.get(\"file\"),\n        title: form.get(\"title\") || undefined,\n        topic: form.get(\"topic\") || undefined,\n        tags: form.get(\"tags\") || undefined,\n      });\n    const bytes = new Uint8Array(await parsed.file.arrayBuffer());\n    const extracted = await parsePdf(bytes);\n    const paper = await importPaper({\n      bytes,\n      filename: parsed.file.name,\n      topic: parsed.topic,\n      tags: parsed.tags\n        ?.split(/[,，]/)\n        .map((s) => s.trim())\n        .filter(Boolean),\n      ...extracted,\n      title: parsed.title || extracted.title,\n    });\n    return json({ paper }, 201, { etag: `\"${paper.version}\"` });\n  }\n  throw notFound();\n}\n\nasync function paperLifecycleResponse(\n  request: Request,\n  id: string,\n  detail: string | undefined,\n  method: string,\n): Promise<Response | undefined> {\n  const isLifecycle =\n    (!detail && method === \"DELETE\") ||\n    (detail === \"restore\" && method === \"POST\");\n  if (!isLifecycle) return undefined;\n  const input = paperLifecycleSchema.parse(await body(request));\n  const version = versionFromRequest(request, input.version);\n  const updated =\n    detail === \"restore\"\n      ? await restoreResearchPaper(id, version)\n      : await trashResearchPaper(id, version);\n  return json({ paper: updated }, 200, { etag: `\"${updated.version}\"` });\n}\n\nasync function paperMediaResponse(\n  request: Request,\n  id: string,\n  detail: string | undefined,\n  method: string,\n): Promise<Response | undefined> {\n  if (detail === \"cover\" && (method === \"GET\" || method === \"HEAD\"))\n    return await researchCoverResponse(request, id);\n  if (detail === \"pdf\") {\n    if (method === \"GET\" || method === \"HEAD\")\n      return researchPdfResponse(request, id);\n    if (method === \"PUT\") {\n      const saved = await withPaperLifecycle(() =>\n        saveResearchPdf(request, id),\n      );\n      return json(saved, 200, { etag: saved.etag });\n    }\n  }\n  return paperCommentResponse(request, id, detail, method);\n}\n\nasync function paperCommentResponse(\n  request: Request,\n  id: string,\n  detail: string | undefined,\n  method: string,\n): Promise<Response | undefined> {\n  if (detail === \"comments\" && method === \"GET\") {\n    const comments = await readResearchComments(id);\n    return json(comments, 200, { etag: comments.etag });\n  }\n  if (detail === \"comments\" && method === \"POST\") {\n    const action = pdfCommentActionSchema.parse(await body(request));\n    const expected = z\n      .string()\n      .regex(/^\"[a-f0-9]{64}\"$/)\n      .parse(request.headers.get(\"if-match\"));\n    const saved = await withPaperLifecycle(() =>\n      saveNativeComment(id, action, expected),\n    );\n    return json(saved, 200, { etag: saved.etag });\n  }\n  return undefined;\n}\n\nasync function paperRecordResponse(\n  request: Request,\n  id: string,\n  detail: string | undefined,\n  method: string,\n  paper: ReturnType<typeof paperById>,\n): Promise<Response> {\n  if (detail === \"text\" && method === \"GET\")\n    return json({\n      pages: paperPages(paper),\