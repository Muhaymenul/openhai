e(share.createdAt).toLocaleDateString()}\r\n                          </small>\r\n                        </div>\r\n                        <div className={styles.shareActions}>\r\n                          <button\r\n                            type=\"button\"\r\n                            onClick={() => void copyShare(share)}\r\n                          >\r\n                            {copiedId === share.id ? \"Copied\" : \"Copy\"}\r\n                          </button>\r\n                          <a\r\n                            href={share.href}\r\n                            target=\"_blank\"\r\n                            rel=\"noopener noreferrer\"\r\n                          >\r\n                            Open\r\n                          </a>\r\n                          <button\r\n                            className={styles.revoke}\r\n                            type=\"button\"\r\n                            onClick={() => void revoke(share)}\r\n                          >\r\n                            Revoke\r\n                          </button>\r\n                        </div>\r\n                        {share.mode === \"collaborate\" && (\r\n                          <Participants\r\n                            endpoint={`${base}/shares/${share.id}/participants`}\r\n                          />\r\n                        )}\r\n                      </li>\r\n                    ))}\r\n                  </ul>\r\n                </section>\r\n              )}\r\n            </>\r\n          )}\r\n        </div>\r\n      </dialog>\r\n    </>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\share\\SharedCanvas.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\share\\SharingControls.tsx","messages":[{"ruleId":"max-line