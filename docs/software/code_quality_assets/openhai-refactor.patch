+async def await_partial_text(service: research_service.ResearchService, run_id: str, needle: str,
+                             timeout: float = 5.0) -> None:
+    deadline = asyncio.get_running_loop().time() + timeout
+    while asyncio.get_running_loop().time() < deadline:
+        if needle in (service.state["runs"][run_id].get("text") or ""):
+            return
+        await asyncio.sleep(0.01)
+    raise AssertionError("streamed text never reached the run record")
+
+
+async def settle(service: research_service.ResearchService, run_id: str, timeout: float = 5.0) -> Dict[str, Any]:
+    deadline = asyncio.get_running_loop().time() + timeout
+    while asyncio.get_running_loop().time() < deadline:
+        run = service.state["runs"][run_id]
+        if run["status"] in research_service.TERMINAL:
+            await asyncio.sleep(0.05)
+            return run
+        await asyncio.sleep(0.01)
+    raise AssertionError("run %s did not finish: %s" % (run_id, service.state["runs"][run_id]["status"]))
+
+
+async def await_approval(service: research_service.ResearchService, run_id: str, timeout: float = 5.0) -> Dict[str, Any]:
+    deadline = asyncio.get_running_loop().time() + timeout
+    while asyncio.get_running_loop().time() < deadline:
+        pending = service.state["runs"][run_id].get("pending_permissions") or []
+        if pending:
+            return pending[0]
+        await asyncio.sleep(0.01)
+    raise AssertionError("no permission request appeared")
+
