ft(\r\n        window.localStorage.getItem(key),\r\n        question.question,\r\n        question.answer,\r\n      );\r\n      if (draft === value) window.localStorage.removeItem(key);\r\n      setLocalDraft(false);\r\n    } catch {\r\n      /* A server-saved response is safe even when local storage is restricted. */\r\n    }\r\n  }\r\n  async function reveal() {\r\n    if (await actions.saveResponse(response)) {\r\n      savedResponse(response);\r\n      setRevealed(true);\r\n    }\r\n  }\r\n  async function rate(rating: ReviewRating) {\r\n    const signature = JSON.stringify([question.id, response, rating]);\r\n    if (signature !== pendingAction.current.signature)\r\n      pendingAction.current = { signature, id: crypto.randomUUID() };\r\n    if (await actions.rate(response, rating, pendingAction.current.id)) {\r\n      savedResponse(response);\r\n      setRatedThisVisit(true);\r\n    }\r\n  }\r\n  async function next() {\r\n    if (await actions.next(response)) savedResponse(response);\r\n  }\r\n\r\n  return (\r\n    <>\r\n      <div className={styles.questionToolbar}>\r\n        <span>\r\n          {question.reviewedAt\r\n            ? `上次自评：${question.rating === \"good\" ? \"会了\" : \"还不会\"}`\r\n            : \"尚未自评\"}\r\n        </span>\r\n        <div>\r\n          <button\r\n            type=\"button\"\r\n            className={shared.textButton}\r\n            onClick={onEdit}\r\n            disabled={busy}\r\n          >\r\n            <FilePenLine size={14} />\r\n            编辑题目\r\n          </button>\r\n          <button\r\n            type=\"button\"\r\n            className={shared.textButton}\r\n            onClick={onPause}\r\n            disabled={busy}\r\n          >\r\n            <Pause size={14} />\r\n            暂停此题\r\n          </button>\r\n        </div>\r\n      </div>\r\n      <h2 className={styles.questionTitle}>{question.question}</h2>\r\n      <label className={styles.responseLabel}>\r\n        我的回答\r\n        <textarea\r\n          value={response}\r\n          onChange={(event) => changeResponse(event.target.value)}\r\n          maxLength={20000}\r\n          disabled={busy}\r\n          placeholder=\"写下你的理解，也可以先在心中作答。\"\r\n          aria-label=\"我的自测回答\"\r\n        />\r\n      </label>\r\n      <div className={styles.responseStatus} aria-live=\"polite\">\r\n        {busy\r\n          ? \"正在保存…\"\r\n          : localDraft\r\n            ? \"回答已暂存于当前浏览器\"\r\n            : response\r\n              ? \"回答已保存\"\r\n              : \"参考答案默认隐藏\"}\r\n        {!storageAvailable && !busy && (\r\n          <span>浏览器无法暂存，请先查看答案以保存回答。</span>\r\n        )}\r\n      </div>\r\n      {!revealed ? (\r\n        <div className={styles.questionActions}>\r\n          <button\r\n            className={shared.primaryButton}\r\n            onClick={() => void reveal()}\r\n            disabled={busy}\r\n          >\r\n            <Eye size={15} />\r\n            查看参考答案\r\n          </button>\r\n          <button\r\n            className={shared.textButton}\r\n            onClick={() => void next()}\r\n            disabled={busy}\r\n          >\r\n            {question.reviewedAt ? nextLabel : \"暂时跳过\"}\r\n            <ArrowRight size={14} />\r\n          </button>\r\n        </div>\r\n      ) : (\r\n        <>\r\n          <section className={styles.answer} aria-label=\"参考答案\">\r\n            <div className={styles.answerHeading}>\r\n              <strong>参考答案</strong>\r\n              <span>对照原文，自行判断掌握程度</span>\r\n            </div>\r\n            <Markdown\r\n              content={question.answer}\r\n              highlightCode={false}\r\n              resolveLinkHref={normalizeWorkspaceCitationHref}\r\n            />\r\n            {question.sources.length > 0 && (\r\n              <div className={styles.answerSources}>\r\n                <BookOpen size={13} aria-hidden=\"true\" />\r\n                <SourceChips sources={question.sources} onOpen={onOpenSource} />\r\n              </div>\r\n            )}\r\n          </section>\r\n          <div className={styles.ratingBar}>\r\n            <span>\r\n              {ratedThisVisit && question.dueAt ? (\r\n                <>\r\n                  下次复习：\r\n                  <time dateTime={question.dueAt}>\r\n                    {new Intl.DateTimeFormat(\"zh-CN\", {\r\n                      month: \"short\",\r\n                      day: \"numeric\",\r\n                      hour: \"2-digit\",\r\n                      minute: \"2-digit\",\r\n                    }).format(new Date(question.dueAt))}\r\n                  </time>\r\n                </>\r\n              ) : ratedThisVisit ? (\r\n                \"自评已记录\"\r\n              ) : (\r\n                \"这道题掌握了吗？\"\r\n              )}\r\n            </span>\r\n            <div>\r\n              <button\r\n                className={shared.secondaryButton}\r\n                disabled={busy}\r\n                onClick={() => void rate(\"again\")}\r\n                aria-pressed={ratedThisVisit && question.rating === \"again\"}\r\n              >\r\n                <RotateCcw size={15} />\r\n                还不会\r\n              </button>\r\n              <button\r\n                className={shared.secondaryButton}\r\n                disabled={busy}\r\n                onClick={() => void rate(\"good\")}\r\n                aria-pressed={ratedThisVisit && question.rating === \"good\"}\r\n              >\r\n                <Check size={15} />\r\n                会了\r\n              </button>\r\n              <button\r\n                className={shared.primaryButton}\r\n                disabled={busy || !ratedThisVisit}\r\n                onClick={() => void next()}\r\n              >\r\n                {nextLabel}\r\n                <ArrowRight size={15} />\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </>\r\n      )}\r\n    </>\r\n  );\r\n}\r\n\r\nexport function ReviewPlayer({\r\n  deck,\r\n  onUpdate,\r\n  onOpenSource,\r\n}: {\r\n  deck: ReviewDeck;\r\n  onUpdate(deck: ReviewDeck): void;\r\n  onOpenSource(source: SourceRef): void;\r\n}) {\r\n  const mutation = useReviewMutation(deck, onUpdate);\r\n  const [editing, setEditing] = useState(false);\r\n  const counts = reviewCounts(deck);\r\n  const question = currentReviewQuestion(deck);\r\n  const index = question\r\n    ? deck.questions\r\n        .filter((item) => !item.excluded)\r\n        .findIndex((item) => item.id === question.id) + 1\r\n    : 0;\r\n  const nextId = question ? nextReviewQuestionId(deck, question.id) : null;\r\n  const excluded = deck.questions.filter((item) => item.excluded);\r\n\r\n  async function begin(onlyMissed: boolean) {\r\n    await mutation.mutate(\"session\", {\r\n      currentQuestionId: firstReviewQuestionId(deck, onlyMissed),\r\n      onlyMissed,\r\n    });\r\n  }\r\n  async function pause() {\r\n    if (question)\r\n      await mutation.mutate(\"question\", {\r\n        questionId: question.id,\r\n        excluded: true,\r\n      });\r\n  }\r\n  const actions: QuestionActions = {\r\n    saveResponse: async (response) =>\r\n      !!question &&\r\n      !!(await mutation.mutate(\"response\", {\r\n        questionId: question.id,\r\n        response,\r\n      })),\r\n    rate: async (response, rating, actionId) =>\r\n      !!question &&\r\n      !!(await mutation.mutate(\"attempt\", {\r\n        questionId: question.id,\r\n        response,\r\n        rating,\r\n        actionId,\r\n      })),\r\n    next: async (response) => {\r\n      if (!question) return false;\r\n      const saved = await mutation.mutate(\"response\", {\r\n        questionId: question.id,\r\n        response,\r\n      });\r\n      if (!saved) return false;\r\n      return !!(await mutation.mutate(\"session\", {\r\n        currentQuestionId: nextReviewQuestionId(saved, question.id),\r\n        onlyMissed: saved.session.onlyMissed,\r\n      }));\r\n    },\r\n  };\r\n\r\n  return (\r\n    <section\r\n      className={styles.player}\r\n      aria-label=\"逐题复习\"\r\n      data-review-deck={deck.id}\r\n    >\r\n      <header className={styles.playerHeading}>\r\n        <div>\r\n          <span className={styles.overline}>\r\n            {deck.session.onlyMissed ? \"未掌握题目\" : \"论文自测\"}\r\n          </span>\r\n          <h2>{deck.title}</h2>\r\n        </div>\r\n        <span className={styles.total}>{counts.total} 题</span>\r\n      </header>\r\n      <div className={styles.progressRow}>\r\n        <span>\r\n          已掌握 {counts.good} / {counts.total}\r\n        </span>\r\n        <progress\r\n          value={counts.good}\r\n          max={Math.max(counts.total, 1)}\r\n          aria-label=\"已掌握题目比例\"\r\n        />\r\n      </div>\r\n      {deck.stale && (\r\n        <p className={styles.warning}>\r\n          来源已有更新。这组题目保留了原内容，请核对原文后再复习或重新出题。\r\n        </p>\r\n      )}\r\n      {mutation.error && (\r\n        <div className={styles.error} role=\"alert\">\r\n          <span>{mutation.error} 当前回答仍保留在浏览器。</span>\r\n          <button\r\n            className={shared.textButton}\r\n            onClick={() => void mutation.reload()}\r\n            disabled={mutation.busy}\r\n          >\r\n            重新载入\r\n          </button>\r\n        </div>\r\n      )}\r\n      {question ? (\r\n        <>\r\n          <div className={styles.questionPosition} aria-live=\"polite\">\r\n            题目 {index} / {counts.total}\r\n          </div>\r\n          <QuestionBody\r\n            key={question.id + question.question + question.answer}\r\n            deckId={deck.id}\r\n            question={question}\r\n            busy={mutation.busy}\r\n            nextLabel={nextId ? \"下一题\" : \"完成本轮\"}\r\n            actions={actions}\r\n            onEdit={() => setEditing(true)}\r\n            onPause={() => void pause()}\r\n            onOpenSource={onOpenSource}\r\n          />\r\n        </>\r\n      ) : (\r\n        <div className={styles.finished}>\r\n          <Check size={32} aria-hidden=\"true\" />\r\n          <h3>{counts.total ? \"本轮复习已完成\" : \"暂时没有可练习的题目\"}</h3>\r\n          <p>\r\n            会了 {counts.good} 题 · 还不会 {counts.again} 题 · 未作答{\" \"}\r\n            {counts.unanswered} 题\r\n          </p>\r\n          <div className={styles.questionActions}>\r\n            <button\r\n              className={shared.primaryButton}\r\n              disabled={mutation.busy || counts.good === counts.total}\r\n              onClick={() => void begin(true)}\r\n            >\r\n              重练未掌握\r\n              <RotateCcw size={15} />\r\n            </button>\r\n            <button\r\n              className={shared.secondaryButton}\r\n              disabled={mutation.busy || !counts.total}\r\n              onClick={() => void begin(false)}\r\n            >\r\n              全部再练一遍\r\n            </button>\r\n          </div>\r\n        </div>\r\n      )}\r\n      {excluded.length > 0 && (\r\n        <details className={styles.paused}>\r\n          <summary>已暂停 {excluded.length} 题</summary>\r\n          <ul>\r\n            {excluded.map((item) => (\r\n              <li key={item.id}>\r\n                <span>{item.question}</span>\r\n                <button\r\n                  className={shared.textButton}\r\n                  disabled={mutation.busy}\r\n                  onClick={() =>\r\n                    void mutation.mutate(\"question\", {\r\n                      questionId: item.id,\r\n                      excluded: false,\r\n                    })\r\n                  }\r\n                >\r\n                  恢复题目\r\n                </button>\r\n              </li>\r\n            ))}\r\n          </ul>\r\n        </details>\r\n      )}\r\n      {editing && question && (\r\n        <ReviewQuestionEditor\r\n          question={question}\r\n          busy={mutation.busy}\r\n          error={mutation.error}\r\n          onClose={() => setEditing(false)}\r\n          onSave={async (input) => {\r\n            const saved = await mutation.mutate(\"question\", {\r\n              questionId: question.id,\r\n              ...input,\r\n            });\r\n            if (saved) setEditing(false);\r\n            return !!saved;\r\n          }}\r\n        />\r\n      )}\r\n    </section>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\review\\ReviewQuestionEditor.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'ReviewQuestionEditor' has too many lines (74). Maximum allowed is 50.","line":9,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":82,"endColumn":2}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\r\n\r\nimport { useState } from \"react\";\r\nimport type { ReviewQuestion } from \"@/lib/research/review/types\";\r\nimport { Modal } from \"../ResearchUi\";\r\nimport shared from \"../styles\";\r\nimport styles from \"./review.module.css\";\r\n\r\nexport function ReviewQuestionEditor({\r\n  question,\r\n  busy,\r\n  error,\r\n  onSave,\r\n  onClose,\r\n}: {\r\n  question: ReviewQuestion;\r\n  busy: boolean;\r\n  error: string;\r\n  onSave(input: { question: string; answer: string }): Promise<boolean>;\r\n  onClose(): void;\r\n}) {\r\n  const [prompt, setPrompt] = useState(question.question);\r\n  const [answer, setAnswer] = useState(question.answer);\r\n  return (\r\n    <Modal title=\"编辑自测题\" onClose={() => !busy && onClose()} wide>\r\n      <form\r\n        onSubmit={(event) => {\r\n          event.preventDefault();\r\n          void onSave({ question: prompt.trim(), answer: answer.trim() });\r\n        }}\r\n      >\r\n        <div className={shared.modalBody}>\r\n          <label className={shared.formLabel}>\r\n            题目\r\n            <textarea\r\n              className={styles.editQuestion}\r\n              value={prompt}\r\n              onChange={(event) => setPrompt(event.target.value)}\r\n              maxLength={3000}\r\n              required\r\n              disabled={busy}\r\n            />\r\n          </label>\r\n          <label className={shared.formLabel}>\r\n            参考答案\r\n            <textarea\r\n              className={styles.editAnswer}\r\n              value={answer}\r\n              onChange={(event) => setAnswer(event.target.value)}\r\n              maxLength={20000}\r\n              required\r\n              disabled={busy}\r\n            />\r\n          </label>\r\n          <p className={styles.hint}>修改后需重新自评，原作答记录会保留。</p>\r\n          {error && (\r\n            <p className={styles.error} role=\"alert\">\r\n              {error}\r\n            </p>\r\n          )}\r\n        </div>\r\n        <div className={shared.modalFooter}>\r\n          <button\r\n            type=\"button\"\r\n            className={shared.secondaryButton}\r\n            onClick={onClose}\r\n            disabled={busy}\r\n          >\r\n            取消\r\n          </button>\r\n          <button\r\n            type=\"submit\"\r\n            className={shared.primaryButton}\r\n            disabled={busy || !prompt.trim() || !answer.trim()}\r\n          >\r\n            {busy ? \"保存中…\" : \"保存题目\"}\r\n          </button>\r\n        </div>\r\n      </form>\r\n    </Modal>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\review\\ReviewWorkspace.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'ReviewWorkspace' has too many lines (296). Maximum allowed is 50.","line":36,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":336,"endColumn":2},{"ruleId":"complexity","severity":1,"message":"Function 'ReviewWorkspace' has a complexity of 19. Maximum allowed is 10.","line":36,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":36,"endColumn":32},{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (59). Maximum allowed is 50.","line":241,"column":26,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":299,"endColumn":14},{"ruleId":"complexity","severity":1,"message":"Arrow function has a complexity of 11. Maximum allowed is 10.","line":241,"column":33,"nodeType":"ArrowFunctionExpression","messageId":"complex","endLine":241,"endColumn":35}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\r\n\r\nimport { useEffect, useMemo, useRef, useState } from \"react\";\r\nimport {\r\n  ArrowRight,\r\n  BookOpen,\r\n  ListFilter,\r\n  RefreshCw,\r\n  RotateCcw,\r\n} from \"lucide-react\";\r\nimport type {\r\n  ResearchNote,\r\n  ResearchPaper,\r\n  SourceRef,\r\n} from \"@/lib/research/types\";\r\nimport type { ReviewDeck } from \"@/lib/research/review/types\";\r\nimport { errorText, patchJson, researchApi } from \"../api\";\r\nimport { EmptyState, Loading } from \"../ResearchUi\";\r\nimport shared from \"../styles\";\r\nimport styles from \"./review.module.css\";\r\nimport { ReviewPlayer } from \"./ReviewPlayer\";\r\nimport { firstReviewQuestionId, reviewCounts } from \"./review-session\";\r\n\r\nexport interface ReviewWorkspaceProps {\r\n  papers: ResearchPaper[];\r\n  notes?: ResearchNote[];\r\n  initialDeckId?: string;\r\n  initialPaperId?: string;\r\n  initialNoteId?: string;\r\n  onOpenSource(source: SourceRef): void;\r\n  onOpenPaper(paperId: string): void;\r\n  onRefresh?(): Promise<void>;\r\n  notify(message: string, error?: boolean): void;\r\n}\r\n\r\nexport function ReviewWorkspace({\r\n  papers,\r\n  notes = [],\r\n  initialDeckId,\r\n  initialPaperId,\r\n  initialNoteId,\r\n  onOpenSource,\r\n  onOpenPaper,\r\n  notify,\r\n}: ReviewWorkspaceProps) {\r\n  const [decks, setDecks] = useState<ReviewDeck[]>([]);\r\n  const [activeId, setActiveId] = useState(initialDeckId ?? \"\");\r\n  const [paperFilter, setPaperFilter] = useState(initialPaperId ?? \"all\");\r\n  const [noteFilter, setNoteFilter] = useState(initialNoteId ?? \"all\");\r\n  const [loading, setLoading] = useState(true);\r\n  const [error, setError] = useState(\"\");\r\n  const [refreshId, setRefreshId] = useState(0);\r\n  const [opening, setOpening] = useState(\"\");\r\n  const openLock = useRef(false);\r\n  const [catalogOpen, setCatalogOpen] = useState(false);\r\n\r\n  useEffect(() => {\r\n    queueMicrotask(() => {\r\n      if (initialDeckId) setActiveId(initialDeckId);\r\n      if (initialPaperId) setPaperFilter(initialPaperId);\r\n      if (initialNoteId) setNoteFilter(initialNoteId);\r\n    });\r\n  }, [initialDeckId, initialPaperId, initialNoteId]);\r\n\r\n  useEffect(() => {\r\n    const controller = new AbortController();\r\n    queueMicrotask(() => {\r\n      if (controller.signal.aborted) return;\r\n      setLoading(true);\r\n      setError(\"\");\r\n    });\r\n    void researchApi<{ decks: ReviewDeck[] }>(\"/review\", {\r\n      signal: controller.signal,\r\n    })\r\n      .then((result) => {\r\n        if (!controller.signal.aborted) setDecks(result.decks);\r\n      })\r\n      .catch((cause: unknown) => {\r\n        if (!controller.signal.aborted) setError(errorText(cause));\r\n      })\r\n      .finally(() => {\r\n        if (!controller.signal.aborted) setLoading(false);\r\n      });\r\n    return () => controller.abort();\r\n  }, [initialDeckId, initialPaperId, initialNoteId, refreshId]);\r\n\r\n  const activePapers = useMemo(\r\n    () =>\r\n      new Map(\r\n        papers\r\n          .filter((paper) => !paper.trashedAt)\r\n          .map((paper) => [paper.id, paper]),\r\n      ),\r\n    [papers],\r\n  );\r\n  const available = decks.filter(\r\n    (deck) =>\r\n      activePapers.has(deck.paperId) &&\r\n      deck.questions.every((question) =>\r\n        question.sources.every(\r\n          (source) => !source.paperId || activePapers.has(source.paperId),\r\n        ),\r\n      ),\r\n  );\r\n  const visible = available.filter(\r\n    (deck) =>\r\n      (paperFilter === \"all\" || deck.paperId === paperFilter) &&\r\n      (noteFilter === \"all\" || deck.noteId === noteFilter),\r\n  );\r\n  const active = visible.find((deck) => deck.id === activeId) ?? visible[0];\r\n  const noteSources = [\r\n    ...new Map(\r\n      available\r\n        .filter(\r\n          (deck) =>\r\n            deck.noteId &&\r\n            (paperFilter === \"all\" || deck.paperId === paperFilter),\r\n        )\r\n        .map((deck) => [\r\n          deck.noteId!,\r\n          notes.find((note) => note.id === deck.noteId)?.title ?? deck.title,\r\n        ]),\r\n    ).entries(),\r\n  ];\r\n\r\n  function updateDeck(deck: ReviewDeck) {\r\n    setDecks((current) =>\r\n      current.map((item) => (item.id === deck.id ? deck : item)),\r\n    );\r\n  }\r\n  async function openMissed(deck: ReviewDeck) {\r\n    if (openLock.current) return;\r\n    openLock.current = true;\r\n    setOpening(deck.id);\r\n    try {\r\n      const result = await patchJson<{ deck: ReviewDeck }>(\r\n        `/review/${deck.id}/session`,\r\n        {\r\n          currentQuestionId: firstReviewQuestionId(deck, true),\r\n          onlyMissed: true,\r\n          version: deck.version,\r\n        },\r\n      );\r\n      updateDeck(result.deck);\r\n      setActiveId(deck.id);\r\n      setCatalogOpen(false);\r\n    } catch (cause) {\r\n      notify(errorText(cause), true);\r\n      setRefreshId((value) => value + 1);\r\n    } finally {\r\n      openLock.current = false;\r\n      setOpening(\"\");\r\n    }\r\n  }\r\n\r\n  return (\r\n    <div className={styles.page} data-review-workspace>\r\n      <header className={styles.pageHeading}>\r\n        <h1>学习复习</h1>\r\n        <div>\r\n          {visible.length > 0 && (\r\n            <button\r\n              className={`${shared.secondaryButton} ${styles.catalogToggle}`}\r\n              onClick={() => setCatalogOpen((value) => !value)}\r\n              aria-expanded={catalogOpen}\r\n            >\r\n              <ListFilter size={15} />\r\n              {catalogOpen ? \"当前复习\" : \"选择复习集\"}\r\n            </button>\r\n          )}\r\n          <button\r\n            className={shared.textButton}\r\n            onClick={() => setRefreshId((value) => value + 1)}\r\n            disabled={loading || !!opening}\r\n            aria-label=\"刷新复习集\"\r\n          >\r\n            <RefreshCw size={15} />\r\n            刷新\r\n          </button>\r\n        </div>\r\n      </header>\r\n      <div className={styles.filters}>\r\n        <label>\r\n          <span>论文</span>\r\n          <select\r\n            value={paperFilter}\r\n            onChange={(event) => {\r\n              setPaperFilter(event.target.value);\r\n              setNoteFilter(\"all\");\r\n            }}\r\n            aria-label=\"筛选复习论文\"\r\n          >\r\n            <option value=\"all\">全部论文</option>\r\n            {papers.map((paper) => (\r\n              <option key={paper.id} value={paper.id}>\r\n                {paper.title}\r\n              </option>\r\n            ))}\r\n          </select>\r\n        </label>\r\n        {noteSources.length > 0 && (\r\n          <label>\r\n            <span>笔记</span>\r\n            <select\r\n              value={noteFilter}\r\n              onChange={(event) => setNoteFilter(event.target.value)}\r\n              aria-label=\"筛选复习笔记\"\r\n            >\r\n              <option value=\"all\">全部来源</option>\r\n              {noteSources.map(([id, title]) => (\r\n                <option key={id} value={id}>\r\n                  {title}\r\n                </option>\r\n              ))}\r\n            </select>\r\n          </label>\r\n        )}\r\n        <span className={styles.collectionCount} aria-live=\"polite\">\r\n          {loading ? \"正在读取…\" : visible.length + \" 组复习集\"}\r\n        </span>\r\n      </div>\r\n      {error && (\r\n        <div className={styles.error} role=\"alert\">\r\n          <span>{error}</span>\r\n          <button\r\n            className={shared.textButton}\r\n            onClick={() => setRefreshId((value) => value + 1)}\r\n          >\r\n            重新载入\r\n          </button>\r\n        </div>\r\n      )}\r\n      {loading ? (\r\n        <Loading label=\"正在读取复习记录…\" />\r\n      ) : visible.length ? (\r\n        <div\r\n          className={styles.layout}\r\n          data-catalog-open={catalogOpen ? \"true\" : \"false\"}\r\n        >\r\n          <aside className={styles.catalog} aria-label=\"复习集列表\">\r\n            {visible.map((deck) => {\r\n              const counts = reviewCounts(deck);\r\n              const paper = activePapers.get(deck.paperId);\r\n              return (\r\n                <article\r\n                  key={deck.id}\r\n                  className={\r\n                    active?.id === deck.id ? styles.selectedDeck : styles.deck\r\n                  }\r\n                >\r\n                  <button\r\n                    className={styles.deckMain}\r\n                    onClick={() => {\r\n                      setActiveId(deck.id);\r\n                      setCatalogOpen(false);\r\n                    }}\r\n                    aria-current={active?.id === deck.id ? \"true\" : undefined}\r\n                  >\r\n                    <span className={styles.deckOrigin}>\r\n                      {deck.noteId ? \"来自阅读笔记\" : \"来自论文\"}\r\n                      {deck.stale ? \" · 来源已更新\" : \"\"}\r\n                    </span>\r\n                    <h2>{deck.title}</h2>\r\n                    <p>{paper?.title}</p>\r\n                    <span className={styles.deckCounts}>\r\n                      {counts.total} 题 · 已掌握 {counts.good} 题\r\n                    </span>\r\n                  </button>\r\n                  <div className={styles.deckActions}>\r\n                    <button\r\n                      className={shared.textButton}\r\n                      onClick={() => {\r\n                        setActiveId(deck.id);\r\n                        setCatalogOpen(false);\r\n                      }}\r\n                    >\r\n                      {deck.session.currentQuestionId === null\r\n                        ? \"查看结果\"\r\n                        : deck.questions.some(\r\n                              (question) => question.attemptCount > 0,\r\n                            )\r\n                          ? \"继续复习\"\r\n                          : \"开始复习\"}\r\n                      <ArrowRight size={13} />\r\n                    </button>\r\n                    {counts.good < counts.total && (\r\n                      <button\r\n                        className={shared.textButton}\r\n                        onClick={() => void openMissed(deck)}\r\n                        disabled={!!opening}\r\n                      >\r\n                        <RotateCcw size={12} />\r\n                        只练未掌握\r\n                      </button>\r\n                    )}\r\n                  </div>\r\n                </article>\r\n              );\r\n            })}\r\n          </aside>\r\n          {active && (\r\n            <ReviewPlayer\r\n              key={active.id}\r\n              deck={active}\r\n              onUpdate={updateDeck}\r\n              onOpenSource={onOpenSource}\r\n            />\r\n          )}\r\n        </div>\r\n      ) : !error ? (\r\n        <EmptyState\r\n          icon={<BookOpen size={25} />}\r\n          title={available.length ? \"这个范围里还没有复习集\" : \"还没有自测题\"}\r\n          description=\"从论文或阅读笔记中生成自测题，再来逐题练习。\"\r\n          action={\r\n            papers.length ? (\r\n              <button\r\n                className={shared.primaryButton}\r\n                onClick={() =>\r\n                  onOpenPaper(\r\n                    paperFilter !== \"all\" && activePapers.has(paperFilter)\r\n                      ? paperFilter\r\n                      : papers[0].id,\r\n                  )\r\n                }\r\n              >\r\n                打开论文出题\r\n                <ArrowRight size={15} />\r\n              </button>\r\n            ) : undefined\r\n          }\r\n        />\r\n      ) : null}\r\n    </div>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\review\\review-session.ts","messages":[{"ruleId":"complexity","severity":1,"message":"Function 'parseReviewDraft' has a complexity of 11. Maximum allowed is 10.","line":69,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":69,"endColumn":33}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { ReviewDeck, ReviewQuestion } from \"@/lib/research/review/types\";\r\n\r\nexport function reviewCounts(deck: ReviewDeck) {\r\n  const questions = deck.questions.filter((question) => !question.excluded);\r\n  const good = questions.filter(\r\n    (question) => question.rating === \"good\",\r\n  ).length;\r\n  const again = questions.filter(\r\n    (question) => question.rating === \"again\",\r\n  ).length;\r\n  return {\r\n    total: questions.length,\r\n    good,\r\n    again,\r\n    unanswered: questions.length - good - again,\r\n  };\r\n}\r\n\r\nexport function currentReviewQuestion(deck: ReviewDeck): ReviewQuestion | null {\r\n  if (deck.session.currentQuestionId === null) return null;\r\n  return (\r\n    deck.questions.find(\r\n      (question) =>\r\n        question.id === deck.session.currentQuestionId && !question.excluded,\r\n    ) ??\r\n    deck.questions.find(\r\n      (question) =>\r\n        !question.excluded &&\r\n        (!deck.session.onlyMissed || question.rating !== \"good\"),\r\n    ) ??\r\n    null\r\n  );\r\n}\r\n\r\nexport function nextReviewQuestionId(\r\n  deck: ReviewDeck,\r\n  questionId: string,\r\n): string | null {\r\n  const current = deck.questions.findIndex(\r\n    (question) => question.id === questionId,\r\n  );\r\n  return (\r\n    deck.questions\r\n      .slice(current + 1)\r\n      .find(\r\n        (question) =>\r\n          !question.excluded &&\r\n          (!deck.session.onlyMissed || question.rating !== \"good\"),\r\n      )?.id ?? null\r\n  );\r\n}\r\n\r\nexport function firstReviewQuestionId(\r\n  deck: ReviewDeck,\r\n  onlyMissed: boolean,\r\n): string | null {\r\n  return (\r\n    deck.questions.find(\r\n      (question) =>\r\n        !question.excluded && (!onlyMissed || question.rating !== \"good\"),\r\n    )?.id ?? null\r\n  );\r\n}\r\n\r\nexport function reviewDraftKey(deckId: string, questionId: string): string {\r\n  return `jiaoyan:review-response:v1:${deckId}:${questionId}`;\r\n}\r\n\r\nexport function parseReviewDraft(\r\n  raw: string | null,\r\n  question: string,\r\n  answer: string,\r\n): string | null {\r\n  if (!raw) return null;\r\n  try {\r\n    const value: unknown = JSON.parse(raw);\r\n    if (\r\n      !value ||\r\n      typeof value !== \"object\" ||\r\n      !(\"question\" in value) ||\r\n      !(\"answer\" in value) ||\r\n      !(\"response\" in value)\r\n    )\r\n      return null;\r\n    return value.question === question &&\r\n      value.answer === answer &&\r\n      typeof value.response === \"string\"\r\n      ? value.response\r\n      : null;\r\n  } catch {\r\n    return null;\r\n  }\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\review\\use-review-mutation.ts","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'useReviewMutation' has too many lines (55). Maximum allowed is 50.","line":7,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":61,"endColumn":2}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\r\n\r\nimport { useEffect, useRef, useState } from \"react\";\r\nimport type { ReviewDeck } from \"@/lib/research/review/types\";\r\nimport { errorText, patchJson, researchApi } from \"../api\";\r\n\r\nexport function useReviewMutation(\r\n  deck: ReviewDeck,\r\n  onUpdate: (deck: ReviewDeck) => void,\r\n) {\r\n  const [busy, setBusy] = useState(false);\r\n  const [error, setError] = useState(\"\");\r\n  const locked = useRef(false);\r\n  const current = useRef(deck);\r\n  useEffect(() => {\r\n    current.current = deck;\r\n  }, [deck]);\r\n  async function mutate(\r\n    action: \"response\" | \"attempt\" | \"session\" | \"question\",\r\n    input: Record<string, unknown>,\r\n  ): Promise<ReviewDeck | null> {\r\n    if (locked.current) return null;\r\n    locked.current = true;\r\n    setBusy(true);\r\n    setError(\"\");\r\n    try {\r\n      const result = await patchJson<{ deck: ReviewDeck }>(\r\n        `/review/${deck.id}/${action}`,\r\n        { ...input, version: current.current.version },\r\n      );\r\n      current.current = result.deck;\r\n      onUpdate(result.deck);\r\n      return result.deck;\r\n    } catch (cause) {\r\n      setError(errorText(cause));\r\n      return null;\r\n    } finally {\r\n      locked.current = false;\r\n      setBusy(false);\r\n    }\r\n  }\r\n  async function reload() {\r\n    if (locked.current) return;\r\n    locked.current = true;\r\n    setBusy(true);\r\n    setError(\"\");\r\n    try {\r\n      const result = await researchApi<{ deck: ReviewDeck }>(\r\n        `/review/${deck.id}`,\r\n      );\r\n      current.current = result.deck;\r\n      onUpdate(result.deck);\r\n    } catch (cause) {\r\n      setError(errorText(cause));\r\n    } finally {\r\n      locked.current = false;\r\n      setBusy(false);\r\n    }\r\n  }\r\n  return { busy, error, mutate, reload };\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\selection-boundary.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\components\\research\\study\\ReaderAnnotations.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'ReaderAnnotations' has too many lines (470). Maximum allowed is 50.","line":44,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":514,"endColumn":2},{"ruleId":"complexity","severity":1,"message":"Function 'ReaderAnnotations' has a complexity of 36. Maximum allowed is 10.","line":44,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":44,"endColumn":34},{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (122). Maximum allowed is 50.","line":282,"column":26,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":403,"endColumn":10},{"ruleId":"complexity","severity":1,"message":"Arrow function has a complexity of 14. Maximum allowed is 10.","line":282,"column":46,"nodeType":"ArrowFunctionExpression","messageId":"complex","endLine":282,"endColumn":48}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\r\n\r\nimport type {\r\n  ResearchAnnotation,\r\n  ResearchPaper,\r\n  SourceRef,\r\n} from \"@/lib/research/types\";\r\nimport {\r\n  ArrowUpRight,\r\n  Highlighter,\r\n  MessageSquare,\r\n  NotebookPen,\r\n  PencilLine,\r\n  RefreshCw,\r\n  Trash2,\r\n} from \"lucide-react\";\r\nimport { useEffect, useRef, useState } from \"react\";\r\nimport { errorText, researchApi, type PaperDetail } from \"../api\";\r\nimport { NoteEditor } from \"../learning/NoteEditor\";\r\nimport { EmptyState, Modal } from \"../ResearchUi\";\r\nimport styles from \"../styles\";\r\nimport {\r\n  annotationNoteDraft,\r\n  type AnnotationNoteDraft,\r\n} from \"./annotation-note\";\r\nimport local from \"./annotation-note.module.css\";\r\nimport { filterAnnotations } from \"../annotations/filter-annotations\";\r\n\r\nfunction annotationQuote(annotation: ResearchAnnotation): string {\r\n  return (\r\n    annotation.quote.trim() ||\r\n    (annotation.kind === \"highlight\" ? annotation.text.trim() : \"\")\r\n  );\r\n}\r\n\r\nfunction annotationThought(annotation: ResearchAnnotation): string {\r\n  if (annotation.comment.trim()) return annotation.comment.trim();\r\n  const text = annotation.text.trim();\r\n  return annotation.kind === \"comment\" && text !== annotationQuote(annotation)\r\n    ? text\r\n    : \"\";\r\n}\r\n\r\nexport function ReaderAnnotations({\r\n  detail,\r\n  paper,\r\n  onAdd,\r\n  onOpenSource,\r\n  beforeWrite,\r\n  onSaved,\r\n  notify,\r\n  onAsk,\r\n  currentPage,\r\n}: {\r\n  detail: PaperDetail | null;\r\n  paper: ResearchPaper;\r\n  onAdd(): void;\r\n  onOpenSource(source: SourceRef): void;\r\n  beforeWrite(): boolean;\r\n  onSaved(): Promise<void>;\r\n  notify(message: string, error?: boolean): void;\r\n  onAsk?(annotation: ResearchAnnotation): void;\r\n  currentPage?: number;\r\n}) {\r\n  const [pending, setPending] = useState<{\r\n    annotation: ResearchAnnotation;\r\n    pdfEtag: string;\r\n    action: \"edit\" | \"delete\";\r\n    initialComment: string;\r\n  } | null>(null);\r\n  const [comment, setComment] = useState(\"\");\r\n  const [discardPending, setDiscardPending] = useState(false);\r\n  const [saving, setSaving] = useState(false);\r\n  const [refreshing, setRefreshing] = useState(false);\r\n  const [selecting, setSelecting] = useState(false);\r\n  const [excludedIds, setExcludedIds] = useState<string[]>([]);\r\n  const [noteDraft, setNoteDraft] = useState<AnnotationNoteDraft | null>(null);\r\n  const [query, setQuery] = useState(\"\");\r\n  const [onlyCurrentPage, setOnlyCurrentPage] = useState(false);\r\n  const actionLock = useRef(false);\r\n  const allAnnotations = (detail?.annotations ?? []).filter(\r\n    (item) => item.paperId === paper.id,\r\n  );\r\n  const annotations = filterAnnotations(\r\n    allAnnotations,\r\n    query,\r\n    onlyCurrentPage ? currentPage : undefined,\r\n  );\r\n  const selected = annotations.filter((item) => !excludedIds.includes(item.id));\r\n  const locked = saving || refreshing || !!pending || !!noteDraft;\r\n  const dirtyComment =\r\n    pending?.action === \"edit\" && comment !== pending.initialComment;\r\n  useEffect(() => {\r\n    if (!dirtyComment) return;\r\n    const prevent = (event: BeforeUnloadEvent) => {\r\n      event.preventDefault();\r\n      event.returnValue = \"\";\r\n    };\r\n    window.addEventListener(\"beforeunload\", prevent);\r\n    return () => window.removeEventListener(\"beforeunload\", prevent);\r\n  }, [dirtyComment]);\r\n\r\n  function prepareNote() {\r\n    if (locked || !beforeWrite()) return;\r\n    try {\r\n      setNoteDraft(annotationNoteDraft(detail?.paper ?? paper, selected));\r\n    } catch (error) {\r\n      notify(errorText(error), true);\r\n    }\r\n  }\r\n  function prepare(annotation: ResearchAnnotation, action: \"edit\" | \"delete\") {\r\n    if (locked || !beforeWrite()) return;\r\n    const initialComment = annotationThought(annotation);\r\n    setDiscardPending(false);\r\n    setComment(initialComment);\r\n    setPending({\r\n      annotation,\r\n      action,\r\n      initialComment,\r\n      pdfEtag: detail?.paper.pdfEtag ?? paper.pdfEtag,\r\n    });\r\n  }\r\n  function closePending() {\r\n    if (saving || actionLock.current) return;\r\n    if (dirtyComment) {\r\n      setDiscardPending((current) => !current);\r\n      return;\r\n    }\r\n    setDiscardPending(false);\r\n    setPending(null);\r\n  }\r\n  async function refresh() {\r\n    if (locked || actionLock.current || !beforeWrite()) return;\r\n    actionLock.current = true;\r\n    setRefreshing(true);\r\n    try {\r\n      await onSaved();\r\n    } catch (error) {\r\n      notify(errorText(error), true);\r\n    } finally {\r\n      actionLock.current = false;\r\n      setRefreshing(false);\r\n    }\r\n  }\r\n  async function commit() {\r\n    if (!pending || actionLock.current || !beforeWrite()) return;\r\n    actionLock.current = true;\r\n    setSaving(true);\r\n    try