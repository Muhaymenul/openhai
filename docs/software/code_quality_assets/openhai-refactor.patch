+    $token = -join ($bytes | ForEach-Object { $_.ToString('x2') })
+    $lines = $lines | ForEach-Object { if ($_ -match '^RESEARCH_RPC_TOKEN=') { 'RESEARCH_RPC_TOKEN=' + $token } else { $_ } }
+    [IO.File]::WriteAllLines($envPath, $lines)
+    Write-Host 'Generated RESEARCH_RPC_TOKEN in .env'
+  }
+}
 Write-Host 'Setup ready. Existing settings were preserved.'
 Write-Host 'For AI features, edit private/model.env with your own endpoint, model ID and API key.'
