terval(() => {\r\n        void ownsLock(lock, token).then((owned) => {\r\n          if (!owned) return;\r\n          const now = new Date();\r\n          return fs.utimes(lock, now, now).catch(() => undefined);\r\n        });\r\n      }, HEARTBEAT_MS);\r\n      heartbeat.unref();\r\n\r\n      return async () => {\r\n        clearInterval(heartbeat);\r\n        if (await ownsLock(lock, token)) {\r\n          await fs.rm(lock, { recursive: true, force: true });\r\n        }\r\n      };\r\n    } catch (error) {\r\n      if (\r\n        !(error instanceof Error) ||\r\n        !(\"code\" in error) ||\r\n        error.code !== \"EEXIST\"\r\n      ) {\r\n        throw error;\r\n      }\r\n      await removeStaleLock(lock);\r\n      if (Date.now() >= deadline) {\r\n        throw new FilesystemBusyError(\r\n          \"Another filesystem operation is still running.\",\r\n        );\r\n      }\r\n      await new Promise((resolve) => setTimeout(resolve, POLL_MS));\r\n    }\r\n  }\r\n}\r\n\r\nexport async function withFilesystemLock<T>(\r\n  namespace: string,\r\n  key: string,\r\n  waitMs: number,\r\n  operation: () => Promise<T>,\r\n): Promise<T> {\r\n  const release = await acquire(namespace, key, waitMs);\r\n  try {\r\n    return await operation();\r\n  } finally {\r\n    await release();\r\n  }\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\src\\lib\\github-source.ts","messages":[{"ruleId":"complexity","severity":1,"message":"Function 'parseGitHubBlobUrl' has a complexity of 14. Maximum allowed is 10.","line":159,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":159,"endColumn":35},{"ruleId":"max-lines-per-function","severity":1,"message":"Async function 'repositoryTree' has too many lines (51). Maximum allowed is 50.","line":397,"column":1,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":447,"endColumn":2},{"ruleId":"complexity","severity":1,"message":"Async function 'repositoryTree' has a complexity