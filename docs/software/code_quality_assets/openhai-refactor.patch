rrorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { describe, expect, it } from \"vitest\";\r\nimport type { NoteDraft } from \"@/components/research/learning/NoteEditor\";\r\nimport {\r\n  excerptNoteOrigin,\r\n  generatedNoteOrigin,\r\n  localNoteKey,\r\n  readLocalNote,\r\n  writeLocalNote,\r\n  type DraftStorage,\r\n  type EditableNote,\r\n  type LocalNoteDraft,\r\n} from \"@/components/research/learning/note-drafts\";\r\n\r\nfunction storage(): DraftStorage {\r\n  const values = new Map<string, string>();\r\n  return {\r\n    get length() {\r\n      return values.size;\r\n    },\r\n    key(index) {\r\n      return [...values.keys()][index] ?? null;\r\n    },\r\n    getItem(key) {\r\n      return values.get(key) ?? null;\r\n    },\r\n    setItem(key, value) {\r\n      values.set(key, value);\r\n    },\r\n    removeItem(key) {\r\n      values.delete(key);\r\n    },\r\n  };\r\n}\r\nfunction seed(excerpt?: string, runId = \"run-one\"): EditableNote {\r\n  const draft: NoteDraft = {\r\n    title: \"阅读讨论\",\r\n    body: excerpt ?? \"The complete answer has several paragraphs.\",\r\n    runId,\r\n    sources: [{ paperId: \"paper-a\", page: 2 }],\r\n    ...(excerpt === undefined\r\n      ? {}\r\n      : { origin: excerptNoteOrigin(runId, excerpt) }),\r\n  };\r\n  return {\r\n    ...draft,\r\n    paperId: \"paper-a\",\r\n    kind: \"reading\",\r\n    confirmed: false,\r\n    origin: generatedNoteOrigin(draft, draft.origin),\r\n    slot: \"tab-one\",\r\n  };\r\n}\r\nfunction bind(store: DraftStorage, model: EditableNote, noteId: string) {\r\n  const key = localNoteKey(model);\r\n  store.setItem(\r\n    key,\r\n    JSON.stringify({\r\n      schema: 1,\r\n      type: \"binding\",\r\n      key,\r\n      paperId: model.paperId,\r\n      noteId,\r\n    }),\r\n  );\r\n}\r\ndescribe(\"independent local identities for answer excerpts\", () => {\r\n  it(\"does not restore a saved complete answer when preparing an excerpt from the same run\", () => {\r\n    const store = storage();\r\n    const full = seed();\r\n    bind(store, full, \"saved-complete-note\");\r\n    const partial = seed(\"Only the selected paragraph.\");\r\n    expect(full.origin).toBe(\"run-run-one\");\r\n    expect(localNoteKey(partial)).not.toBe(localNoteKey(full));\r\n    expect(readLocalNote(store, localNoteKey(partial))).toBeNull();\r\n    const draft: LocalNoteDraft = {\r\n      schema: 1,\r\n      type: \"draft\",\r\n      key: localNoteKey(partial),\r\n      model: partial,\r\n      token: \"excerpt-editor\",\r\n      updatedAt: \"2026-10-31T10:00:00Z\",\r\n    };\r\n    writeLocalNote(store, draft, null);\r\n    const restored = readLocalNote(store, draft.key);\r\n    expect(restored).toMatchObject({\r\n      type: \"draft\",\r\n      model: { body: \"Only the selected paragraph.\", runId: \"run-one\" },\r\n    });\r\n    expect(readLocalNote(store, localNoteKey(full))).toMatchObject({\r\n      type: \"binding\",\r\n      noteId: \"saved-complete-note\",\r\n    });\r\n  });\r\n  it(\"reopens the same saved excerpt reliably while keeping different excerpts and runs separate\", () => {\r\n    const store = storage();\r\n    const first = seed(\"The selected paragraph.\");\r\n    bind(store, first, \"saved-excerpt-note\");\r\n    const reopened = seed(\"The selected paragraph.\");\r\n    expect(readLocalNote(store, localNoteKey(reopened))).toMatchObject({\r\n      type: \"binding\",\r\n      noteId: \"saved-excerpt-note\",\r\n    });\r\n    expect(\r\n      readLocalNote(store, localNoteKey(seed(\"A different paragraph.\"))),\r\n    ).toBeNull();\r\n    expect(\r\n      readLocalNote(\r\n        store,\r\n        localNoteKey(seed(\"The selected paragraph.\", \"run-two\")),\r\n      ),\r\n    ).toBeNull();\r\n    expect(seed(undefined, \"run-one\").origin).toBe(\"run-run-one\");\r\n  });\r\n  it(\"fits persisted origin limits and keeps maximum-length valid run IDs distinct\", () => {\r\n    const runId = \"r\".repeat(99);\r\n    const first = seed(\"An excerpt.\", runId + \"a\");\r\n    const second = seed(\"An excerpt.\", runId + \"b\");\r\n    expect(first.origin.length).toBeLessThanOrEqual(200);\r\n    expect(first.origin).not.toBe(second.origin);\r\n    const store = storage();\r\n    const draft: LocalNoteDraft = {\r\n      schema: 1,\r\n      type: \"draft\",\r\n      key: localNoteKey(first),\r\n      model: first,\r\n      token: \"long-run-editor\",\r\n      updatedAt: \"2026-10-31T10:00:00Z\",\r\n    };\r\n    expect(() => writeLocalNote(store, draft, null)).not.toThrow();\r\n    expect(readLocalNote(store, draft.key)).toMatchObject({\r\n      model: { runId: runId + \"a\" },\r\n    });\r\n  });\r\n});\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\tmp\\openhai-review\\app\\tests\\lib\\research-paper-trash.test.ts","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Arrow function has too many lines (307). Maximum allowed is 50.","line":120,"column":49,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":431,"endColumn":2},{"ruleId":"max-lines-per-function","severity":1,"message":"Async arrow function has too many lines (87). Maximum allowed is 50.","line":121,"column":108,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":207,"endColumn":4},{"ruleId":"max-lines-per-function","severity":1,"message":"Async arrow function has too many lines (52). Maximum allowed is 50.","line":271,"column":116,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":322,"endColumn":4},{"ruleId":"max-lines-per-function","severity":1,"message":"Async arrow function has too many lines (58). Maximum allowed is 50.","line":373,"column":106,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":430,"endColumn":4}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import fs from \"node:fs\";\r\nimport os from \"node:os\";\r\nimport path from \"node:path\";\r\nimport { PDFDocument, StandardFonts } from \"pdf-lib\";\r\nimport { afterEach, beforeEach, describe, expect, it, vi } from \"vitest\";\r\nimport { closeIndex } from \"../../src/lib/library/index-db\";\r\nimport { companionDir } from \"../../src/lib/library/papers\";\r\nimport { handleResearchRequest } from \"../../src/lib/research/api\";\r\nimport { createResearchBackup } from \"../../src/lib/research/backup\";\r\nimport {\r\n  canReuseResearchSession,\r\n  researchContextScope,\r\n  researchSourcePaperIds,\r\n} from \"../../src/lib/research/context-scope\";\r\nimport {\r\n  addManualGraphEdge,\r\n  applyGraphRun,\r\n  getResearchGraph,\r\n} from \"../../src/lib/research/graph\";\r\nimport { createAnnotation } from \"../../src/lib/research/pdf\";\r\nimport {\r\n  createPlannerTask,\r\n  listPlannerTasks,\r\n  plannerCalendar,\r\n} from \"../../src/lib/research/planner/core\";\r\nimport {\r\n  restoreResearchPaper,\r\n  trashResearchPaper,\r\n} from \"../../src/lib/research/paper-lifecycle\";\r\nimport {\r\n  activeWorkspace,\r\n  createNote,\r\n  digest,\r\n  importPaper,\r\n  mutateWorkspace,\r\n  paperById,\r\n  paperPdfPath,\r\n  readWorkspace,\r\n  recoverResearchImports,\r\n  researchContext,\r\n  saveKnowledge,\r\n  searchResearch,\r\n} from \"../../src/lib/research/store\";\r\nimport type { ResearchPaper, ResearchRun } from \"../../src/lib/research/types\";\r\n\r\nconst provider = vi.hoisted(() => ({ status: vi.fn(), start: vi.fn() }));\r\nvi.mock(\"../../src/lib/agent/registry\", () => ({\r\n  getResearchProvider: () => provider,\r\n}));\r\n\r\nlet root: string;\r\nbeforeEach(() => {\r\n  root = fs.mkdtempSync(path.join(os.tmpdir(), \"research-trash-\"));\r\n  vi.stubEnv(\"PAPERNOOK_DATA_DIR\", root);\r\n  vi.stubEnv(\"RESEARCH_DATA_DIR\", path.join(root, \"research\"));\r\n  vi.stubEnv(\"NODE_ENV\", \"test\");\r\n  provider.status.mockReset().mockRejectedValue(new Error(\"offline boundary\"));\r\n  provider.start.mockReset();\r\n});\r\nafterEach(() => {\r\n  closeIndex();\r\n  vi.unstubAllEnvs();\r\n  fs.rmSync(root, { recursive: true, force: true });\r\n});\r\n\r\nasync function fixture(title = \"Uploaded lifecycle paper\") {\r\n  const pdf = await PDFDocument.create();\r\n  pdf.setTitle(title);\r\n  const font = await pdf.embedFont(StandardFonts.Helvetica);\r\n  pdf.addPage([600, 800]).drawText(title, { x: 40, y: 700, size: 12, font });\r\n  const bytes = await pdf.save();\r\n  const pages = [{ page: 1, text: title, width: 600, height: 800 }];\r\n  return {\r\n    paper: await importPaper({\r\n      bytes,\r\n      filename: \"uploaded.pdf\",\r\n      title,\r\n      pages,\r\n      contentRevision: digest(pages),\r\n    }),\r\n    bytes,\r\n    pages,\r\n  };\r\n}\r\nasync function request<T>(segments: string[], method = \"GET\", body?: unknown) {\r\n  const response = await handleResearchRequest(\r\n    new Request(\"http://127.0.0.1:3000/api/research/\" + segments.join(\"/\"), {\r\n      method,\r\n      headers: {\r\n        Origin: \"http://127.0.0.1:3000\",\r\n        \"Content-Type\": \"application/json\",\r\n      },\r\n      body: body === undefined ? undefined : JSON.stringify(body),\r\n    }),\r\n    segments,\r\n  );\r\n  return { response, payload: (await response.json()) as T };\r\n}\r\nfunction saveRun(\r\n  paperId: string,\r\n  extras: Partial<ResearchRun> = {},\r\n): ResearchRun {\r\n  const run: ResearchRun = {\r\n    id: \"run-lifecycle\",\r\n    paperId,\r\n    question: \"Test\",\r\n    answer: \"\",\r\n    status: \"running\",\r\n    mode: \"ask\",\r\n    createdAt: new Date().toISOString(),\r\n    updatedAt: new Date().toISOString(),\r\n    ...extras,\r\n  };\r\n  const dir = path.join(root, \"research\", \"runs\");\r\n  fs.mkdirSync(dir, { recursive: true });\r\n  fs.writeFileSync(path.join(dir, run.id + \".json\"), JSON.stringify(run));\r\n  return run;\r\n}\r\n\r\ndescribe(\"reversible uploaded-paper lifecycle\", () => {\r\n  it(\"hides a paper and its artifacts, then restores their identity, bytes, versions and graph decisions\", async () => {\r\n    const { paper } = await fixture();\r\n    const note = await createNote({\r\n      paperId: paper.id,\r\n      title: \"Keep my confirmed note\",\r\n      body: \"Original note body\",\r\n      confirmed: true,\r\n      sources: [{ paperId: paper.id, page: 1 }],\r\n    });\r\n    await createAnnotation({\r\n      paperId: paper.id,\r\n      page: 1,\r\n      comment: \"Keep annotation\",\r\n      color: \"#f6c84c\",\r\n      rects: [],\r\n      pdfEtag: paper.pdfEtag,\r\n    });\r\n    const full = readWorkspace();\r\n    const concept = full.knowledge[0];\r\n    await getResearchGraph();\r\n    const graph = await addManualGraphEdge({\r\n      source: \"paper-\" + paper.id,\r\n      target:\r\n        \"concept-\" +\r\n        digest(\r\n          concept.title\r\n            .normalize(\"NFKC\")\r\n            .toLowerCase()\r\n            .replace(/[\\s\\p{P}]+/gu, \"\"),\r\n        ).slice(0, 24),\r\n      evidence: [{ paperId: paper.id, page: 1 }],\r\n      label: \"My decision\",\r\n    });\r\n    const edge = graph.edges.find((item) => item.label === \"My decision\")!;\r\n    const before = readWorkspace();\r\n    const bytes = fs.readFileSync(paperPdfPath(paper));\r\n    const deleted = await request<{ paper: ResearchPaper }>(\r\n      [\"papers\", paper.id],\r\n      \"DELETE\",\r\n      { version: paperById(paper.id).version },\r\n    );\r\n    expect(deleted.response.status).toBe(200);\r\n    expect(deleted.payload.paper.trashedAt).toBeTruthy();\r\n    expect(fs.readFileSync(paperPdfPath(paper)).equals(bytes)).toBe(true);\r\n    expect(readWorkspace().notes).toEqual(before.notes);\r\n    expect(readWorkspace().annotations).toEqual(before.annotations);\r\n    expect(activeWorkspace().notes).toEqual([]);\r\n    expect(activeWorkspace().annotations).toEqual([]);\r\n    expect(\r\n      (await getResearchGraph()).edges.some((item) => item.id === edge.id),\r\n    )