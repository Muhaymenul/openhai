+async def test_tcp_contract_health_start_status_history(tmp_path: Path):
+    """Client I/O runs in a worker thread so the service loop can answer."""
+    service = service_at(tmp_path, caller=turn("第 2 页显示 d=0.62。"))
+    await service.listen("127.0.0.1", 0)
+    port = service.server.sockets[0].getsockname()[1]
+    try:
+        outcome = await asyncio.to_thread(round_trip, port)
+        assert outcome["health"]["configured"] is True
+        assert outcome["subscribed"] is True
+        assert outcome["status"] == "completed"
+        assert outcome["output"] == "第 2 页显示 d=0.62。"
+        assert len(outcome["messages"]) >= 2
+        assert outcome["event_types"] >= {"status", "token", "result"}
+    finally:
+        await service.close()
+
+
+def round_trip(port: int) -> Dict[str, Any]:
+    client = socket.create_connection(("127.0.0.1", port), timeout=30)
+    frames = Frames(client)
+    frames.send({"id": "h", "method": "research.health", "params": {}})
+    health = frames.expect("h")["result"]
+    frames.send({"id": "s", "method": "research.subscribe", "params": {"after_seq": 0}})
+    subscribed = frames.expect("s")["result"]["subscribed"]
+    frames.send({"id": "st", "method": "research.start", "params": start_params()})
+    run_id = frames.expect("st")["result"]["run_id"]
+    seen: set = set()
+    status: Dict[str, Any] = {}
+    for _ in range(100):
+        frame = frames.poll()
+        if frame and frame.get("event"):
+            seen.add(frame["data"]["type"])
+        status = frames.request("k", "research.status", {"run_id": run_id})["result"]
+        if status["status"] in research_service.TERMINAL:
+            break
