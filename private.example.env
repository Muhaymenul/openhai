# Copy to private/model.env and fill in your own provider settings.
# Use an OpenAI-compatible Chat Completions endpoint, including /v1 when required.
# Example endpoint (requires your own university access): https://chat.ecnu.edu.cn/open/api/v1
# Its example model ID is ecnu-max. Other providers use their own URL/model IDs.
PAPERFLOW_LLM_PROVIDER=openai
PAPERFLOW_LLM_BASE_URL=
PAPERFLOW_LLM_DEFAULT_MODEL=
PAPERFLOW_LLM_API_KEY=
