# Local PostgreSQL connection for the web container.
# Copy to private/postgres.env via scripts/setup.ps1 or scripts/setup.sh.
# Create the dedicated jiaoyan database and role first, then set YOUR password.
RESEARCH_DATABASE_HOST=host.docker.internal
RESEARCH_DATABASE_PORT=5432
RESEARCH_DATABASE_NAME=jiaoyan
RESEARCH_DATABASE_USER=jiaoyan
RESEARCH_DATABASE_PASSWORD=